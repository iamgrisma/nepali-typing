{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nepali-typing",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "workers_dev": true,
  "compatibility_date": "2026-09-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "CDN_BASE_URL": "https://fonts-cdn.topnepali.com/font-files",
    "ENVIRONMENT": "production"
  }
}
