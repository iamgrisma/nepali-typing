---
// History Drawer Component
// Displays saved typing test history and personal bests from localStorage
---

<div id="history-modal" class="modal-backdrop">
  <div class="modal-content p-6 sm:p-8 max-w-2xl">
    <!-- Header -->
    <div class="flex items-center justify-between pb-4 border-b border-[var(--border-subtle)]">
      <div>
        <h2 class="text-xl font-bold font-display text-[var(--text-primary)]">
          Typing History & Records
        </h2>
        <p class="text-xs text-[var(--text-muted)] mt-0.5">
          Track your progress, speed improvements, and personal bests
        </p>
      </div>

      <button 
        type="button" 
        id="close-history-btn" 
        class="p-2 rounded-xl text-[var(--text-secondary)] hover:bg-[var(--bg-surface-subtle)] hover:text-[var(--text-primary)] transition-colors"
        aria-label="Close"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <!-- Personal Bests Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 my-6">
      <div class="p-3 bg-[var(--bg-surface-subtle)] rounded-xl border border-[var(--border-subtle)]">
        <span class="text-[10px] font-bold text-[var(--text-muted)] uppercase">English PB</span>
        <div class="text-2xl font-extrabold text-[var(--text-primary)] mt-0.5" id="pb-english">0 WPM</div>
      </div>
      <div class="p-3 bg-[var(--bg-surface-subtle)] rounded-xl border border-[var(--border-subtle)]">
        <span class="text-[10px] font-bold text-[var(--text-muted)] uppercase">Traditional PB</span>
        <div class="text-2xl font-extrabold text-[var(--accent-primary)] mt-0.5" id="pb-unicode">0 WPM</div>
      </div>
      <div class="p-3 bg-[var(--bg-surface-subtle)] rounded-xl border border-[var(--border-subtle)]">
        <span class="text-[10px] font-bold text-[var(--text-muted)] uppercase">Romanized PB</span>
        <div class="text-2xl font-extrabold text-blue-500 mt-0.5" id="pb-romanized">0 WPM</div>
      </div>
      <div class="p-3 bg-[var(--bg-surface-subtle)] rounded-xl border border-[var(--border-subtle)]">
        <span class="text-[10px] font-bold text-[var(--text-muted)] uppercase">Preeti PB</span>
        <div class="text-2xl font-extrabold text-amber-500 mt-0.5" id="pb-preeti">0 WPM</div>
      </div>
    </div>

    <!-- History Log Table -->
    <div class="mb-6">
      <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--text-muted)] mb-3">Recent Test Sessions</h3>
      <div class="max-h-60 overflow-y-auto rounded-xl border border-[var(--border-subtle)]">
        <table class="w-full text-xs text-left">
          <thead class="bg-[var(--bg-surface-subtle)] text-[var(--text-muted)] border-b border-[var(--border-subtle)] sticky top-0">
            <tr>
              <th class="p-2.5">Date</th>
              <th class="p-2.5">Layout</th>
              <th class="p-2.5">Mode</th>
              <th class="p-2.5">Net WPM</th>
              <th class="p-2.5">Accuracy</th>
            </tr>
          </thead>
          <tbody id="history-table-body" class="divide-y divide-[var(--border-subtle)] text-[var(--text-secondary)]">
            <!-- Populated from LocalStorage -->
            <tr>
              <td colspan="5" class="p-4 text-center text-[var(--text-muted)]">No typing tests recorded yet. Complete a test to see your stats here!</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Clear History Footer -->
    <div class="flex items-center justify-between pt-4 border-t border-[var(--border-subtle)] text-xs">
      <span class="text-[var(--text-muted)]" id="total-tests-count">0 tests completed</span>
      <button 
        type="button" 
        id="clear-history-btn" 
        class="text-red-500 hover:text-red-600 font-medium transition-colors"
      >
        Clear All History
      </button>
    </div>
  </div>
</div>
