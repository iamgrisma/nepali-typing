---
// TopNepaliNetwork.astro — Self-contained, zero-dependency 9-dot ecosystem launcher
interface Props {
  currentApp?: 'blog' | 'tools' | 'typing' | 'fonts' | 'share' | 'election';
}

const { currentApp = 'typing' } = Astro.props;

const networkApps = [
  {
    id: 'blog',
    name: 'TopNepali Hub',
    desc: 'Articles, technology & digital insights',
    url: 'https://topnepali.com',
    icon: '📰'
  },
  {
    id: 'tools',
    name: 'TopTools',
    desc: 'Nepali calendar, date converter & utilities',
    url: 'https://topnepali.com/tools',
    icon: '🛠️'
  },
  {
    id: 'typing',
    name: 'Nepali Typing',
    desc: 'Typing speed test & verified certificates',
    url: 'https://typing.topnepali.com',
    icon: '⌨️'
  },
  {
    id: 'fonts',
    name: 'FontsDir',
    desc: 'Devanagari, Preeti & Unicode font downloads',
    url: 'https://fonts.topnepali.com',
    icon: '🔤'
  },
  {
    id: 'share',
    name: 'Flashare',
    desc: 'Fast direct file transfer between devices',
    url: 'https://share.topnepali.com',
    icon: '⚡'
  },
  {
    id: 'election',
    name: 'Election Nepal',
    desc: 'Constituency records & parliamentary data',
    url: 'https://election.topnepali.com',
    icon: '🗳️'
  }
];
---

<div class="topnepali-network-root">
  <!-- 9-Dot Launcher Button -->
  <button
    type="button"
    class="network-trigger-btn"
    aria-label="TopNepali Apps Menu"
    aria-expanded="false"
    title="TopNepali Network"
  >
    <svg viewBox="0 0 24 24" fill="currentColor">
      <circle cx="5" cy="5" r="2.2" />
      <circle cx="12" cy="5" r="2.2" />
      <circle cx="19" cy="5" r="2.2" />
      <circle cx="5" cy="12" r="2.2" />
      <circle cx="12" cy="12" r="2.2" />
      <circle cx="19" cy="12" r="2.2" />
      <circle cx="5" cy="19" r="2.2" />
      <circle cx="12" cy="19" r="2.2" />
      <circle cx="19" cy="19" r="2.2" />
    </svg>
  </button>

  <!-- Flyout Menu Panel -->
  <div class="network-dropdown-panel hidden">
    <div class="panel-header">
      <span class="panel-title">TopNepali Network</span>
      <a href="https://topnepali.com" class="all-apps-link">All Apps →</a>
    </div>

    <div class="apps-list">
      {networkApps.map((app) => {
        const isCurrent = app.id === currentApp;
        return (
          <a
            href={app.url}
            class={`app-item ${isCurrent ? 'current' : ''}`}
          >
            <div class="app-icon">{app.icon}</div>
            <div class="app-info">
              <div class="app-name-row">
                <span class="app-name">{app.name}</span>
                {isCurrent && <span class="current-badge">ACTIVE</span>}
              </div>
              <p class="app-desc">{app.desc}</p>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</div>

<style>
  .topnepali-network-root {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .network-trigger-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    border: 1px solid var(--border-subtle, #334155);
    background: var(--bg-surface-subtle, #1e293b);
    color: var(--text-primary, #f8fafc);
    cursor: pointer;
    transition: all 0.15s ease;
    padding: 0;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }

  .network-trigger-btn:hover {
    background: var(--border-subtle, #334155);
    transform: scale(1.04);
  }

  .network-trigger-btn:active {
    transform: scale(0.96);
  }

  .network-trigger-btn svg {
    width: 17px;
    height: 17px;
  }

  /* Dropdown Panel */
  .network-dropdown-panel {
    position: absolute;
    top: calc(100% + 8px);
    right: 0; /* Strictly align right edge with trigger button */
    width: 285px;
    max-width: calc(100vw - 20px);
    background: var(--bg-surface, #0f172a);
    border: 1px solid var(--border-subtle, #334155);
    border-radius: 16px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.35);
    padding: 8px;
    z-index: 9999;
  }

  /* Mobile narrow screen adjustment so right margin never clips */
  @media (max-width: 480px) {
    .network-dropdown-panel {
      right: -6px;
      width: 275px;
      max-width: calc(100vw - 16px);
    }
  }

  .network-dropdown-panel.hidden {
    display: none !important;
  }

  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 8px 8px;
    border-bottom: 1px solid var(--border-subtle, #1e293b);
    margin-bottom: 6px;
  }

  .panel-title {
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted, #94a3b8);
  }

  .all-apps-link {
    font-size: 11px;
    font-weight: 700;
    color: #38bdf8;
    text-decoration: none;
  }

  .all-apps-link:hover {
    text-decoration: underline;
  }

  .apps-list {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .app-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: background 0.12s ease;
  }

  .app-item:hover {
    background: var(--bg-surface-subtle, #1e293b);
  }

  .app-item.current {
    background: var(--bg-surface-subtle, #1e293b);
    border: 1px solid var(--accent-primary, #e11d48);
    pointer-events: none;
  }

  .app-icon {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: var(--bg-surface-elevated, #1e293b);
    border: 1px solid var(--border-subtle, #334155);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    flex-shrink: 0;
  }

  .app-info {
    flex: 1;
    min-width: 0;
  }

  .app-name-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }

  .app-name {
    font-size: 12.5px;
    font-weight: 700;
    color: var(--text-primary, #f8fafc);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .current-badge {
    font-size: 9px;
    font-weight: 800;
    padding: 1px 5px;
    border-radius: 4px;
    background: rgba(225, 29, 72, 0.18);
    color: var(--accent-primary, #f43f5e);
    flex-shrink: 0;
  }

  .app-desc {
    font-size: 11px;
    color: var(--text-muted, #94a3b8);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-top: 1px;
  }
</style>

<script>
  function setupNetworkDrawers() {
    const roots = document.querySelectorAll('.topnepali-network-root');
    roots.forEach((root) => {
      const trigger = root.querySelector('.network-trigger-btn');
      const panel = root.querySelector('.network-dropdown-panel');
      if (!trigger || !panel) return;

      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = !panel.classList.contains('hidden');
        panel.classList.toggle('hidden', isOpen);
        trigger.setAttribute('aria-expanded', String(!isOpen));
      });

      document.addEventListener('click', (e) => {
        if (!panel.contains(e.target as Node) && e.target !== trigger) {
          panel.classList.add('hidden');
          trigger.setAttribute('aria-expanded', 'false');
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !panel.classList.contains('hidden')) {
          panel.classList.add('hidden');
          trigger.setAttribute('aria-expanded', 'false');
        }
      });
    });
  }

  setupNetworkDrawers();
  document.addEventListener('astro:page-load', setupNetworkDrawers);
</script>
