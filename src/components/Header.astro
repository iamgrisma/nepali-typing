---
import TopNepaliNetwork from './TopNepaliNetwork.astro';

interface Props {
  siteTitle?: string;
  activeNav?: string;
}

const { activeNav = 'test' } = Astro.props;
---

<header id="site-header" class="border-b border-[var(--border-subtle)] bg-[var(--bg-surface)] sticky top-0 z-40 backdrop-blur-md bg-opacity-95">
  <div class="container flex items-center justify-between h-16">
    
    <!-- Logo & Brand -->
    <a href="/" class="flex items-center gap-2.5 text-decoration-none group shrink-0 mr-3 sm:mr-4" title="TypeshalaBench Home">
      <img 
        src="/logo.svg" 
        alt="Typeshala Bench Logo" 
        class="w-8 h-8 object-contain rounded-xl shadow-sm group-hover:scale-105 transition-transform shrink-0" 
        width="32" 
        height="32" 
      />
      <span class="font-bold text-base font-display tracking-tight text-[var(--text-primary)]">
        Typeshala<span class="text-red-600">Bench</span>
      </span>
    </a>

    <!-- Primary Desktop Navigation -->
    <nav class="header-nav items-center gap-1 text-xs font-semibold">
      
      <!-- Typeshala Bench Dropdown Menu -->
      <div class="typeshala-dropdown-wrapper">
        <button 
          type="button"
          id="typeshala-dropdown-trigger"
          class={`px-2.5 py-1.5 rounded-lg transition-colors flex items-center gap-1 cursor-pointer whitespace-nowrap ${['test', 'traditional', 'romanized', 'preeti', 'english', 'loksewa'].includes(activeNav) ? 'bg-[var(--bg-surface-subtle)] text-[var(--accent-primary)] font-bold' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-subtle)]'}`}
          aria-haspopup="true"
          aria-expanded="false"
        >
          <span>Typeshala Bench</span>
          <svg class="typeshala-chevron w-3 h-3 transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>

        <!-- Dropdown Child Menu (Scoped pure CSS display) -->
        <div id="typeshala-dropdown-menu" class="typeshala-dropdown-menu">
          <div class="px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-[var(--text-muted)]">
            Typing Test Modes
          </div>
          
          <a 
            href="/nepali-traditional-typing-test" 
            class={`px-2.5 py-2 rounded-lg text-xs transition-colors flex items-center justify-between ${activeNav === 'traditional' ? 'bg-[var(--accent-primary)]/10 text-[var(--accent-primary)] font-bold' : 'text-[var(--text-primary)] hover:bg-[var(--bg-surface-subtle)]'}`}
          >
            <div>
              <div class="font-semibold text-[var(--text-primary)]">Nepali Traditional</div>
              <div class="text-[10px] text-[var(--text-muted)]">MPP Hardware Standard</div>
            </div>
            <span class="text-[10px] px-1.5 py-0.5 rounded font-mono bg-sky-500/15 text-sky-500 font-bold">MPP</span>
          </a>

          <a 
            href="/romanized-nepali-typing-test" 
            class={`px-2.5 py-2 rounded-lg text-xs transition-colors flex items-center justify-between ${activeNav === 'romanized' ? 'bg-[var(--accent-primary)]/10 text-[var(--accent-primary)] font-bold' : 'text-[var(--text-primary)] hover:bg-[var(--bg-surface-subtle)]'}`}
          >
            <div>
              <div class="font-semibold text-[var(--text-primary)]">Nepali Romanized</div>
              <div class="text-[10px] text-[var(--text-muted)]">Phonetic Transliteration</div>
            </div>
            <span class="text-[10px] px-1.5 py-0.5 rounded font-mono bg-purple-500/15 text-purple-500 font-bold">Phonetic</span>
          </a>

          <a 
            href="/preeti-typing-test" 
            class={`px-2.5 py-2 rounded-lg text-xs transition-colors flex items-center justify-between ${activeNav === 'preeti' ? 'bg-[var(--accent-primary)]/10 text-[var(--accent-primary)] font-bold' : 'text-[var(--text-primary)] hover:bg-[var(--bg-surface-subtle)]'}`}
          >
            <div>
              <div class="font-semibold text-[var(--text-primary)]">Preeti Font Typing</div>
              <div class="text-[10px] text-[var(--text-muted)]">Classic Legacy ASCII</div>
            </div>
            <span class="text-[10px] px-1.5 py-0.5 rounded font-mono bg-amber-500/15 text-amber-500 font-bold">ASCII</span>
          </a>

          <a 
            href="/english-typing-test" 
            class={`px-2.5 py-2 rounded-lg text-xs transition-colors flex items-center justify-between ${activeNav === 'english' ? 'bg-[var(--accent-primary)]/10 text-[var(--accent-primary)] font-bold' : 'text-[var(--text-primary)] hover:bg-[var(--bg-surface-subtle)]'}`}
          >
            <div>
              <div class="font-semibold text-[var(--text-primary)]">English Typing</div>
              <div class="text-[10px] text-[var(--text-muted)]">QWERTY Global WPM</div>
            </div>
            <span class="text-[10px] px-1.5 py-0.5 rounded font-mono bg-emerald-500/15 text-emerald-500 font-bold">QWERTY</span>
          </a>

          <div class="my-1 border-t border-[var(--border-subtle)]"></div>

          <a 
            href="/loksewa-typing-test" 
            class={`px-2.5 py-1.5 rounded-lg text-xs transition-colors flex items-center justify-between ${activeNav === 'loksewa' ? 'bg-[var(--accent-primary)]/10 text-[var(--accent-primary)] font-bold' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-subtle)]'}`}
          >
            <div class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
              <span>Loksewa Exam Practice</span>
            </div>
            <span class="text-[9px] px-1 py-0.2 rounded bg-rose-500/10 text-rose-500 font-bold">PSC</span>
          </a>
        </div>
      </div>

      <a 
        href="/preeti-to-unicode" 
        class={`px-3 py-1.5 rounded-lg transition-colors flex items-center gap-1.5 ${activeNav === 'converter' ? 'bg-[var(--bg-surface-subtle)] text-rose-500 font-bold' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-subtle)]'}`}
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 3 21 3 21 8"></polyline><line x1="4" y1="20" x2="21" y2="3"></line><polyline points="21 16 21 21 16 21"></polyline><line x1="15" y1="15" x2="21" y2="21"></line><line x1="4" y1="4" x2="9" y2="9"></line></svg>
        <span>Preeti Converter</span>
      </a>

      <a 
        href="/ams-to-unicode" 
        class={`px-3 py-1.5 rounded-lg transition-colors flex items-center gap-1.5 ${activeNav === 'ams-converter' ? 'bg-[var(--bg-surface-subtle)] text-amber-500 font-bold' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-subtle)]'}`}
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19l7-7 3 3-7 7-3-3z"></path><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path><path d="M2 2l7.586 7.586"></path><circle cx="11" cy="11" r="2"></circle></svg>
        <span>AMS Converter</span>
      </a>

      <a 
        href="/keyboard-layout" 
        class={`px-2.5 py-1.5 rounded-lg transition-colors whitespace-nowrap ${activeNav === 'layouts' ? 'bg-[var(--bg-surface-subtle)] text-[var(--accent-primary)] font-bold' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-subtle)]'}`}
      >
        Layouts
      </a>

      <a 
        href="/test" 
        class={`px-2.5 py-1.5 rounded-lg transition-colors whitespace-nowrap ${activeNav === 'certification' ? 'bg-[var(--bg-surface-subtle)] text-[var(--accent-primary)] font-bold' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-subtle)]'}`}
      >
        Certification
      </a>

      <a 
        href="/verify" 
        class={`px-2.5 py-1.5 rounded-lg transition-colors whitespace-nowrap ${activeNav === 'verify' ? 'bg-[var(--bg-surface-subtle)] text-[var(--accent-primary)] font-bold' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-subtle)]'}`}
      >
        Verify
      </a>

      <a 
        href="/drills" 
        class={`px-2.5 py-1.5 rounded-lg transition-colors whitespace-nowrap ${activeNav === 'drills' ? 'bg-[var(--bg-surface-subtle)] text-[var(--accent-primary)] font-bold' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-subtle)]'}`}
      >
        Drills
      </a>

      <a 
        href="/analytics" 
        id="top-analytics-link"
        class={`px-2.5 py-1.5 rounded-lg transition-colors flex items-center gap-1.5 whitespace-nowrap ${activeNav === 'analytics' ? 'bg-[var(--bg-surface-subtle)] text-blue-600 dark:text-blue-400 font-bold' : 'text-[var(--text-secondary)] hover:text-blue-600 hover:bg-[var(--bg-surface-subtle)]'}`}
        title="Biometric Typing Analytics"
      >
        <span>Analytics</span>
      </a>

      <a 
        href="https://fonts.topnepali.com" 
        target="_blank"
        rel="noopener"
        class="px-2.5 py-1.5 rounded-lg transition-colors flex items-center gap-1.5 whitespace-nowrap text-[var(--text-secondary)] hover:text-rose-600 hover:bg-[var(--bg-surface-subtle)]"
        title="Explore 2,100+ Free Nepali & Devanagari Fonts"
      >
        <svg class="w-3.5 h-3.5 text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 7 4 4 20 4 20 7"></polyline><line x1="9" y1="20" x2="15" y2="20"></line><line x1="12" y1="4" x2="12" y2="20"></line></svg>
        <span>Fonts</span>
      </a>
    </nav>

    <!-- Top Bar Controls (Sleek, matching buttons: Theme Toggle, 9-Dot Launcher, Mobile Hamburger) -->
    <div class="flex items-center gap-2 shrink-0">
      
      <!-- Theme Toggle (Dark / Light) with Sleek Pill Design -->
      <button 
        id="theme-toggle-btn" 
        class="theme-toggle-btn w-9 h-9 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] hover:bg-[var(--bg-surface-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all flex items-center justify-center cursor-pointer shadow-xs shrink-0"
        title="Toggle Theme (Dark / Light)"
        aria-label="Toggle Theme"
      >
        <svg class="theme-icon-sun w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg class="theme-icon-moon w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <!-- TopNepali 9-Dot Network Launcher -->
      <TopNepaliNetwork currentApp="typing" />

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-toggle-btn"
        class="header-burger w-9 h-9 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] hover:bg-[var(--bg-surface-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-all flex items-center justify-center cursor-pointer shadow-xs shrink-0"
        title="Toggle Menu"
        aria-label="Toggle Menu"
        aria-expanded="false"
        aria-controls="mobile-menu-drawer"
      >
        <svg id="hamburger-icon" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg id="close-menu-icon" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile Collapsible Navigation Drawer -->
  <div 
    id="mobile-menu-drawer" 
    class="mobile-drawer border-t border-[var(--border-subtle)] bg-[var(--bg-surface)] px-4 py-4 shadow-xl"
  >
    <div class="flex flex-col gap-1.5 text-sm font-semibold">
      <a 
        href="/" 
        class={`px-3 py-2.5 rounded-xl transition-colors ${activeNav === 'home' ? 'bg-[var(--bg-surface-subtle)] text-[var(--accent-primary)] font-bold' : 'text-[var(--text-secondary)] hover:bg-[var(--bg-surface-subtle)]'}`}
      >
        Home (Landing Page)
      </a>

      <!-- Typeshala Bench Modes Submenu -->
      <div class="border border-[var(--border-subtle)] rounded-2xl p-3 bg-[var(--bg-surface-subtle)]/40 space-y-1 my-1">
        <div class="px-1 py-0.5 flex items-center justify-between text-[11px] font-bold uppercase tracking-wider text-[var(--accent-primary)]">
          <span>Typeshala Bench</span>
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-[var(--accent-primary)]/15 font-mono">4 Modes</span>
        </div>
        <div class="space-y-1 pt-1.5">
          <a 
            href="/nepali-traditional-typing-test" 
            class={`px-2.5 py-2 rounded-xl text-xs font-semibold flex items-center justify-between transition-colors ${activeNav === 'traditional' ? 'bg-[var(--bg-surface)] text-[var(--accent-primary)] font-bold shadow-xs' : 'text-[var(--text-primary)] hover:bg-[var(--bg-surface)]'}`}
          >
            <span>Nepali Traditional (MPP)</span>
            <span class="text-[10px] px-1.5 py-0.5 rounded font-mono bg-sky-500/15 text-sky-500">Unicode</span>
          </a>
          <a 
            href="/romanized-nepali-typing-test" 
            class={`px-2.5 py-2 rounded-xl text-xs font-semibold flex items-center justify-between transition-colors ${activeNav === 'romanized' ? 'bg-[var(--bg-surface)] text-[var(--accent-primary)] font-bold shadow-xs' : 'text-[var(--text-primary)] hover:bg-[var(--bg-surface)]'}`}
          >
            <span>Nepali Romanized</span>
            <span class="text-[10px] px-1.5 py-0.5 rounded font-mono bg-purple-500/15 text-purple-500">Phonetic</span>
          </a>
          <a 
            href="/preeti-typing-test" 
            class={`px-2.5 py-2 rounded-xl text-xs font-semibold flex items-center justify-between transition-colors ${activeNav === 'preeti' ? 'bg-[var(--bg-surface)] text-[var(--accent-primary)] font-bold shadow-xs' : 'text-[var(--text-primary)] hover:bg-[var(--bg-surface)]'}`}
          >
            <span>Preeti Font Typing</span>
            <span class="text-[10px] px-1.5 py-0.5 rounded font-mono bg-amber-500/15 text-amber-500">ASCII</span>
          </a>
          <a 
            href="/english-typing-test" 
            class={`px-2.5 py-2 rounded-xl text-xs font-semibold flex items-center justify-between transition-colors ${activeNav === 'english' ? 'bg-[var(--bg-surface)] text-[var(--accent-primary)] font-bold shadow-xs' : 'text-[var(--text-primary)] hover:bg-[var(--bg-surface)]'}`}
          >
            <span>English Typing</span>
            <span class="text-[10px] px-1.5 py-0.5 rounded font-mono bg-emerald-500/15 text-emerald-500">QWERTY</span>
          </a>
          <a 
            href="/loksewa-typing-test" 
            class={`px-2.5 py-2 rounded-xl text-xs font-semibold flex items-center justify-between transition-colors ${activeNav === 'loksewa' ? 'bg-[var(--bg-surface)] text-rose-500 font-bold shadow-xs' : 'text-rose-500 hover:bg-[var(--bg-surface)]'}`}
          >
            <span>Loksewa Exam Practice</span>
            <span class="text-[10px] px-1.5 py-0.5 rounded bg-rose-500/15 text-rose-500 font-bold">PSC</span>
          </a>
        </div>
      </div>

      <a 
        href="/keyboard-layout" 
        class={`px-3 py-2.5 rounded-xl transition-colors ${activeNav === 'layouts' ? 'bg-[var(--bg-surface-subtle)] text-[var(--accent-primary)] font-bold' : 'text-[var(--text-secondary)] hover:bg-[var(--bg-surface-subtle)]'}`}
      >
        Keyboard Layouts
      </a>

      <a 
        href="/preeti-to-unicode" 
        class={`flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-semibold transition-colors ${activeNav === 'converter' ? 'bg-[var(--bg-surface-subtle)] text-rose-500 font-bold' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-subtle)]'}`}
      >
        <div class="flex items-center gap-3">
          <svg class="w-4 h-4 text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 3 21 3 21 8"></polyline><line x1="4" y1="20" x2="21" y2="3"></line><polyline points="21 16 21 21 16 21"></polyline><line x1="15" y1="15" x2="21" y2="21"></line><line x1="4" y1="4" x2="9" y2="9"></line></svg>
          <span>Preeti Converter</span>
        </div>
        <span class="text-[11px] text-[var(--text-muted)] font-normal">Unicode &amp; Rich Text</span>
      </a>

      <a 
        href="/ams-to-unicode" 
        class={`flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-semibold transition-colors ${activeNav === 'ams-converter' ? 'bg-[var(--bg-surface-subtle)] text-amber-500 font-bold' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-subtle)]'}`}
      >
        <div class="flex items-center gap-3">
          <svg class="w-4 h-4 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19l7-7 3 3-7 7-3-3z"></path><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path><path d="M2 2l7.586 7.586"></path><circle cx="11" cy="11" r="2"></circle></svg>
          <span>AMS Converter</span>
        </div>
        <span class="text-[11px] text-[var(--text-muted)] font-normal">IndiaFont Calligraphy</span>
      </a>

      <a 
        href="/test" 
        class={`px-3 py-2.5 rounded-xl transition-colors ${activeNav === 'certification' ? 'bg-[var(--bg-surface-subtle)] text-[var(--accent-primary)] font-bold' : 'text-[var(--text-secondary)] hover:bg-[var(--bg-surface-subtle)]'}`}
      >
        Certification Exam
      </a>

      <a 
        href="/verify" 
        class={`px-3 py-2.5 rounded-xl transition-colors ${activeNav === 'verify' ? 'bg-[var(--bg-surface-subtle)] text-[var(--accent-primary)] font-bold' : 'text-[var(--text-secondary)] hover:bg-[var(--bg-surface-subtle)]'}`}
      >
        Verify Certificate
      </a>

      <a 
        href="/drills" 
        class={`px-3 py-2.5 rounded-xl transition-colors ${activeNav === 'drills' ? 'bg-[var(--bg-surface-subtle)] text-[var(--accent-primary)] font-bold' : 'text-[var(--text-secondary)] hover:bg-[var(--bg-surface-subtle)]'}`}
      >
        Adaptive Drills
      </a>

      <a 
        href="/analytics" 
        class={`px-3 py-2.5 rounded-xl transition-colors ${activeNav === 'analytics' ? 'bg-[var(--bg-surface-subtle)] text-blue-600 dark:text-blue-400 font-bold' : 'text-[var(--text-secondary)] hover:bg-[var(--bg-surface-subtle)]'}`}
      >
        Analytics
      </a>

      <div class="my-1 border-t border-[var(--border-subtle)]"></div>

      <a 
        href="https://fonts.topnepali.com" 
        target="_blank"
        rel="noopener"
        class="flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-semibold transition-colors text-rose-600 dark:text-rose-400 bg-rose-50/70 dark:bg-rose-950/30 hover:bg-rose-100 dark:hover:bg-rose-950/50"
      >
        <div class="flex items-center gap-3">
          <svg class="w-4 h-4 text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 7 4 4 20 4 20 7"></polyline><line x1="9" y1="20" x2="15" y2="20"></line><line x1="12" y1="4" x2="12" y2="20"></line></svg>
          <span>Download 2,100+ Fonts (TNF)</span>
        </div>
        <span class="text-[10px] px-1.5 py-0.5 rounded font-mono bg-rose-500/15 text-rose-600 font-bold">FontsDir &rarr;</span>
      </a>
    </div>
  </div>
</header>

<style>
  .header-nav {
    display: none;
  }
  .header-burger {
    display: flex;
  }
  .mobile-drawer {
    display: none;
  }
  .mobile-drawer.is-open {
    display: block;
  }

  /* Scoped Typeshala Bench Dropdown */
  .typeshala-dropdown-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .typeshala-dropdown-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: 0.35rem;
    width: 17rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 1rem;
    padding: 0.5rem;
    box-shadow: 0 16px 36px -4px rgba(0, 0, 0, 0.28), 0 4px 12px -2px rgba(0, 0, 0, 0.15);
    z-index: 100;
    backdrop-filter: blur(12px);
  }
  .typeshala-dropdown-menu::before {
    content: '';
    position: absolute;
    top: -0.5rem;
    left: 0;
    right: 0;
    height: 0.5rem;
  }
  .typeshala-dropdown-wrapper:hover .typeshala-dropdown-menu,
  .typeshala-dropdown-wrapper:focus-within .typeshala-dropdown-menu,
  .typeshala-dropdown-wrapper.is-open .typeshala-dropdown-menu {
    display: flex !important;
    flex-direction: column;
    gap: 0.25rem;
  }
  .typeshala-dropdown-wrapper:hover .typeshala-chevron,
  .typeshala-dropdown-wrapper.is-open .typeshala-chevron {
    transform: rotate(180deg);
  }

  /* Smart sticky header on scroll-up */
  #site-header {
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.28s ease;
    will-change: transform;
  }
  #site-header.header-hidden {
    transform: translateY(-100%);
  }
  #site-header.header-scrolled-up {
    transform: translateY(0);
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.08);
  }

  @media (min-width: 768px) {
    .header-nav {
      display: flex !important;
    }
    .header-burger {
      display: none !important;
    }
    .mobile-drawer {
      display: none !important;
    }
  }
</style>

<script is:inline>
  (function initHeader() {
    const header = document.getElementById('site-header');
    const toggleBtn = document.getElementById('mobile-menu-toggle-btn');
    const drawer = document.getElementById('mobile-menu-drawer');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-menu-icon');
    const dropdownWrapper = document.querySelector('.typeshala-dropdown-wrapper');
    const dropdownTrigger = document.getElementById('typeshala-dropdown-trigger');

    // Desktop Dropdown Toggle
    if (dropdownTrigger && dropdownWrapper) {
      dropdownTrigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = dropdownWrapper.classList.toggle('is-open');
        dropdownTrigger.setAttribute('aria-expanded', String(isOpen));
      });

      document.addEventListener('click', (e) => {
        if (!dropdownWrapper.contains(e.target)) {
          dropdownWrapper.classList.remove('is-open');
          dropdownTrigger.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // Mobile Hamburger Toggle
    function toggleMenu() {
      const isExpanded = toggleBtn?.getAttribute('aria-expanded') === 'true';
      const nextState = !isExpanded;
      toggleBtn?.setAttribute('aria-expanded', String(nextState));
      drawer?.classList.toggle('is-open', nextState);
      hamburgerIcon?.classList.toggle('hidden', nextState);
      closeIcon?.classList.toggle('hidden', !nextState);
    }

    function closeMenu() {
      toggleBtn?.setAttribute('aria-expanded', 'false');
      drawer?.classList.remove('is-open');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    }

    toggleBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMenu();
    });

    drawer?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('click', (e) => {
      if (header && !header.contains(e.target)) {
        closeMenu();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeMenu();
        if (dropdownWrapper) {
          dropdownWrapper.classList.remove('is-open');
          dropdownTrigger?.setAttribute('aria-expanded', 'false');
        }
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768) {
        closeMenu();
      }
    });

    // Smart Scroll-Up Sticky Navigation: Hide on scroll down, sticky reveal on scroll up
    if (header) {
      let lastScrollY = window.pageYOffset || document.documentElement.scrollTop;
      let isTicking = false;

      function handleScroll() {
        const currentScrollY = window.pageYOffset || document.documentElement.scrollTop;

        // At top of page: always docked naturally without transform or elevation
        if (currentScrollY <= 20) {
          header.classList.remove('header-hidden');
          header.classList.remove('header-scrolled-up');
          lastScrollY = currentScrollY;
          isTicking = false;
          return;
        }

        const deltaY = currentScrollY - lastScrollY;

        // Scrolling Down: slide up out of view
        if (deltaY > 6 && currentScrollY > 70) {
          if (!header.classList.contains('header-hidden')) {
            header.classList.add('header-hidden');
            header.classList.remove('header-scrolled-up');

            // Close open menus when scrolling down
            if (dropdownWrapper?.classList.contains('is-open')) {
              dropdownWrapper.classList.remove('is-open');
              dropdownTrigger?.setAttribute('aria-expanded', 'false');
            }
            if (drawer?.classList.contains('is-open')) {
              closeMenu();
            }
          }
        } 
        // Scrolling Up: slide down into sticky position
        else if (deltaY < -6) {
          if (header.classList.contains('header-hidden')) {
            header.classList.remove('header-hidden');
            header.classList.add('header-scrolled-up');
          }
        }

        lastScrollY = currentScrollY;
        isTicking = false;
      }

      window.addEventListener('scroll', () => {
        if (!isTicking) {
          window.requestAnimationFrame(handleScroll);
          isTicking = true;
        }
      }, { passive: true });
    }
  })();
</script>
