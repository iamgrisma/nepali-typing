---
import TopNepaliNetwork from './TopNepaliNetwork.astro';

interface Props {
  siteTitle?: string;
  activeNav?: string;
}

const { activeNav = 'test' } = Astro.props;
---

<header class="border-b border-[var(--border-subtle)] bg-[var(--bg-surface)] sticky top-0 z-40 backdrop-blur-md bg-opacity-95">
  <div class="container flex items-center justify-between h-16">
    
    <!-- Logo & Brand -->
    <a href="/" class="flex items-center gap-2 text-decoration-none group shrink-0 mr-3 sm:mr-4">
      <div class="brand-logo-badge w-8 h-8 rounded-xl flex items-center justify-center text-white font-bold text-base shadow-sm group-hover:scale-105 transition-transform shrink-0" style="font-family: var(--font-nepali);">
        ने
      </div>
      <span class="font-bold text-base font-display tracking-tight text-[var(--text-primary)]">
        Typeshala<span class="text-red-600">Bench</span>
      </span>
    </a>

    <!-- Primary Desktop Navigation (Simple, Compact Text Links - No Icons) -->
    <nav class="header-nav items-center gap-1 text-xs font-semibold">
      <a 
        href="/" 
        class={`px-2.5 py-1.5 rounded-lg transition-colors whitespace-nowrap ${activeNav === 'test' ? 'bg-[var(--bg-surface-subtle)] text-[var(--accent-primary)] font-bold' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-subtle)]'}`}
      >
        Typeshala Bench
      </a>

      <a 
        href="/preeti-to-unicode" 
        class={`px-3 py-1.5 rounded-lg transition-colors flex items-center gap-1.5 ${activeNav === 'converter' ? 'bg-[var(--bg-surface-subtle)] text-rose-500 font-bold' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-subtle)]'}`}
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 3 21 3 21 8"></polyline><line x1="4" y1="20" x2="21" y2="3"></line><polyline points="21 16 21 21 16 21"></polyline><line x1="15" y1="15" x2="21" y2="21"></line><line x1="4" y1="4" x2="9" y2="9"></line></svg>
        <span>Preeti Converter</span>
      </a>

      <a 
        href="/keyboard-layout" 
        class={`px-2.5 py-1.5 rounded-lg transition-colors whitespace-nowrap ${activeNav === 'layouts' ? 'bg-[var(--bg-surface-subtle)] text-[var(--accent-primary)] font-bold' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-subtle)]'}`}
      >
        Layouts
      </a>

      <a 
        href="/test" 
        class={`px-2.5 py-1.5 rounded-lg transition-colors whitespace-nowrap ${activeNav === 'certification' ? 'bg-[var(--bg-surface-subtle)] text-[var(--accent-primary)] font-bold' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-subtle)]'}`}
      >
        Certification
      </a>

      <a 
        href="/verify" 
        class={`px-2.5 py-1.5 rounded-lg transition-colors whitespace-nowrap ${activeNav === 'verify' ? 'bg-[var(--bg-surface-subtle)] text-[var(--accent-primary)] font-bold' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-subtle)]'}`}
      >
        Verify
      </a>

      <a 
        href="/drills" 
        class={`px-2.5 py-1.5 rounded-lg transition-colors whitespace-nowrap ${activeNav === 'drills' ? 'bg-[var(--bg-surface-subtle)] text-[var(--accent-primary)] font-bold' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-subtle)]'}`}
      >
        Drills
      </a>

      <a 
        href="/analytics" 
        id="top-analytics-link"
        class={`px-2.5 py-1.5 rounded-lg transition-colors flex items-center gap-1.5 whitespace-nowrap ${activeNav === 'analytics' ? 'bg-[var(--bg-surface-subtle)] text-blue-600 dark:text-blue-400 font-bold' : 'text-[var(--text-secondary)] hover:text-blue-600 hover:bg-[var(--bg-surface-subtle)]'}`}
        title="Biometric Typing Analytics"
      >
        <span>Analytics</span>
        <span id="header-stats-badge" class="top-stats-badge font-mono text-[10px] px-1.5 py-0.2 rounded-full bg-blue-500/15 text-blue-600 dark:text-blue-400 font-bold">
          0
        </span>
      </a>
    </nav>

    <!-- Top Bar Controls (Single Cluster: History, Sound, Theme, 9-Dot Launcher, Hamburger on mobile) -->
    <div class="flex items-center gap-1 sm:gap-1.5 shrink-0">
      <!-- History Modal Trigger (Desktop) -->
      <button 
        id="open-history-btn" 
        class="header-desktop-tool p-2 rounded-xl text-[var(--text-secondary)] hover:bg-[var(--bg-surface-subtle)] hover:text-[var(--text-primary)] transition-colors cursor-pointer"
        title="Typing History"
        aria-label="History"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 3v5h5"></path>
          <path d="M3.05 13A9 9 0 1 0 6 5.3L3 8"></path>
          <path d="M12 7v5l4 2"></path>
        </svg>
      </button>

      <!-- Keystroke Sound Toggle (Desktop) -->
      <button 
        id="sound-toggle-btn" 
        class="header-desktop-tool p-2 rounded-xl text-[var(--text-secondary)] hover:bg-[var(--bg-surface-subtle)] hover:text-[var(--text-primary)] transition-colors cursor-pointer"
        title="Toggle Audio Feedback"
        aria-label="Toggle Sound"
      >
        <svg id="sound-icon-on" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
          <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
        </svg>
        <svg id="sound-icon-off" class="w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
          <line x1="23" y1="9" x2="17" y2="15"></line>
          <line x1="17" y1="9" x2="23" y2="15"></line>
        </svg>
      </button>

      <!-- Theme Toggle (Dark / Light) — SINGLE INSTANCE FOR BOTH MOBILE & DESKTOP -->
      <button 
        id="theme-toggle-btn" 
        class="theme-toggle-btn p-2 rounded-xl text-[var(--text-secondary)] hover:bg-[var(--bg-surface-subtle)] hover:text-[var(--text-primary)] transition-colors cursor-pointer"
        title="Toggle Theme"
        aria-label="Toggle Theme"
      >
        <svg class="theme-icon-sun w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg class="theme-icon-moon w-4 h-4 viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <!-- TopNepali 9-Dot Network Launcher — SINGLE INSTANCE -->
      <TopNepaliNetwork currentApp="typing" />

      <!-- Mobile Hamburger Button — STRICTLY MOBILE ONLY -->
      <button
        id="mobile-menu-toggle-btn"
        class="header-burger p-2 rounded-xl text-[var(--text-secondary)] hover:bg-[var(--bg-surface-subtle)] hover:text-[var(--text-primary)] transition-colors focus:outline-none cursor-pointer"
        title="Toggle Menu"
        aria-label="Toggle Menu"
        aria-expanded="false"
        aria-controls="mobile-menu-drawer"
      >
        <svg id="hamburger-icon" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg id="close-menu-icon" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile Collapsible Navigation Drawer -->
  <div 
    id="mobile-menu-drawer" 
    class="mobile-drawer border-t border-[var(--border-subtle)] bg-[var(--bg-surface)] px-4 py-3 shadow-lg"
  >
    <div class="flex flex-col gap-1 text-sm font-semibold">
      <a 
        href="/" 
        class={`px-3 py-2 rounded-xl transition-colors ${activeNav === 'test' ? 'bg-[var(--bg-surface-subtle)] text-[var(--accent-primary)] font-bold' : 'text-[var(--text-secondary)] hover:bg-[var(--bg-surface-subtle)]'}`}
      >
        Typeshala Bench
      </a>

      <a 
        href="/keyboard-layout" 
        class={`px-3 py-2 rounded-xl transition-colors ${activeNav === 'layouts' ? 'bg-[var(--bg-surface-subtle)] text-[var(--accent-primary)] font-bold' : 'text-[var(--text-secondary)] hover:bg-[var(--bg-surface-subtle)]'}`}
      >
        Keyboard Layouts
      </a>

      <a 
        href="/preeti-to-unicode" 
        class={`flex items-center justify-between px-3 py-2.5 rounded-xl text-sm font-semibold transition-colors ${activeNav === 'converter' ? 'bg-[var(--bg-surface-subtle)] text-rose-500 font-bold' : 'text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-surface-subtle)]'}`}
      >
        <div class="flex items-center gap-3">
          <svg class="w-4 h-4 text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 3 21 3 21 8"></polyline><line x1="4" y1="20" x2="21" y2="3"></line><polyline points="21 16 21 21 16 21"></polyline><line x1="15" y1="15" x2="21" y2="21"></line><line x1="4" y1="4" x2="9" y2="9"></line></svg>
          <span>Preeti Converter</span>
        </div>
        <span class="text-[11px] text-[var(--text-muted)] font-normal">Unicode & Rich Text</span>
      </a>

      <a 
        href="/test" 
        class={`px-3 py-2 rounded-xl transition-colors ${activeNav === 'certification' ? 'bg-[var(--bg-surface-subtle)] text-[var(--accent-primary)] font-bold' : 'text-[var(--text-secondary)] hover:bg-[var(--bg-surface-subtle)]'}`}
      >
        Certification Exam
      </a>

      <a 
        href="/verify" 
        class={`px-3 py-2 rounded-xl transition-colors ${activeNav === 'verify' ? 'bg-[var(--bg-surface-subtle)] text-[var(--accent-primary)] font-bold' : 'text-[var(--text-secondary)] hover:bg-[var(--bg-surface-subtle)]'}`}
      >
        Verify Certificate
      </a>

      <a 
        href="/drills" 
        class={`px-3 py-2 rounded-xl transition-colors ${activeNav === 'drills' ? 'bg-[var(--bg-surface-subtle)] text-[var(--accent-primary)] font-bold' : 'text-[var(--text-secondary)] hover:bg-[var(--bg-surface-subtle)]'}`}
      >
        Adaptive Drills
      </a>

      <a 
        href="/analytics" 
        class={`px-3 py-2 rounded-xl transition-colors ${activeNav === 'analytics' ? 'bg-[var(--bg-surface-subtle)] text-blue-600 dark:text-blue-400 font-bold' : 'text-[var(--text-secondary)] hover:bg-[var(--bg-surface-subtle)]'}`}
      >
        Analytics
      </a>
    </div>
  </div>
</header>

<style>
  .header-nav {
    display: none;
  }
  .header-burger {
    display: flex;
  }
  .header-desktop-tool {
    display: none;
  }
  .mobile-drawer {
    display: none;
  }
  .mobile-drawer.is-open {
    display: block;
  }

  @media (min-width: 768px) {
    .header-nav {
      display: flex !important;
    }
    .header-burger {
      display: none !important;
    }
    .header-desktop-tool {
      display: flex !important;
    }
    .mobile-drawer {
      display: none !important;
    }
  }
</style>

<script is:inline>
  (function initHeader() {
    const toggleBtn = document.getElementById('mobile-menu-toggle-btn');
    const drawer = document.getElementById('mobile-menu-drawer');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-menu-icon');

    function toggleMenu() {
      const isExpanded = toggleBtn?.getAttribute('aria-expanded') === 'true';
      const nextState = !isExpanded;
      toggleBtn?.setAttribute('aria-expanded', String(nextState));
      drawer?.classList.toggle('is-open', nextState);
      hamburgerIcon?.classList.toggle('hidden', nextState);
      closeIcon?.classList.toggle('hidden', !nextState);
    }

    function closeMenu() {
      toggleBtn?.setAttribute('aria-expanded', 'false');
      drawer?.classList.remove('is-open');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    }

    toggleBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMenu();
    });

    drawer?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('click', (e) => {
      const header = document.querySelector('header');
      if (header && !header.contains(e.target)) {
        closeMenu();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768) {
        closeMenu();
      }
    });
  })();
</script>
