---
// Hardware Keyboard Visualizer Component
// Displays 5 rows of hardware keyboard with real-time keypress sync
---

<div id="keyboard-visualizer-container" class="w-full transition-all duration-300">
  <div class="kb-wrapper mb-6">
    <!-- Header of Keyboard Visualizer -->
    <div class="flex flex-wrap items-center justify-between gap-2 pb-1.5 mb-1.5 border-b border-[var(--border-subtle)] text-xs">
      <div class="flex items-center gap-2">
        <span class="font-bold text-xs sm:text-sm text-[var(--text-primary)]" id="kb-current-layout-name">
          नेपाली युनिकोड (Traditional) Keyboard Layout
        </span>
        <span class="px-2 py-0.5 rounded-full font-mono text-[10px] font-bold bg-blue-500/10 text-blue-600 dark:text-blue-400" id="kb-layout-pill">
          MPP TRADITIONAL
        </span>
      </div>

      <!-- Action Controls for Keyboard -->
      <div class="flex items-center gap-2">
        <button 
          type="button" 
          id="kb-shift-toggle" 
          class="px-2 py-0.5 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface-subtle)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] font-mono flex items-center gap-1 text-[11px]"
          title="Toggle Shift Layer (Shift Key)"
        >
          <span>Shift</span>
          <span id="kb-shift-indicator" class="w-2 h-2 rounded-full bg-neutral-400 inline-block"></span>
        </button>
      </div>
    </div>

    <!-- 5 Rows Keyboard Matrix Container -->
    <div id="keyboard-matrix" class="w-full flex flex-col gap-1 select-none overflow-x-auto">
      <div class="kb-row flex gap-1 w-full" data-row="1"></div>
      <div class="kb-row flex gap-1 w-full" data-row="2"></div>
      <div class="kb-row flex gap-1 w-full" data-row="3"></div>
      <div class="kb-row flex gap-1 w-full" data-row="4"></div>
      <div class="kb-row flex gap-1 w-full justify-center" data-row="5"></div>
    </div>

    <!-- Keystroke Detail Helper Bar -->
    <div class="mt-1.5 pt-1.5 border-t border-[var(--border-subtle)] flex flex-wrap items-center justify-between gap-2 text-[11px] text-[var(--text-muted)]">
      <div class="flex items-center gap-4">
        <div>Next: <span id="kb-target-char" class="font-bold text-[var(--accent-primary)] font-mono text-xs ml-0.5">-</span></div>
        <div>Active: <span id="kb-active-char" class="font-bold text-[var(--text-primary)] font-mono ml-0.5">-</span></div>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-sm bg-[var(--accent-primary)] opacity-40 inline-block"></span>
        <span>Target Key</span>
        <span class="w-2 h-2 rounded-sm bg-blue-500 opacity-60 inline-block ml-1.5"></span>
        <span>Pressed Key</span>
      </div>
    </div>
  </div>
</div>
