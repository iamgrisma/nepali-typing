---
// Hardware Keyboard Visualizer Component
// Displays 5 rows of hardware keyboard with real-time keypress sync
import { KEY_ROWS } from '../../public/js/data/keyboards.js';

interface Props {
  defaultLang?: string;
}

const { defaultLang = 'nepali_unicode' } = Astro.props;

function getKeyLabels(k: any, lang: string) {
  if (k.special || k.shell) return { top: '', main: k.label || k.key, font: 'var(--font-sans)' };
  if (lang === 'english') {
    const top = k.eng[1] !== k.eng[0].toUpperCase() ? k.eng[1] : '';
    return { top, main: k.eng[0], font: 'var(--font-sans)' };
  }
  if (lang === 'nepali_romanized') {
    return { top: k.rom[1], main: k.rom[0], font: 'var(--font-nepali)' };
  }
  if (lang === 'nepali_preeti') {
    return { top: k.pre[0], main: k.pre[2], font: 'var(--font-nepali)' };
  }
  // Default traditional
  return { top: k.uni[1], main: k.uni[0], font: 'var(--font-nepali)' };
}

const LAYOUT_TITLES: Record<string, { title: string; hint: string }> = {
  english: { title: 'English QWERTY Layout', hint: '' },
  nepali_romanized: { title: 'Romanized Layout', hint: '(Shift+Alt or Shift+Enter to Switch)' },
  nepali_preeti: { title: 'Preeti Layout', hint: '(Shift+Alt or Shift+Enter to Switch)' },
  nepali_unicode: { title: 'Traditional Layout', hint: '(Shift+Alt or Shift+Enter to Switch)' }
};

const meta = LAYOUT_TITLES[defaultLang] || LAYOUT_TITLES.nepali_unicode;
---

<!-- 1. Detached Layout Status Bar (Always visible even if virtual keyboard deck is hidden) -->
<div id="layout-status-bar" class="w-full flex items-center justify-between text-xs py-1.5 px-1 border-b border-[var(--border-subtle)] mb-3">
  <div class="flex items-center gap-2">
    <span class="font-bold text-xs sm:text-sm text-[var(--text-primary)]" id="kb-current-layout-name">
      {meta.title}
    </span>
    <span id="kb-switch-hint" class={`text-[11px] text-[var(--text-muted)] font-mono ${defaultLang === 'english' ? 'hidden' : 'inline'}`}>
      {meta.hint}
    </span>
  </div>

  <!-- Minimalist Input Mode Indicator & Clickable Toggle -->
  <button 
    type="button" 
    id="kb-input-mode-btn" 
    class={`px-2.5 py-1 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-primary)] hover:border-[var(--accent-primary)] font-mono flex items-center gap-1.5 text-xs font-semibold transition-all shadow-xs cursor-pointer ${defaultLang === 'english' ? 'hidden' : ''}`}
    title="Toggle Input Layout between Native Nepali and QWERTY (Shortcut: Shift+Alt or Shift+Enter)"
  >
    <span id="kb-input-mode-dot" class="w-2 h-2 rounded-full bg-emerald-500 inline-block"></span>
    <span id="kb-input-mode-label">Native</span>
  </button>
</div>

<!-- 2. Hardware Keyboard Visualizer Deck (Toggled by "Keys" button) -->
<div id="keyboard-visualizer-container" class="w-full transition-all duration-300 mb-5">
  <div class="kb-wrapper">
    <!-- 5 Rows Keyboard Matrix Container with tactile keyboard deck pre-rendered in SSR to guarantee 0.00 CLS -->
    <div id="keyboard-matrix" class="w-full min-h-[225px] sm:min-h-[240px] flex flex-col gap-1.5 select-none overflow-x-auto p-2 sm:p-2.5 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
      {KEY_ROWS.map((row, rI) => (
        <div class={`kb-row flex gap-1 w-full ${rI === 4 ? 'justify-center' : ''}`} data-row={rI + 1}>
          {row.map(k => {
            const { top, main, font } = getKeyLabels(k, defaultLang);
            const extraCls = k.shell ? 'special-key shell-key' : (k.special ? 'special-key' : '');
            return (
              <div 
                class={`keycap ${extraCls}`.trim()} 
                data-code={k.code} 
                style={`flex: ${k.flex} 1 0%;`}
              >
                {(k.shell || k.special) ? (
                  k.label || k.key
                ) : (
                  <>
                    <span class="keycap-shift-label">{top}</span>
                    <span class="keycap-main-label" style={`font-family: ${font};`}>{main}</span>
                  </>
                )}
              </div>
            );
          })}
        </div>
      ))}
    </div>
  </div>
</div>
