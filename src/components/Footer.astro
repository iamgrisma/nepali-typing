---
// TopNepali Typing Footer Component
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-[var(--border-subtle)] bg-[var(--bg-surface)] py-8 text-xs text-[var(--text-muted)]">
  <div class="container flex flex-col md:flex-row items-center justify-between gap-6 px-4">
    
    <div class="flex items-center gap-2">
      <span class="w-6 h-6 rounded-lg bg-red-600 text-white font-bold flex items-center justify-center text-xs" style="font-family: var(--font-nepali);">
        ने
      </span>
      <span class="font-display font-semibold text-[var(--text-primary)]">
        TopNepali Typing
      </span>
      <span>• Professional Typing Certification Platform</span>
    </div>

    <div class="flex items-center gap-4 flex-wrap justify-center text-xs">
      <a href="/" class="hover:text-[var(--text-primary)] transition-colors">Typing Bench</a>
      <a href="/test" class="hover:text-[var(--text-primary)] transition-colors">Certification Exam</a>
      <a href="/verify" class="hover:text-[var(--text-primary)] transition-colors">Verify Certificate</a>
      <a href="/drills" class="hover:text-[var(--text-primary)] transition-colors">Adaptive Drills</a>
      <a href="/analytics" class="hover:text-[var(--text-primary)] transition-colors">Deep Analytics</a>
      <a href="https://fonts.topnepali.com" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--text-primary)] transition-colors">Nepali Fonts</a>
      <a href="https://github.com/iamgrisma/nepali-typing" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--text-primary)] transition-colors">GitHub</a>
    </div>

    <div class="text-[11px] text-center md:text-right">
      © {currentYear} <a href="https://typing.topnepali.com" class="hover:underline text-[var(--text-secondary)]">TopNepali Typing</a>. Hosted on Cloudflare Edge. All rights reserved.
    </div>

  </div>
</footer>
