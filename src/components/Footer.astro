---
// Footer Component
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-[var(--border-subtle)] bg-[var(--bg-surface)] py-8 text-xs text-[var(--text-muted)]">
  <div class="container flex flex-col sm:flex-row items-center justify-between gap-4">
    
    <div class="flex items-center gap-2">
      <span class="w-6 h-6 rounded-lg bg-red-600 text-white font-bold flex items-center justify-center text-xs" style="font-family: var(--font-nepali);">
        ने
      </span>
      <span class="font-display font-semibold text-[var(--text-primary)]">
        NepaliTyping.com
      </span>
      <span>• Elite Speed Benchmarking</span>
    </div>

    <div class="flex items-center gap-4 flex-wrap justify-center">
      <a href="#typing-workbench" class="hover:text-[var(--text-primary)] transition-colors">Typing Workbench</a>
      <a href="#keyboard-visualizer-container" class="hover:text-[var(--text-primary)] transition-colors">Keyboard Map</a>
      <a href="https://fonts.topnepali.com" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--text-primary)] transition-colors">Nepali Fonts</a>
      <a href="https://github.com/iamgrisma/nepali-typing" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--text-primary)] transition-colors">GitHub</a>
    </div>

    <div>
      © {currentYear} Nepali Typing Platform. Built with Astro SSR.
    </div>

  </div>
</footer>
