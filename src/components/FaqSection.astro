---
// FAQ Section with JSON-LD Schema for SEO Rich Results
const faqs = [
  {
    q: "प्रिती (Preeti) र नेपाली युनिकोड (Unicode) मा के भिन्नता छ?",
    a: "प्रिती एक पुरानो ASCII फन्ट हो, जहाँ अङ्ग्रेजी अक्षरका ठाउँमा नेपाली आकृतिहरू देखाइन्थ्यो। प्रितीमा टाइप गरिएको पाठ इन्टरनेटमा सर्च गर्न मिल्दैन र फन्ट नभएको कम्प्युटरमा बिग्रिएर देखिन्छ। नेपाली युनिकोड भने अन्तर्राष्ट्रिय UTF-8 मानकमा आधारित छ, जसले गर्दा संसारको जुनसुकै कम्प्युटर वा मोबाइलमा फन्ट इन्स्टल नगरीकनै पाठ शुद्ध रूपमा पढ्न, गुगलमा खोज्न र शेयर गर्न सकिन्छ।"
  },
  {
    q: "नेपाली रोमनाइज्ड (Romanized) टाइपिङ कसरी गर्ने?",
    a: "रोमनाइज्ड लेआउटमा अङ्ग्रेजी उच्चारण (Phonetic) अनुसार टाइप गर्न सकिन्छ। जस्तै: 'k' थिच्दा 'क', 'kh' वा 'K' थिच्दा 'ख', 'g' थिच्दा 'ग', र 'm' थिच्दा 'म' आउँछ। यसले गर्दा अङ्ग्रेजी किबोर्डमा बानी परेकाहरूलाई नेपाली टाइप गर्न निकै सहज हुन्छ।"
  },
  {
    q: "प्रितीमा ह्रस्व इकार (ि) कसरी टाइप गर्ने?",
    a: "प्रिती फन्टमा ह्रस्व इकार (ि) व्यञ्जन वर्णभन्दा अगाडि टाइप गर्नुपर्छ। यसका लागि पहिले 'l' थिचेर त्यसपछि व्यञ्जन वर्ण थिच्नुपर्छ (जस्तै: l + s = कि)।"
  },
  {
    q: "के यो टाइपिङ प्लेटफर्म चलाउन कुनै फन्ट डाउनलोड गर्नुपर्छ?",
    a: "पर्दैन! हाम्रो प्लेटफर्मले क्लाउड तथा स्थानीय क्यासबाट प्रिती र कोकिला फन्टहरू स्वतः लोड गर्छ। तपाईंले कुनै सफ्टवेयर वा फन्ट इन्स्टल नगरी सोझै ब्राउजरबाट अभ्यास गर्न सक्नुहुन्छ।"
  },
  {
    q: "टाइपिङ स्पिड (WPM) राम्रो मानिने गति कति हो?",
    a: "सामान्यतया दैनिक काम र कार्यालयका लागि ३० देखि ४० WPM (शब्द प्रति मिनेट) को गति राम्रो मानिन्छ। निरन्तर अभ्यास गर्ने व्यावसायिक टाइपिस्टहरूले ५०+ WPM सम्म सजिलै हासिल गर्न सक्छन्।"
  }
];
---

<section class="mt-12 mb-16">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-xl sm:text-2xl font-bold font-display text-[var(--text-primary)] mb-6 text-center">
      प्रायः सोधिने प्रश्नहरू (FAQs)
    </h2>

    <div class="space-y-4">
      {faqs.map((faq) => (
        <details class="bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-xl p-4 group transition-colors">
          <summary class="font-semibold text-sm text-[var(--text-primary)] cursor-pointer list-none flex items-center justify-between">
            <span>{faq.q}</span>
            <span class="text-xs text-[var(--text-muted)] group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-xs leading-relaxed text-[var(--text-secondary)] border-t border-[var(--border-subtle)] pt-3">
            {faq.a}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- JSON-LD Structured Data for FAQPage -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
})} />
