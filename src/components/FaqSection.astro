---
// FAQ Section with JSON-LD Schema for SEO Rich Results
const faqs = [
  {
    q: "What is the passing typing speed for Loksewa Aayog computer tests in Nepal?",
    a: "For Nepali typing in Loksewa Aayog (Public Service Commission), candidates are generally required to achieve a minimum speed of 20 Net Words Per Minute (WPM) with at least 85% to 90% accuracy in a 5-minute timed test. For English typing, the pass requirement is 25 Net WPM."
  },
  {
    q: "What is the difference between Preeti and Nepali Unicode?",
    a: "Preeti is a legacy ASCII-mapped font developed in the 1990s where Latin letters are visually swapped with Devanagari shapes. Texts typed in Preeti appear as gibberish on systems without the font and cannot be searched online. Nepali Unicode (Traditional & Romanized) is based on the universal UTF-8 standard, making the text universally readable, searchable on Google, and shareable across all modern devices and operating systems."
  },
  {
    q: "How can I type Raswa Ikaar (ि) in Preeti?",
    a: "In Preeti typing, the Raswa Ikaar (ि) is typed BEFORE the consonant by pressing the 'l' key. For example, to type 'कि', you must type 'l' followed by 's'."
  },
  {
    q: "Do I need to install any software or font to use this typing platform?",
    a: "No! All fonts (including authentic Preeti and Kokila Devanagari) are loaded dynamically through our edge font CDN and local cache. The platform works directly in your web browser on mobile phones, tablets, and desktop computers."
  },
  {
    q: "Can I practice for government banking exams on this site?",
    a: "Yes! Our dataset includes official administrative, financial, and legal terminology tailored specifically for banking examinations (Nepal Rastra Bank, Rastriya Banijya Bank, Agricultural Development Bank) as well as Loksewa Aayog."
  }
];
---

<section class="mt-12 mb-16">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-xl sm:text-2xl font-bold font-display text-[var(--text-primary)] mb-6 text-center">
      Frequently Asked Questions (FAQs)
    </h2>

    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <details class="bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-xl p-4 group transition-colors">
          <summary class="font-semibold text-sm text-[var(--text-primary)] cursor-pointer list-none flex items-center justify-between">
            <span>{faq.q}</span>
            <span class="text-xs text-[var(--text-muted)] group-open:rotate-180 transition-transform">▼</span>
          </summary>
          <p class="mt-3 text-xs leading-relaxed text-[var(--text-secondary)] border-t border-[var(--border-subtle)] pt-3">
            {faq.a}
          </p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- JSON-LD Structured Data for FAQPage -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.a
    }
  }))
})} />
