---
// ModeSelector toolbar for picking Language, Mode, Duration, Difficulty, Exam, Adaptive & Free Style
---

<div class="w-full bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-2xl p-2.5 sm:p-3 shadow-sm mb-3">
  <div class="flex flex-wrap items-center justify-between gap-2.5">
    
    <!-- Group 1: Language / Layout Selection -->
    <div id="lang-selector-group" class="flex items-center gap-1 p-1 bg-[var(--bg-surface-subtle)] rounded-xl overflow-x-auto max-w-full">
      <button 
        type="button"
        class="lang-tab-btn active px-3 py-1.5 text-xs font-semibold rounded-lg transition-all duration-150 bg-[var(--bg-surface)] text-[var(--accent-primary)] shadow-sm"
        data-lang="nepali_unicode"
      >
        Nepali Traditional
      </button>

      <button 
        type="button"
        class="lang-tab-btn px-3 py-1.5 text-xs font-semibold rounded-lg transition-all duration-150 text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
        data-lang="nepali_romanized"
      >
        Nepali Romanized
      </button>

      <button 
        type="button"
        class="lang-tab-btn px-3 py-1.5 text-xs font-semibold rounded-lg transition-all duration-150 text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
        data-lang="nepali_preeti"
      >
        Preeti (ASCII)
      </button>

      <button 
        type="button"
        class="lang-tab-btn px-3 py-1.5 text-xs font-semibold rounded-lg transition-all duration-150 text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
        data-lang="english"
      >
        English QWERTY
      </button>
    </div>

    <!-- Group 2: Mode & Content Types -->
    <div class="flex items-center gap-2 flex-wrap">
      <!-- Content Mode (Time / Words / Sentences / Quotes / Exam / Adaptive / Free Style) -->
      <div class="flex items-center gap-1 p-1 bg-[var(--bg-surface-subtle)] rounded-xl text-xs flex-wrap">
        <button type="button" class="mode-tab-btn active px-2.5 py-1 rounded-lg font-medium text-[var(--accent-blue)] bg-[var(--bg-surface)]" data-mode="time">
          Time
        </button>
        <button type="button" class="mode-tab-btn px-2.5 py-1 rounded-lg font-medium text-[var(--text-muted)] hover:text-[var(--text-primary)]" data-mode="words">
          Words
        </button>
        <button type="button" class="mode-tab-btn px-2.5 py-1 rounded-lg font-medium text-[var(--text-muted)] hover:text-[var(--text-primary)]" data-mode="sentences">
          Sentences
        </button>
        <button type="button" class="mode-tab-btn px-2.5 py-1 rounded-lg font-medium text-[var(--text-muted)] hover:text-[var(--text-primary)]" data-mode="quotes">
          Prose
        </button>
        <button type="button" class="mode-tab-btn px-2.5 py-1 rounded-lg font-medium text-purple-600 dark:text-purple-400 hover:text-[var(--text-primary)] flex items-center gap-1" data-mode="exam">
          <span>🎓</span>
          <span>Exam Test</span>
        </button>
        <button type="button" class="mode-tab-btn px-2.5 py-1 rounded-lg font-medium text-amber-500 hover:text-[var(--text-primary)] flex items-center gap-1" data-mode="adaptive">
          <span>⚡</span>
          <span>Adaptive Drill</span>
        </button>
        <button type="button" class="mode-tab-btn px-2.5 py-1 rounded-lg font-medium text-teal-500 hover:text-[var(--text-primary)] flex items-center gap-1" data-mode="freestyle">
          <span>✍️</span>
          <span>Free Style</span>
        </button>
      </div>

      <!-- Time Duration Options (Shown when mode == 'time') -->
      <div id="time-options" class="flex items-center gap-1 p-1 bg-[var(--bg-surface-subtle)] rounded-xl text-xs">
        <button type="button" class="time-btn px-2 py-1 rounded-lg font-mono text-[var(--text-muted)] hover:text-[var(--text-primary)]" data-seconds="15">15s</button>
        <button type="button" class="time-btn px-2 py-1 rounded-lg font-mono text-[var(--text-muted)] hover:text-[var(--text-primary)]" data-seconds="30">30s</button>
        <button type="button" class="time-btn active px-2 py-1 rounded-lg font-mono font-bold text-[var(--accent-primary)] bg-[var(--bg-surface)]" data-seconds="60">60s</button>
        <button type="button" class="time-btn px-2 py-1 rounded-lg font-mono text-[var(--text-muted)] hover:text-[var(--text-primary)]" data-seconds="120">120s</button>
      </div>

      <!-- Word Count Options (Shown when mode == 'words') -->
      <div id="words-options" class="hidden flex items-center gap-1 p-1 bg-[var(--bg-surface-subtle)] rounded-xl text-xs">
        <button type="button" class="word-count-btn px-2 py-1 rounded-lg font-mono text-[var(--text-muted)] hover:text-[var(--text-primary)]" data-words="10">10</button>
        <button type="button" class="word-count-btn active px-2 py-1 rounded-lg font-mono font-bold text-[var(--accent-primary)] bg-[var(--bg-surface)]" data-words="25">25</button>
        <button type="button" class="word-count-btn px-2 py-1 rounded-lg font-mono text-[var(--text-muted)] hover:text-[var(--text-primary)]" data-words="50">50</button>
        <button type="button" class="word-count-btn px-2 py-1 rounded-lg font-mono text-[var(--text-muted)] hover:text-[var(--text-primary)]" data-words="100">100</button>
      </div>

      <!-- Exam Duration Options (Shown when mode == 'exam') -->
      <div id="exam-options" class="hidden flex items-center gap-1 p-1 bg-[var(--bg-surface-subtle)] rounded-xl text-xs">
        <button type="button" class="exam-btn active px-2.5 py-1 rounded-lg font-mono font-bold text-purple-600 bg-[var(--bg-surface)]" data-mode-type="full">Full UN Speech</button>
        <button type="button" class="exam-btn px-2.5 py-1 rounded-lg font-mono text-[var(--text-muted)] hover:text-[var(--text-primary)]" data-mode-type="5m" data-seconds="300">5 Min (Official)</button>
        <button type="button" class="exam-btn px-2.5 py-1 rounded-lg font-mono text-[var(--text-muted)] hover:text-[var(--text-primary)]" data-mode-type="10m" data-seconds="600">10 Min</button>
      </div>

      <!-- Adaptive Mode Indicators (Shown when mode == 'adaptive') -->
      <div id="adaptive-options" class="hidden flex items-center gap-1 p-1 bg-[var(--bg-surface-subtle)] rounded-xl text-xs">
        <span class="text-[11px] text-amber-500 font-medium px-2 py-0.5">Target Weak Strokes:</span>
        <span id="adaptive-target-tags" class="font-mono font-bold text-amber-500 bg-[var(--bg-surface)] px-2 py-0.5 rounded-lg border border-amber-500/30">Auto-Detecting...</span>
      </div>

      <!-- Free Style Info Pill (Shown when mode == 'freestyle') -->
      <div id="freestyle-options" class="hidden flex items-center gap-1 p-1 bg-[var(--bg-surface-subtle)] rounded-xl text-xs">
        <span class="text-[11px] text-teal-500 font-medium px-2 py-0.5">Free Thought Practice • Speed Benchmark</span>
      </div>

      <!-- Difficulty Level Selection -->
      <div id="diff-options" class="flex items-center gap-1 p-1 bg-[var(--bg-surface-subtle)] rounded-xl text-xs">
        <button type="button" class="diff-btn px-2.5 py-1 rounded-lg font-medium text-[var(--text-muted)] hover:text-[var(--text-primary)]" data-diff="easy">Easy</button>
        <button type="button" class="diff-btn active px-2.5 py-1 rounded-lg font-medium font-bold text-amber-500 bg-[var(--bg-surface)]" data-diff="medium">Medium</button>
        <button type="button" class="diff-btn px-2.5 py-1 rounded-lg font-medium text-[var(--text-muted)] hover:text-[var(--text-primary)]" data-diff="hard">Hard</button>
      </div>

      <!-- Toggle Virtual Keyboard Button -->
      <button 
        type="button" 
        id="toggle-keyboard-btn" 
        class="flex items-center gap-1 px-2.5 py-1.5 text-xs font-medium rounded-xl border border-[var(--border-subtle)] text-[var(--text-secondary)] hover:bg-[var(--bg-surface-subtle)] hover:text-[var(--text-primary)] transition-colors"
        title="Toggle Visual Hardware Keyboard Reference"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="2" ry="2"></rect>
          <line x1="6" y1="8" x2="6.01" y2="8"></line>
          <line x1="10" y1="8" x2="10.01" y2="8"></line>
          <line x1="14" y1="8" x2="14.01" y2="8"></line>
          <line x1="18" y1="8" x2="18.01" y2="8"></line>
          <line x1="6" y1="12" x2="6.01" y2="12"></line>
          <line x1="18" y1="12" x2="18.01" y2="12"></line>
          <line x1="7" y1="16" x2="17" y2="16"></line>
        </svg>
        <span id="toggle-keyboard-text">Hide Keys</span>
      </button>

    </div>
  </div>
</div>
