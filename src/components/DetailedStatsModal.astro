---
// Detailed Statistics Modal (Monkeytype / Loksewa grade result report)
---

<div id="stats-modal" class="modal-backdrop">
  <div class="modal-content p-6 sm:p-8">
    
    <!-- Modal Header -->
    <div class="flex items-center justify-between pb-4 border-b border-[var(--border-subtle)]">
      <div>
        <div class="flex items-center gap-2">
          <h2 class="text-xl sm:text-2xl font-bold font-display text-[var(--text-primary)]">
            Test Results
          </h2>
          <span id="modal-loksewa-pill" class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
            Passed
          </span>
        </div>
        <p class="text-xs text-[var(--text-muted)] mt-0.5" id="modal-test-metadata">
          Nepali Traditional • 60 Seconds • Medium Difficulty
        </p>
      </div>

      <button 
        type="button" 
        id="close-modal-btn" 
        class="p-2 rounded-xl text-[var(--text-secondary)] hover:bg-[var(--bg-surface-subtle)] hover:text-[var(--text-primary)] transition-colors"
        aria-label="Close"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Main Highlight Numbers -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 my-6">
      <!-- Net WPM -->
      <div class="bg-[var(--bg-surface-subtle)] p-4 rounded-2xl border border-[var(--border-subtle)]">
        <span class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider">Net WPM</span>
        <div class="text-3xl sm:text-4xl font-extrabold font-display text-[var(--accent-primary)] mt-1" id="modal-net-wpm">
          0
        </div>
        <span class="text-[11px] text-[var(--text-muted)]">Words / Min</span>
      </div>

      <!-- Accuracy -->
      <div class="bg-[var(--bg-surface-subtle)] p-4 rounded-2xl border border-[var(--border-subtle)]">
        <span class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider">Accuracy</span>
        <div class="text-3xl sm:text-4xl font-extrabold font-display text-emerald-500 mt-1" id="modal-accuracy">
          100%
        </div>
        <span class="text-[11px] text-[var(--text-muted)]" id="modal-acc-detail">0 errors</span>
      </div>

      <!-- Raw WPM -->
      <div class="bg-[var(--bg-surface-subtle)] p-4 rounded-2xl border border-[var(--border-subtle)]">
        <span class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider">Raw WPM</span>
        <div class="text-3xl sm:text-4xl font-extrabold font-display text-[var(--text-primary)] mt-1" id="modal-raw-wpm">
          0
        </div>
        <span class="text-[11px] text-[var(--text-muted)]">Gross Speed</span>
      </div>

      <!-- Consistency -->
      <div class="bg-[var(--bg-surface-subtle)] p-4 rounded-2xl border border-[var(--border-subtle)]">
        <span class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider">Consistency</span>
        <div class="text-3xl sm:text-4xl font-extrabold font-display text-blue-500 mt-1" id="modal-consistency">
          95%
        </div>
        <span class="text-[11px] text-[var(--text-muted)]">Rhythm Stability</span>
      </div>
    </div>

    <!-- Timeline Chart (SVG Line Graph) -->
    <div class="mb-6">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-semibold text-[var(--text-secondary)]">Speed & Rhythm Timeline</span>
        <div class="flex items-center gap-3 text-[11px] text-[var(--text-muted)]">
          <span class="flex items-center gap-1"><span class="w-2.5 h-0.5 bg-[var(--accent-primary)] inline-block"></span> Net WPM</span>
          <span class="flex items-center gap-1"><span class="w-2.5 h-0.5 bg-blue-400 inline-block"></span> Raw WPM</span>
          <span class="flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-red-500 inline-block"></span> Error</span>
        </div>
      </div>
      
      <div class="h-44 w-full bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)] rounded-xl p-3 flex items-center justify-center">
        <svg id="timeline-chart-svg" class="w-full h-full overflow-visible" viewBox="0 0 500 120" preserveAspectRatio="none">
          <!-- Dynamically generated SVG lines and markers -->
        </svg>
      </div>
    </div>

    <!-- Detailed Matrix Grid (CPM, Keystrokes, Loksewa Grade) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
      <!-- Loksewa Evaluation Box -->
      <div class="p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface-subtle)]">
        <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--text-muted)] mb-2 flex items-center gap-1.5">
          <span>🏛️</span> लोकसेवा आयोग मूल्याङ्कन (Evaluation)
        </h3>
        <div class="space-y-1.5 text-xs text-[var(--text-secondary)]">
          <div class="flex justify-between">
            <span>Minimum Pass Criteria:</span>
            <span class="font-bold text-[var(--text-primary)]">20 WPM (90% Acc)</span>
          </div>
          <div class="flex justify-between">
            <span>Your Grade:</span>
            <span class="font-bold text-emerald-600 dark:text-emerald-400" id="loksewa-grade-label">Distinction</span>
          </div>
          <div class="flex justify-between">
            <span>Marks Awarded:</span>
            <span class="font-bold text-[var(--text-primary)]" id="loksewa-marks-label">25 / 25</span>
          </div>
        </div>
      </div>

      <!-- Keystroke Details & Error Heatmap -->
      <div class="p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface-subtle)]">
        <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--text-muted)] mb-2 flex items-center gap-1.5">
          <span>⌨️</span> Keystrokes Breakdown
        </h3>
        <div class="space-y-1.5 text-xs text-[var(--text-secondary)]">
          <div class="flex justify-between">
            <span>Characters Per Minute (CPM):</span>
            <span class="font-bold text-[var(--text-primary)]" id="modal-cpm">0 CPM</span>
          </div>
          <div class="flex justify-between">
            <span>Correct / Error Strokes:</span>
            <span class="font-bold text-[var(--text-primary)]"><span id="modal-strokes-correct" class="text-emerald-500">0</span> / <span id="modal-strokes-error" class="text-red-500">0</span></span>
          </div>
          <div class="flex justify-between items-center">
            <span>Most Missed Keys:</span>
            <span class="font-bold font-mono text-[var(--accent-primary)]" id="modal-missed-keys">-</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Actions & Share Buttons -->
    <div class="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-[var(--border-subtle)]">
      <div class="text-xs text-[var(--text-muted)] flex items-center gap-2">
        <kbd class="px-2 py-0.5 rounded bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)] font-mono text-[10px]">Tab</kbd> + <kbd class="px-2 py-0.5 rounded bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)] font-mono text-[10px]">Enter</kbd> to restart
      </div>

      <div class="flex items-center gap-2">
        <button 
          type="button" 
          id="copy-result-btn" 
          class="btn btn-secondary text-xs"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          <span id="copy-result-text">Copy Summary</span>
        </button>

        <button 
          type="button" 
          id="restart-from-modal-btn" 
          class="btn btn-primary text-xs"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M8 16H3v5"></path></svg>
          <span>Next Test</span>
        </button>
      </div>
    </div>

  </div>
</div>
