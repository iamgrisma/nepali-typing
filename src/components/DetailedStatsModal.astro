---
// Detailed Statistics Modal — Monkeytype-Grade Performance Report with Two-Level Accuracy & Word Breakdown
---

<div id="stats-modal" class="modal-backdrop">
  <div class="modal-content p-6 sm:p-8">
    
    <!-- Modal Header -->
    <div class="flex items-center justify-between pb-4 border-b border-[var(--border-subtle)]">
      <div>
        <div class="flex items-center gap-2">
          <h2 class="text-xl sm:text-2xl font-bold font-display text-[var(--text-primary)]">
            Test Performance Report
          </h2>
          <span id="modal-rank-pill" class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20">
            ⚡ Master Typist
          </span>
        </div>
        <p class="text-xs text-[var(--text-muted)] mt-0.5" id="modal-test-metadata">
          Nepali Traditional • 60 Seconds • Medium Difficulty
        </p>
      </div>

      <button 
        type="button" 
        id="close-modal-btn" 
        class="p-2 rounded-xl text-[var(--text-secondary)] hover:bg-[var(--bg-surface-subtle)] hover:text-[var(--text-primary)] transition-colors cursor-pointer"
        aria-label="Close"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Official Certification Qualification Banner -->
    <div id="modal-cert-banner" class="hidden my-4 p-4 rounded-2xl bg-gradient-to-r from-emerald-500/15 via-teal-500/15 to-emerald-500/15 border border-emerald-500/30">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <div class="space-y-0.5">
          <div class="flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400 font-bold text-sm">
            <span>🏆</span>
            <span id="modal-cert-status-title">Certified Benchmark Achieved!</span>
          </div>
          <p class="text-xs text-[var(--text-secondary)]" id="modal-cert-status-desc">
            Your typing speed qualifies for an Official Verifiable Certificate of Typing Proficiency.
          </p>
        </div>

        <div class="flex items-center gap-2 w-full sm:w-auto">
          <input 
            type="text" 
            id="modal-candidate-name-input" 
            placeholder="Enter Your Full Name" 
            class="px-3 py-1.5 text-xs rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] text-[var(--text-primary)] focus:outline-none focus:border-emerald-500 w-full sm:w-48"
          />
          <button 
            type="button" 
            id="modal-claim-cert-btn" 
            class="px-4 py-1.5 text-xs font-bold rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm transition-colors whitespace-nowrap flex items-center gap-1.5 cursor-pointer"
          >
            <span>Claim Certificate</span>
            <span>→</span>
          </button>
        </div>
      </div>
    </div>

    <!-- MAIN HIGHLIGHT METRICS (Big Monkeytype Style Numbers) -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 my-4">
      
      <!-- Net WPM -->
      <div class="bg-[var(--bg-surface-subtle)] p-4 rounded-2xl border border-[var(--border-subtle)]">
        <span class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider">Net Speed</span>
        <div class="text-3xl sm:text-4xl font-extrabold font-display text-[var(--accent-primary)] mt-1" id="modal-net-wpm">
          0
        </div>
        <span class="text-[11px] text-[var(--text-muted)]">Words / Min (WPM)</span>
      </div>

      <!-- TWO-LEVEL ACCURACY CARD -->
      <div class="bg-[var(--bg-surface-subtle)] p-4 rounded-2xl border border-[var(--border-subtle)]">
        <span class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider">Accuracy</span>
        <div class="flex items-baseline gap-2 mt-1">
          <div class="text-3xl sm:text-4xl font-extrabold font-display text-emerald-500" id="modal-word-accuracy">
            100%
          </div>
          <span class="text-[10px] font-bold uppercase text-emerald-600 dark:text-emerald-400">Word</span>
        </div>
        <div class="flex items-center justify-between text-[11px] text-[var(--text-muted)] mt-0.5">
          <span>Stroke Acc: <b id="modal-stroke-accuracy" class="text-blue-500 font-bold">96.5%</b></span>
          <span>•</span>
          <span id="modal-corrected-words-count" class="text-amber-500">2 fixed</span>
        </div>
      </div>

      <!-- Raw WPM -->
      <div class="bg-[var(--bg-surface-subtle)] p-4 rounded-2xl border border-[var(--border-subtle)]">
        <span class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider">Gross Speed</span>
        <div class="text-3xl sm:text-4xl font-extrabold font-display text-[var(--text-primary)] mt-1" id="modal-raw-wpm">
          0
        </div>
        <span class="text-[11px] text-[var(--text-muted)]" id="modal-cpm-label">0 CPM</span>
      </div>

      <!-- Consistency -->
      <div class="bg-[var(--bg-surface-subtle)] p-4 rounded-2xl border border-[var(--border-subtle)]">
        <span class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider">Rhythm</span>
        <div class="text-3xl sm:text-4xl font-extrabold font-display text-blue-500 mt-1" id="modal-consistency">
          95%
        </div>
        <span class="text-[11px] text-[var(--text-muted)]">Consistency Score</span>
      </div>

    </div>

    <!-- Velocity Timeline Chart (SVG Line Graph) -->
    <div class="mb-4">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs font-semibold text-[var(--text-secondary)]">Velocity & Keystroke Pace Timeline</span>
        <div class="flex items-center gap-3 text-[11px] text-[var(--text-muted)]">
          <span class="flex items-center gap-1"><span class="w-2.5 h-0.5 bg-[var(--accent-primary)] inline-block"></span> Net WPM</span>
          <span class="flex items-center gap-1"><span class="w-2.5 h-0.5 bg-blue-400 inline-block"></span> Raw WPM</span>
          <span class="flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-red-500 inline-block"></span> Error Stroke</span>
        </div>
      </div>
      
      <div class="h-36 w-full bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)] rounded-xl p-3 flex items-center justify-center">
        <svg id="timeline-chart-svg" class="w-full h-full overflow-visible" viewBox="0 0 500 120" preserveAspectRatio="none">
          <!-- Dynamically generated SVG lines and markers -->
        </svg>
      </div>
    </div>

    <!-- BIOMECHANIC & STROKE ANALYTICS GRID -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-4">
      
      <!-- Card 1: Ergonomic Hand Workload & Error Bias -->
      <div class="p-3.5 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface-subtle)]">
        <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--text-muted)] mb-2.5 flex items-center justify-between">
          <span class="flex items-center gap-1"><span>✋</span> Hand Ergonomics</span>
          <span class="font-mono text-[10px] text-blue-500" id="analytics-hand-bias">52% L / 48% R</span>
        </h3>
        <div class="space-y-2 text-xs">
          <div class="w-full bg-[var(--bg-surface)] h-2 rounded-full overflow-hidden flex border border-[var(--border-subtle)]">
            <div id="analytics-left-bar" class="bg-blue-500 h-full" style="width: 52%;"></div>
            <div id="analytics-right-bar" class="bg-teal-500 h-full" style="width: 48%;"></div>
          </div>
          <div class="flex justify-between text-[11px] text-[var(--text-secondary)]">
            <span>Left Hand Err: <b id="analytics-left-err" class="text-red-500">1.2%</b></span>
            <span>Right Hand Err: <b id="analytics-right-err" class="text-red-500">1.0%</b></span>
          </div>
          <div class="flex justify-between text-[11px] text-[var(--text-muted)] border-t border-[var(--border-subtle)] pt-1.5">
            <span>Row Distribution:</span>
            <span class="font-mono text-[var(--text-primary)]" id="analytics-row-dist">H: 45% • T: 38%</span>
          </div>
        </div>
      </div>

      <!-- Card 2: Keystroke Latency & Hesitation Hotspots -->
      <div class="p-3.5 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface-subtle)]">
        <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--text-muted)] mb-2.5 flex items-center justify-between">
          <span class="flex items-center gap-1"><span>⏱️</span> Stroke Latency</span>
          <span class="font-mono text-[10px] text-amber-500" id="analytics-avg-latency">210 ms avg</span>
        </h3>
        <div class="space-y-1.5 text-xs text-[var(--text-secondary)]">
          <div class="flex justify-between items-center">
            <span>Slowest Keys (Hesitations):</span>
            <span class="font-mono font-bold text-red-500" id="analytics-slowest-keys">W (380ms), O (340ms)</span>
          </div>
          <div class="flex justify-between items-center">
            <span>Fastest Reflex Keys:</span>
            <span class="font-mono font-bold text-emerald-500" id="analytics-fastest-keys">Space, E, A</span>
          </div>
          <div class="flex justify-between text-[11px] text-[var(--text-muted)] border-t border-[var(--border-subtle)] pt-1.5">
            <span>Hesitation Pauses (&gt;400ms):</span>
            <span class="font-mono text-[var(--text-primary)]" id="analytics-hesitation-count">4 pauses</span>
          </div>
        </div>
      </div>

      <!-- Card 3: Correction Penalty & Flow State -->
      <div class="p-3.5 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface-subtle)]">
        <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--text-muted)] mb-2.5 flex items-center justify-between">
          <span class="flex items-center gap-1"><span>⚡</span> Flow & Recovery</span>
          <span class="font-mono text-[10px] text-purple-500" id="analytics-peak-burst">68 WPM burst</span>
        </h3>
        <div class="space-y-1.5 text-xs text-[var(--text-secondary)]">
          <div class="flex justify-between">
            <span>Clean Streak Record:</span>
            <span class="font-bold text-emerald-500" id="analytics-clean-streak">84 chars</span>
          </div>
          <div class="flex justify-between">
            <span>Time Lost to Backspace:</span>
            <span class="font-mono font-bold text-amber-500" id="analytics-time-lost">2.4 sec lost</span>
          </div>
          <div class="flex justify-between text-[11px] text-[var(--text-muted)] border-t border-[var(--border-subtle)] pt-1.5">
            <span>Strokes (Corr / Err):</span>
            <span class="font-mono text-[var(--text-primary)]" id="analytics-stroke-ratio">340 / 6</span>
          </div>
        </div>
      </div>

    </div>

    <!-- WORD-BY-WORD PERFORMANCE BREAKDOWN ACCORDION -->
    <details class="p-3.5 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface-subtle)] mb-4 group">
      <summary class="font-bold text-xs text-[var(--text-primary)] cursor-pointer list-none flex items-center justify-between">
        <span class="flex items-center gap-1.5">
          <span>🔍</span>
          <span>Word-by-Word Typing Log & Correction Audit</span>
        </span>
        <span class="text-xs text-[var(--text-muted)] group-open:rotate-180 transition-transform">▼</span>
      </summary>
      <div class="mt-3 pt-3 border-t border-[var(--border-subtle)] max-h-48 overflow-y-auto">
        <table class="w-full text-left text-xs">
          <thead class="text-[10px] font-semibold uppercase text-[var(--text-muted)] border-b border-[var(--border-subtle)]">
            <tr>
              <th class="py-1.5 pr-2">#</th>
              <th class="py-1.5 pr-3">Target Word</th>
              <th class="py-1.5 pr-3">Typed Word</th>
              <th class="py-1.5 pr-3">Status</th>
              <th class="py-1.5 pr-3">Strokes</th>
              <th class="py-1.5">Time</th>
            </tr>
          </thead>
          <tbody id="modal-words-log-tbody" class="divide-y divide-[var(--border-subtle)] font-mono">
            <!-- Dynamically populated word log entries -->
          </tbody>
        </table>
      </div>
    </details>

    <!-- SMART ADAPTIVE DRILL CALLOUT -->
    <div id="modal-adaptive-callout" class="p-3.5 rounded-xl border border-amber-500/30 bg-amber-500/10 mb-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
      <div class="space-y-0.5">
        <div class="flex items-center gap-1.5 text-amber-600 dark:text-amber-400 font-bold text-xs">
          <span>🎯</span>
          <span>Adaptive Stroke Drill Recommendation</span>
        </div>
        <p class="text-[11px] text-[var(--text-secondary)]">
          High error/latency detected on keys: <span id="modal-adaptive-keys-label" class="font-mono font-bold text-[var(--text-primary)]">[W, O]</span>. Practice high-density drills to rebuild muscle memory.
        </p>
      </div>

      <button 
        type="button" 
        id="modal-launch-drill-btn" 
        class="px-3 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-600 text-white font-semibold text-xs whitespace-nowrap transition-colors flex items-center gap-1 cursor-pointer"
      >
        <span>⚡ Start Adaptive Drill</span>
      </button>
    </div>

    <!-- Actions & Footer -->
    <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-[var(--border-subtle)]">
      <div class="text-xs text-[var(--text-muted)] flex items-center gap-2">
        <kbd>Tab</kbd> + <kbd>Enter</kbd> to restart
      </div>

      <div class="flex items-center gap-2">
        <button 
          type="button" 
          id="copy-result-btn" 
          class="btn btn-secondary text-xs cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          <span id="copy-result-text">Copy Summary</span>
        </button>

        <button 
          type="button" 
          id="restart-from-modal-btn" 
          class="btn btn-primary text-xs cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M8 16H3v5"></path></svg>
          <span>Next Test</span>
        </button>
      </div>
    </div>

  </div>
</div>
