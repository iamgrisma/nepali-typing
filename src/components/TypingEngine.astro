---
// TypingEngine Component
// Displays text stream, active word highlight, caret, real-time input box, and live counters
const initialWords = [
  'नेपाल', 'प्रकृतिको', 'अनुपम', 'वरदान', 'पाएको', 'एउटा', 'सुन्दर', 'र', 'शान्त', 'देश', 'हो।',
  'बिहानको', 'एक', 'कप', 'तातो', 'चियाले', 'मन', 'नै', 'प्रफुल्ल', 'बनाउँछ।',
  'साथीभाइसँग', 'बसेर', 'गफगाफ', 'गर्नुको', 'मज्जा', 'नै', 'बेग्लै', 'हुन्छ।'
];
---

<div class="w-full relative mb-6">
  
  <!-- Live Status Floating Header (Timer / Live WPM / Accuracy) -->
  <div class="flex items-center justify-between px-2 mb-3 text-sm font-mono">
    <!-- Left: Time / Word Progress -->
    <div class="flex items-center gap-3">
      <div class="flex items-center gap-1.5 text-[var(--accent-primary)] font-bold text-lg">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        <span id="live-timer-display">60</span>
      </div>
      <div class="text-xs text-[var(--text-muted)]" id="live-progress-display">0 / 25 words</div>
    </div>

    <!-- Right: Live Instantaneous WPM and Accuracy -->
    <div class="flex items-center gap-4 text-xs font-semibold">
      <div class="text-[var(--text-muted)]">
        Live WPM: <span id="live-wpm-display" class="font-bold text-[var(--text-primary)] text-sm">0</span>
      </div>
      <div class="text-[var(--text-muted)]">
        Acc: <span id="live-acc-display" class="font-bold text-emerald-500 text-sm">100%</span>
      </div>
    </div>
  </div>

  <!-- Main Typing Workbench Box -->
  <div id="typing-workbench" class="typing-box min-h-[160px] flex flex-col justify-center relative cursor-text" tabindex="0">
    <!-- Blinking / Sliding Caret -->
    <div id="typing-caret" class="typing-caret hidden"></div>

    <!-- Dynamic Words Stream Container (Rendered on Server initially so it's NEVER empty!) -->
    <div id="words-container" class="words-stream text-xl sm:text-2xl select-none font-medium">
      {initialWords.map((word, wIdx) => (
        <span class={`word-node ${wIdx === 0 ? 'is-active-word' : ''}`} data-word-index={wIdx}>
          <span class="char-node">{word}</span>
        </span>
      ))}
    </div>

    <!-- Click To Focus Overlay -->
    <div id="focus-overlay" class="absolute inset-0 bg-[var(--bg-surface)]/75 backdrop-blur-[2px] flex items-center justify-center rounded-2xl cursor-pointer z-20 opacity-0 pointer-events-none transition-opacity">
      <div class="flex items-center gap-2 px-4 py-2 rounded-xl bg-[var(--bg-surface-elevated)] border border-[var(--border-subtle)] shadow-md text-xs font-medium text-[var(--text-secondary)]">
        <svg class="w-4 h-4 text-[var(--accent-primary)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        <span>Click here to focus and type</span>
      </div>
    </div>
  </div>

  <!-- Real Interactive Typing Input Field (Captures all keystrokes, prevents space scrolling) -->
  <div class="mt-3">
    <div class="relative flex items-center">
      <input 
        type="text" 
        id="typing-input" 
        class="w-full bg-[var(--bg-surface)] border-2 border-[var(--border-subtle)] focus:border-[var(--accent-primary)] rounded-xl px-4 py-3 text-base sm:text-lg font-medium text-[var(--text-primary)] placeholder-[var(--text-muted)] outline-none shadow-sm transition-all"
        placeholder="यहाँ टाइप गर्नुहोस्... (Start typing here, press Space for next word)"
        autocomplete="off" 
        autocorrect="off" 
        autocapitalize="off" 
        spellcheck="false"
        autofocus
      />
      <div class="absolute right-3 flex items-center gap-1.5 text-xs text-[var(--text-muted)] pointer-events-none">
        <kbd class="px-1.5 py-0.5 rounded bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)] font-mono text-[10px]">Space</kbd>
        <span>next word</span>
      </div>
    </div>
  </div>

  <!-- Bottom Quick Controls (Restart Button & Short Hint) -->
  <div class="flex items-center justify-between px-2 mt-3 text-xs text-[var(--text-muted)]">
    <div class="flex items-center gap-1.5">
      <kbd class="px-1.5 py-0.5 rounded bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)] font-mono text-[10px]">Esc</kbd>
      <span>or</span>
      <kbd class="px-1.5 py-0.5 rounded bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)] font-mono text-[10px]">Tab</kbd>
      <span>to restart test</span>
    </div>

    <button 
      type="button" 
      id="manual-restart-btn" 
      class="p-1.5 rounded-lg hover:bg-[var(--bg-surface-subtle)] hover:text-[var(--text-primary)] transition-colors flex items-center gap-1 text-xs"
      title="Restart Current Test"
    >
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M8 16H3v5"></path></svg>
      <span>Restart</span>
    </button>
  </div>

</div>
