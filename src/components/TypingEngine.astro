---
// TypingEngine Component — Refined Minimalist Workbench with Free Style Support
const initialWords = [
  'नेपाल', 'प्रकृतिको', 'अनुपम', 'वरदान', 'पाएको', 'एउटा', 'सुन्दर', 'र', 'शान्त', 'देश', 'हो',
  'बिहानको', 'एक', 'कप', 'तातो', 'चियाले', 'मन', 'नै', 'प्रफुल्ल', 'बनाउँछ',
  'साथीभाइसँग', 'बसेर', 'गफगाफ', 'गर्नुको', 'मज्जा', 'नै', 'बेग्लै', 'हुन्छ'
];
---

<div class="w-full relative mb-3">
  
  <!-- Live Status Floating Header (Timer / Live WPM / Word & Stroke Accuracy / Restart) -->
  <div class="flex items-center justify-between px-2 mb-2 text-xs font-mono">
    
    <!-- Left: Time / Word Progress -->
    <div class="flex items-center gap-3">
      <div class="flex items-center gap-1.5 text-[var(--accent-primary)] font-bold text-sm sm:text-base">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        <span id="live-timer-display">60s</span>
      </div>
      <div class="text-[11px] text-[var(--text-muted)]" id="live-progress-display">0 / 25 words</div>
    </div>

    <!-- Right: Live WPM, Two-Level Accuracy & Restart -->
    <div class="flex items-center gap-2 sm:gap-3 font-semibold">
      <div class="text-[var(--text-muted)]">
        WPM: <span id="live-wpm-display" class="font-bold text-[var(--text-primary)] text-sm">0</span>
      </div>

      <!-- Two-Level Accuracy Badge: Word Acc vs Stroke Acc -->
      <div class="hidden sm:flex items-center gap-2 px-2 py-0.5 rounded-lg bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
        <span class="text-[10px] text-[var(--text-muted)]" title="Final word submission accuracy">
          Word: <b id="live-word-acc-display" class="text-emerald-500">100%</b>
        </span>
        <span class="text-[var(--border-strong)]">|</span>
        <span class="text-[10px] text-[var(--text-muted)]" title="Raw keystroke accuracy including backspaces">
          Stroke: <b id="live-stroke-acc-display" class="text-blue-500">100%</b>
        </span>
      </div>

      <!-- Mobile fallback accuracy pill -->
      <div class="sm:hidden text-[var(--text-muted)]">
        Acc: <span id="live-acc-display" class="font-bold text-emerald-500 text-sm">100%</span>
      </div>

      <button 
        type="button" 
        id="manual-restart-btn" 
        class="px-2 py-1 rounded-lg border border-[var(--border-subtle)] bg-[var(--bg-surface-subtle)] hover:bg-[var(--border-subtle)] hover:text-[var(--text-primary)] transition-colors flex items-center gap-1.5 text-xs text-[var(--text-muted)] cursor-pointer"
        title="Restart Current Test (Tab or Esc)"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M8 16H3v5"></path></svg>
        <span class="hidden sm:inline">Restart</span>
        <kbd class="px-1 py-0.2 rounded bg-[var(--bg-surface)] border border-[var(--border-subtle)] font-mono text-[9px]">Tab</kbd>
      </button>
    </div>
  </div>

  <!-- Standard Typing Workbench: 2-line streaming text box -->
  <div id="typing-workbench" class="typing-box h-[88px] min-h-[88px] max-h-[88px] p-3 flex flex-col justify-center relative cursor-text overflow-hidden" tabindex="0">
    <div id="words-container" class="words-stream h-[72px] max-h-[72px] text-xl sm:text-2xl leading-[36px] select-none font-medium overflow-hidden">
      <!-- Blinking / Sliding Caret -->
      <div id="typing-caret" class="typing-caret hidden"></div>

      {initialWords.map((word, wIdx) => (
        <span class={`word-node ${wIdx === 0 ? 'is-active-word' : ''}`} data-word-index={wIdx}>
          <span class="char-node">{word}</span>
        </span>
      ))}
    </div>

    <!-- Hidden native input to capture all keystrokes directly into workbench -->
    <input 
      type="text" 
      id="typing-input" 
      style="position: absolute; opacity: 0; pointer-events: none; width: 0; height: 0; padding: 0; margin: 0; border: none; outline: none; background: transparent; color: transparent; z-index: -1;"
      autocomplete="off" 
      autocorrect="off" 
      autocapitalize="off" 
      spellcheck="false"
      autofocus
    />
  </div>

  <!-- FREE STYLE TYPING WORKBENCH (Zen Mode) -->
  <div id="freestyle-workbench" class="hidden flex-col gap-2">
    <textarea 
      id="freestyle-input" 
      class="freestyle-canvas" 
      placeholder="Start typing anything freely in English... practice writing thoughts, journaling, or test your unrestricted raw typing speed without pre-determined text prompts."
      rows="4"
    ></textarea>

    <div class="flex items-center justify-between text-xs font-mono text-[var(--text-muted)] px-1">
      <div class="flex items-center gap-3">
        <span>Words: <b id="freestyle-word-count" class="text-[var(--text-primary)]">0</b></span>
        <span>Characters: <b id="freestyle-char-count" class="text-[var(--text-primary)]">0</b></span>
        <span>Burst: <b id="freestyle-burst-wpm" class="text-amber-500">0 WPM</b></span>
      </div>

      <button 
        type="button" 
        id="finish-freestyle-btn" 
        class="btn btn-primary text-xs py-1 px-3"
      >
        <span>Complete & View Stats</span>
        <span>→</span>
      </button>
    </div>
  </div>

</div>
