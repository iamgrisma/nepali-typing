---
// Typeshala Bench — Authoritative Platform Overview & Keyboard Architecture
import { Icon } from 'astro-icon/components';
---

<section class="mt-12 pt-8 border-t border-[var(--border-subtle)]">
  <div class="max-w-4xl mx-auto space-y-8 text-sm leading-relaxed text-[var(--text-secondary)]">

    <!-- 1. Platform Overview -->
    <div>
      <div class="flex items-center gap-2 mb-2 text-xs font-bold uppercase tracking-wider text-[var(--accent-primary)]">
        <Icon name="lucide:globe" class="w-4 h-4" />
        <span>Typeshala Bench • Online Typing Standard</span>
      </div>
      <h2 class="text-xl sm:text-2xl font-extrabold font-display text-[var(--text-primary)] mb-3 tracking-tight">
        Typeshala Bench: The Modern Online Nepali &amp; English Typing Benchmark
      </h2>
      <p class="mb-2 text-xs sm:text-sm">
        For decades across Nepal, touch typing was mastered on desktop <strong>Typeshala</strong>. With <strong>Typeshala online</strong> on <strong>Typeshala Bench</strong>, experience the modern web-native standard—built with zero installation, zero lag, and full support for all four core keyboard layouts: <strong>Nepali Unicode Traditional (MPP)</strong>, <strong>Nepali Unicode Romanized</strong>, <strong>Preeti (ASCII)</strong>, and <strong>English US QWERTY</strong>.
      </p>
      <p class="text-xs text-[var(--text-muted)]">
        Engineered for students, professionals, and public service candidates with authentic Nepali Dantya Katha stories, real-time WPM calculation, grapheme segmentation, and verifiable proficiency certificates.
      </p>
    </div>

    <!-- 2. Keyboard Topology Matrix -->
    <div class="bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-2xl p-5 shadow-sm">
      <h3 class="text-base font-bold font-display text-[var(--text-primary)] mb-1">
        Nepali &amp; English Keyboard Layouts Comparison
      </h3>
      <p class="text-xs text-[var(--text-muted)] mb-4">
        Key distinctions in character encoding, physical key mapping, and application domains:
      </p>

      <div class="overflow-x-auto">
        <table class="w-full text-xs text-left">
          <thead class="border-b border-[var(--border-subtle)] text-[var(--text-secondary)] font-semibold uppercase tracking-wider">
            <tr>
              <th class="py-2.5 pr-3">Dimension</th>
              <th class="py-2.5 pr-3">Nepali Unicode Traditional</th>
              <th class="py-2.5 pr-3">Nepali Unicode Romanized</th>
              <th class="py-2.5 pr-3">Preeti (ASCII)</th>
              <th class="py-2.5">English US QWERTY</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--border-subtle)]">
            <tr>
              <td class="py-2.5 font-semibold text-[var(--text-primary)]">Encoding Protocol</td>
              <td class="py-2.5">UTF-8 Devanagari (U+0900–097F)</td>
              <td class="py-2.5">UTF-8 Devanagari (U+0900–097F)</td>
              <td class="py-2.5 text-amber-500 font-medium">Legacy ASCII Glyph Map</td>
              <td class="py-2.5">Standard ASCII / UTF-8 Latin</td>
            </tr>
            <tr>
              <td class="py-2.5 font-semibold text-[var(--text-primary)]">Layout Topology</td>
              <td class="py-2.5">Remington Mechanical Standard (MPP)</td>
              <td class="py-2.5">Phonetic English Transliteration</td>
              <td class="py-2.5">Traditional Typewriter Keymap</td>
              <td class="py-2.5">Standard International QWERTY</td>
            </tr>
            <tr>
              <td class="py-2.5 font-semibold text-[var(--text-primary)]">Web &amp; Search (SEO)</td>
              <td class="py-2.5 text-emerald-500 font-semibold">100% Searchable &amp; Accessible</td>
              <td class="py-2.5 text-emerald-500 font-semibold">100% Searchable &amp; Accessible</td>
              <td class="py-2.5 text-rose-500 font-semibold">Non-searchable (Font reliant)</td>
              <td class="py-2.5 text-emerald-500 font-semibold">100% Searchable &amp; Accessible</td>
            </tr>
            <tr>
              <td class="py-2.5 font-semibold text-[var(--text-primary)]">Target Key for 'क'</td>
              <td class="py-2.5 font-mono">Press key <kbd>s</kbd></td>
              <td class="py-2.5 font-mono">Press key <kbd>k</kbd></td>
              <td class="py-2.5 font-mono">Press key <kbd>s</kbd></td>
              <td class="py-2.5 font-mono">N/A (Latin k)</td>
            </tr>
            <tr>
              <td class="py-2.5 font-semibold text-[var(--text-primary)]">Primary Domain</td>
              <td class="py-2.5">Government, Banking, Publishing</td>
              <td class="py-2.5">Social Media, Chat, Software UI</td>
              <td class="py-2.5">Offset Printing, Archival Press</td>
              <td class="py-2.5">Global Business, Coding, Academic</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="mt-4 pt-3 border-t border-[var(--border-subtle)] flex flex-wrap items-center justify-between gap-2 text-xs">
        <span class="text-[var(--text-muted)]">Looking to convert documents between legacy ASCII and modern UTF-8 Unicode?</span>
        <div class="flex items-center gap-3">
          <a href="/preeti-to-unicode" class="font-semibold text-rose-600 dark:text-rose-400 hover:underline">Preeti &harr; Unicode Converter &rarr;</a>
          <span class="text-[var(--border-subtle)]">|</span>
          <a href="/ams-to-unicode" class="font-semibold text-amber-600 dark:text-amber-400 hover:underline">AMS &harr; Unicode Converter &rarr;</a>
        </div>
      </div>
    </div>

    <!-- 3. Core Standards & Capabilities (Compact 3-Card Grid) -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
      <!-- Card 1 -->
      <div class="p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)]">
        <div class="flex items-center gap-2 font-bold text-[var(--text-primary)] mb-1.5">
          <Icon name="lucide:award" class="w-4 h-4 text-purple-500" />
          <span>Loksewa &amp; Certification</span>
        </div>
        <p class="text-[var(--text-muted)] leading-relaxed">
          Standardized benchmark passing thresholds: 20+ WPM Nepali, 25+ WPM English, and &ge; 85% accuracy. Permanent verifiable certificate records with unique ID and QR code.
        </p>
      </div>

      <!-- Card 2 -->
      <div class="p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)]">
        <div class="flex items-center gap-2 font-bold text-[var(--text-primary)] mb-1.5">
          <Icon name="lucide:book-open" class="w-4 h-4 text-amber-500" />
          <span>Authentic Dantya Katha</span>
        </div>
        <p class="text-[var(--text-muted)] leading-relaxed">
          Expansive library of Nepali folklore stories, historical speeches, and cultural literature. Chained paragraphs prevent repetitive single-word fatigue.
        </p>
      </div>

      <!-- Card 3 -->
      <div class="p-4 rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)]">
        <div class="flex items-center gap-2 font-bold text-[var(--text-primary)] mb-1.5">
          <Icon name="lucide:activity" class="w-4 h-4 text-blue-500" />
          <span>Keystroke Biometrics</span>
        </div>
        <p class="text-[var(--text-muted)] leading-relaxed">
          Real-time measurement of per-key latency, lateral hand load distribution, hesitation heatmaps, and adaptive drills for weak keys.
        </p>
      </div>
    </div>

  </div>
</section>
