---
interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  keywords?: string;
  ogImage?: string;
  ogType?: string;
  activeNav?: string;
  schema?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = 'TopNepali Typing — Professional Nepali & English Typing Certification',
  description = 'Enterprise-grade typing test platform for English QWERTY, Nepali Unicode Traditional, Romanized, and Preeti ASCII. Earn verifiable certificates, train with adaptive AI drills, and track stroke biomechanics.',
  canonicalUrl = 'https://typing.topnepali.com',
  keywords = 'Nepali typing test, Preeti typing test, Nepali Unicode traditional, Romanized typing test, Devanagari typing speed, WPM typing test Nepal, typing certificate Nepal, Loksewa typing test, Balen speech typing test',
  ogImage = 'https://img.topnepali.com/typing.tn/og/default-svg.webp',
  ogType = 'website',
  activeNav = 'test',
  schema
} = Astro.props;

import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const defaultWebApplicationSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "TopNepali Typing Platform",
  "url": canonicalUrl,
  "applicationCategory": "EducationalApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": description,
  "screenshot": ogImage
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": "https://typing.topnepali.com"
    },
    ...(canonicalUrl !== 'https://typing.topnepali.com' ? [{
      "@type": "ListItem",
      "position": 2,
      "name": title.split('—')[0].trim(),
      "item": canonicalUrl
    }] : [])
  ]
};
---

<!doctype html>
<html lang="en" class="dark" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="TopNepali / Grisma" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Social Media -->
    <meta property="og:site_name" content="TopNepali Typing Platform" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Preload Fonts -->
    <link rel="preload" href="/fonts/kokila.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/preeti.ttf" as="font" type="font/ttf" crossorigin />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- TopNepali Universal Governance: Strict Production Isolation for Trackers & AdSense -->
    <script is:inline>
      (function() {
        try {
          var h = window.location.hostname.toLowerCase();
          var isProd = (h === 'typing.topnepali.com' || h === 'www.typing.topnepali.com');
          var p = window.location.pathname.toLowerCase().replace(/\/+$/, '') || '/';
          var isLegal = ['/privacy', '/terms', '/about', '/contact', '/certificate/view', '/verify'].indexOf(p) !== -1;

          // 1. Strict No-Index & Tracker/Ad Suppression on Preview / Staging
          if (!isProd) {
            var rMeta = document.createElement('meta');
            rMeta.name = 'robots';
            rMeta.content = 'noindex, nofollow, noarchive, nosnippet';
            document.head.appendChild(rMeta);

            var gMeta = document.createElement('meta');
            gMeta.name = 'googlebot';
            gMeta.content = 'noindex, nofollow, noarchive, nosnippet';
            document.head.appendChild(gMeta);

            // Inert stub to protect against AdSense crashes while blocking ad network calls
            window.adsbygoogle = { push: function() {} };
            return;
          }

          // 2. Production Trackers (GA4 + Microsoft Clarity)
          var gaScript = document.createElement('script');
          gaScript.async = true;
          gaScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-K2R0GSQE0M';
          document.head.appendChild(gaScript);

          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-K2R0GSQE0M');

          (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
          })(window, document, "clarity", "script", "7n9ehw4x5h");

          // 3. Google AdSense (English Production Only, Disallowed on Legal/Cert Pages)
          if (!isLegal) {
            var adMeta = document.createElement('meta');
            adMeta.name = 'google-adsense-account';
            adMeta.content = 'ca-pub-5410507143596599';
            document.head.appendChild(adMeta);

            var adScript = document.createElement('script');
            adScript.defer = true;
            adScript.crossOrigin = 'anonymous';
            adScript.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5410507143596599';
            document.head.appendChild(adScript);
          } else {
            window.adsbygoogle = { push: function() {} };
          }
        } catch(e) {}
      })();
    </script>

    <!-- Structured Data: WebApplication & Breadcrumbs -->
    <script type="application/ld+json" set:html={JSON.stringify(defaultWebApplicationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <!-- Theme State Initialization (Prevent FOUC) -->
    <script is:inline>
      const savedTheme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', savedTheme);
      document.documentElement.className = savedTheme;
    </script>
  </head>
  <body class="bg-[var(--bg-app)] text-[var(--text-primary)] min-h-screen flex flex-col antialiased">
    <Header activeNav={activeNav} />
    <main class="flex-1 py-2 sm:py-4">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      // Theme Toggle Logic (supports both desktop and mobile headers)
      const themeBtns = document.querySelectorAll('.theme-toggle-btn, #theme-toggle-btn');
      const sunIcons = document.querySelectorAll('.theme-icon-sun, #theme-icon-sun');
      const moonIcons = document.querySelectorAll('.theme-icon-moon, #theme-icon-moon');

      function updateThemeIcons(theme) {
        sunIcons.forEach(icon => {
          if (theme === 'dark') {
            icon.classList.remove('hidden');
          } else {
            icon.classList.add('hidden');
          }
        });
        moonIcons.forEach(icon => {
          if (theme === 'dark') {
            icon.classList.add('hidden');
          } else {
            icon.classList.remove('hidden');
          }
        });
      }

      const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
      updateThemeIcons(currentTheme);

      themeBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const activeTheme = document.documentElement.getAttribute('data-theme');
          const nextTheme = activeTheme === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', nextTheme);
          document.documentElement.className = nextTheme;
          localStorage.setItem('theme', nextTheme);
          updateThemeIcons(nextTheme);
        });
      });
    </script>

    <!-- Core Typing Application Client Script (Modular ES Engine) -->
    <script type="module" src="/js/typing-app.js"></script>
  </body>
</html>
