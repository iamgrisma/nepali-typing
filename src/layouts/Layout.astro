---
interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  activeNav?: string;
}

const {
  title = 'TopNepali Typing — Professional Nepali & English Typing Certification',
  description = 'Enterprise-grade typing test platform for English QWERTY, Nepali Unicode Traditional, Romanized, and Preeti ASCII. Earn verifiable certificates, train with adaptive AI drills, and track stroke biomechanics.',
  canonicalUrl = 'https://typing.topnepali.com',
  activeNav = 'test'
} = Astro.props;

import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en" class="dark" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Nepali typing test, Preeti typing test, Nepali Unicode traditional, Romanized typing test, Devanagari typing speed, WPM typing test Nepal, typing certificate Nepal, Balen speech typing test" />
    <meta name="author" content="TopNepali / Grisma" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="TopNepali Typing Platform" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Preload Fonts -->
    <link rel="preload" href="/fonts/kokila.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/preeti.ttf" as="font" type="font/ttf" crossorigin />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Structured Data: WebApplication -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "TopNepali Typing Platform",
      "applicationCategory": "EducationalApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": description,
      "url": canonicalUrl
    })} />

    <!-- Theme State Initialization (Prevent FOUC) -->
    <script is:inline>
      const savedTheme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', savedTheme);
      document.documentElement.className = savedTheme;
    </script>
  </head>
  <body class="bg-[var(--bg-app)] text-[var(--text-primary)] min-h-screen flex flex-col antialiased">
    <Header activeNav={activeNav} />
    <main class="flex-1 py-2 sm:py-4">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      // Theme Toggle Logic
      const themeBtn = document.getElementById('theme-toggle-btn');
      const sunIcon = document.getElementById('theme-icon-sun');
      const moonIcon = document.getElementById('theme-icon-moon');

      function updateThemeIcons(theme) {
        if (theme === 'dark') {
          sunIcon?.classList.remove('hidden');
          moonIcon?.classList.add('hidden');
        } else {
          sunIcon?.classList.add('hidden');
          moonIcon?.classList.remove('hidden');
        }
      }

      const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
      updateThemeIcons(currentTheme);

      themeBtn?.addEventListener('click', () => {
        const activeTheme = document.documentElement.getAttribute('data-theme');
        const nextTheme = activeTheme === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', nextTheme);
        document.documentElement.className = nextTheme;
        localStorage.setItem('theme', nextTheme);
        updateThemeIcons(nextTheme);
      });
    </script>

    <!-- Core Typing Application Client Script (Modular ES Engine) -->
    <script type="module" src="/js/typing-app.js"></script>
  </body>
</html>
