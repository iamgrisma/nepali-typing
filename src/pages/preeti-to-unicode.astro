---
import Layout from '../layouts/Layout.astro';
import '../styles/preeti-font.css';

const pageTitle = "Preeti to Unicode Converter — Fast, Accurate Nepali Typing Tool";
const pageDesc = "Convert legacy Preeti font text into standard Nepali Unicode instantly. Fully compatible with Word, Google Docs, social media, and websites. Free in-browser tool.";
const canonicalUrl = "https://typing.topnepali.com/preeti-to-unicode";
const ogImageUrl = "https://img.topnepali.com/typing.tn/og/preeti-svg.webp";
const keywords = "Preeti to Unicode, Preeti to Unicode converter, Nepali typing converter, convert Preeti to Nepali Unicode, Nepali font converter, online Preeti converter";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the difference between Preeti font and Nepali Unicode?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Preeti is a legacy TrueType font that maps Devanagari glyphs onto standard English ASCII keyboard positions. If a computer does not have the Preeti font file installed, the text appears as random English characters (e.g. 'g]kfn'). Nepali Unicode, by contrast, assigns globally standardized UTF-8 hexadecimal codes to every Nepali letter and matra. It displays correctly on any smartphone, operating system, search engine, or website worldwide without requiring custom fonts."
      }
    },
    {
      "@type": "Question",
      "name": "Does this converter retain bold, italic, and heading formatting?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Our converter uses recursive DOM node transformation rather than plain text replacement. Any bold, italic, headings (H2/H3), bullet lists, and paragraphs remain completely intact during conversion and can be copied or downloaded as a Word document (.doc) with zero loss of structure."
      }
    },
    {
      "@type": "Question",
      "name": "How does the converter handle complex ligatures like half-letters and rephs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The engine accurately reorganizes raswa ikaar markers (which appear before consonants in Preeti but after in Unicode phonetic order) and reph ligatures (which appear after consonants in Preeti but preceding in Devanagari Unicode) without missing half-letters or compound akshars."
      }
    }
  ]
};

const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Preeti to Unicode Converter by TopNepali",
  "url": canonicalUrl,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "NPR"
  },
  "description": pageDesc
};
---

<Layout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl={canonicalUrl}
  ogImage={ogImageUrl}
  keywords={keywords}
  schema={[appSchema, faqSchema]}
  activeNav="converter"
>
  <div class="converter-wrapper py-4 sm:py-6">

    <!-- Hero Header -->
    <header class="text-center max-w-3xl mx-auto pt-2 pb-6">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20 mb-2.5">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="16 3 21 3 21 8"></polyline>
          <line x1="4" y1="20" x2="21" y2="3"></line>
          <polyline points="21 16 21 21 16 21"></polyline>
          <line x1="15" y1="15" x2="21" y2="21"></line>
          <line x1="4" y1="4" x2="9" y2="9"></line>
        </svg>
        <span>STANDALONE RICH-TEXT COMPATIBLE</span>
      </div>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold font-display tracking-tight text-[var(--text-primary)]">
        Preeti to Unicode <span class="text-rose-600">Converter</span>
      </h1>
      <p class="mt-2 text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
        Convert legacy Preeti font text to standard Nepali Unicode in real-time. Retain bold, italic, headings, and list formatting when pasting into Word or Google Docs.
      </p>
    </header>

    <!-- Master Converter Toolbar -->
    <div class="converter-toolbar">
      <!-- Mode Switcher & Swap Chords -->
      <div class="flex items-center gap-1.5 flex-wrap">
        <div class="inline-flex p-1 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
          <button
            type="button"
            id="mode-preeti-to-uni"
            class="converter-btn converter-btn-primary font-bold cursor-default pointer-events-none"
            title="Currently on Preeti to Unicode Converter"
          >
            Preeti &rarr; Unicode
          </button>
          <button
            type="button"
            id="mode-uni-to-preeti"
            class="converter-btn hover:bg-[var(--bg-surface)] cursor-pointer"
            title="Switch to Unicode to Preeti Converter (swaps text automatically)"
          >
            Unicode &rarr; Preeti
          </button>
        </div>

        <button
          type="button"
          id="swap-mode-btn"
          class="converter-btn p-2 hover:bg-[var(--bg-surface)] cursor-pointer"
          title="Switch Converter and Swap Text"
          aria-label="Switch Converter and Swap Text"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 16V4m0 0L3 8m4-4l4 4m6 4v12m0 0l4-4m-4 4l-4-4"></path>
          </svg>
        </button>
      </div>

      <!-- Rich Text Formatting Actions -->
      <div class="flex items-center gap-1 bg-[var(--bg-surface-subtle)] p-1 rounded-xl border border-[var(--border-subtle)] flex-wrap">
        <button type="button" class="converter-btn fmt-btn p-1.5" data-cmd="bold" title="Bold (Ctrl+B)">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"></path><path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"></path></svg>
        </button>
        <button type="button" class="converter-btn fmt-btn p-1.5" data-cmd="italic" title="Italic (Ctrl+I)">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="4" x2="10" y2="4"></line><line x1="14" y1="20" x2="5" y2="20"></line><line x1="15" y1="4" x2="9" y2="20"></line></svg>
        </button>
        <button type="button" class="converter-btn fmt-btn p-1.5" data-cmd="underline" title="Underline (Ctrl+U)">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 3v7a6 6 0 0 0 6 6 6 6 0 0 0 6-6V3"></path><line x1="4" y1="21" x2="20" y2="21"></line></svg>
        </button>

        <div class="converter-divider"></div>

        <button type="button" class="converter-btn fmt-btn px-2 py-1 font-bold text-xs" data-cmd="formatBlock" data-val="h2" title="Heading 2">H2</button>
        <button type="button" class="converter-btn fmt-btn px-2 py-1 font-bold text-xs" data-cmd="formatBlock" data-val="h3" title="Heading 3">H3</button>

        <div class="converter-divider"></div>

        <button type="button" class="converter-btn fmt-btn p-1.5" data-cmd="insertUnorderedList" title="Bullet List">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
        </button>
        <button type="button" class="converter-btn fmt-btn p-1.5" data-cmd="insertOrderedList" title="Numbered List">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="10" y1="6" x2="21" y2="6"></line><line x1="10" y1="12" x2="21" y2="12"></line><line x1="10" y1="18" x2="21" y2="18"></line><path d="M4 6h1v4"></path><path d="M4 10h2"></path><path d="M6 18H4c0-1 2-2 2-3s-1-1.5-2-1"></path></svg>
        </button>
        <button type="button" class="converter-btn fmt-btn p-1.5" data-cmd="removeFormat" title="Clear Formatting">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>

        <div class="converter-divider"></div>

        <!-- Font Size Scaler -->
        <div class="flex items-center gap-1">
          <button type="button" id="btn-font-smaller" class="converter-btn px-1.5 py-0.5 text-xs font-bold" title="Decrease font size">A-</button>
          <span id="label-font-size" class="text-xs font-mono text-[var(--text-muted)] min-w-[32px] text-center font-bold">20px</span>
          <button type="button" id="btn-font-larger" class="converter-btn px-1.5 py-0.5 text-xs font-bold" title="Increase font size">A+</button>
        </div>
      </div>
    </div>

    <!-- Dual-Pane Workspace Grid -->
    <div class="converter-grid">
      <!-- Input Pane (Preeti) -->
      <div class="converter-pane">
        <div class="converter-pane-header">
          <div class="flex items-center gap-2 flex-wrap">
            <span id="input-label" class="font-bold uppercase tracking-wider text-xs text-[var(--text-primary)]">
              Preeti Text Input
            </span>

            <!-- Preeti Visual Toggle -->
            <button
              type="button"
              id="btn-toggle-input-font"
              class="converter-pill border border-rose-500/30 text-rose-600 dark:text-rose-400 bg-rose-500/10 cursor-pointer"
              title="Toggle between authentic Nepali Devanagari visual preview and Raw ASCII keys"
            >
              <svg class="w-3 h-3 text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
              <span id="input-font-tag">Nepali Visual</span>
            </button>

            <!-- Typing Layout Selector for Preeti Pane (Preeti Typewriter vs English QWERTY) -->
            <div class="inline-flex items-center gap-1 pl-1">
              <span class="text-xs font-semibold text-[var(--text-muted)] hidden sm:inline">Layout:</span>
              <select
                id="select-typing-layout"
                class="converter-btn text-xs font-semibold cursor-pointer bg-[var(--bg-surface)] text-[var(--text-primary)] border border-[var(--border-subtle)] rounded-lg py-0.5 px-2 outline-none"
                title="Select typing layout or press Left Alt + Left Shift to toggle"
              >
                <option value="preeti" selected>Preeti Typewriter</option>
                <option value="english">English QWERTY</option>
              </select>
              <span class="text-[10px] font-mono text-[var(--text-muted)] border border-[var(--border-subtle)] px-1.5 py-0.5 rounded bg-[var(--bg-surface-subtle)] hidden sm:inline-block" title="Press Left Alt + Left Shift to toggle">
                Alt+Shift
              </span>
            </div>
          </div>

          <div class="flex items-center gap-1.5">
            <button type="button" id="btn-sample-text" class="converter-btn text-xs">Sample Guide</button>
            <button type="button" id="btn-paste-input" class="converter-btn text-xs">Paste</button>
            <button type="button" id="btn-clear-input" class="converter-btn text-xs text-rose-600 hover:text-rose-700">Clear</button>
          </div>
        </div>

        <!-- Editable Input Content Area (Preeti Visual by Default) -->
        <div
          id="editor-input"
          contenteditable="true"
          spellcheck="false"
          class="converter-editor font-preeti select-text"
          data-preeti-visual="true"
          data-placeholder="Type in Preeti (or English QWERTY) or paste text here..."
        ></div>

        <div class="converter-pane-footer">
          <div class="flex items-center gap-4">
            <span>Characters: <strong id="input-char-count" class="text-[var(--text-primary)]">0</strong></span>
            <span>Words: <strong id="input-word-count" class="text-[var(--text-primary)]">0</strong></span>
          </div>
          <span class="text-xs text-[var(--text-muted)] flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block animate-pulse"></span>
            Real-time live conversion
          </span>
        </div>
      </div>

      <!-- Output Pane (Nepali Unicode) -->
      <div class="converter-pane">
        <div class="converter-pane-header">
          <div class="flex items-center gap-2">
            <span id="output-label" class="font-bold uppercase tracking-wider text-xs text-[var(--text-primary)]">
              Nepali Unicode Output
            </span>
            <div class="converter-pill border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 bg-emerald-500/10">
              <span id="output-font-tag">UTF-8 UNICODE</span>
            </div>
          </div>

          <div class="flex items-center gap-1.5 flex-wrap">
            <button
              type="button"
              id="btn-copy-rich"
              class="converter-btn converter-btn-success text-xs font-bold"
              title="Copy formatted text with bold, italic, and headings preserved for Word / Google Docs"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span>Copy Formatted</span>
            </button>
            <button type="button" id="btn-copy-plain" class="converter-btn text-xs" title="Copy plain text">Copy Text</button>

            <!-- Formatted Word Document Download -->
            <button
              type="button"
              id="btn-download-doc"
              class="converter-btn text-xs font-bold border-blue-500/40 text-blue-600 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-950/30"
              title="Download formatted Microsoft Word document (.doc) with headings, bold, and styles preserved"
            >
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
              <span>Word (.doc)</span>
            </button>

            <!-- Plain Text File Download -->
            <button type="button" id="btn-download-txt" class="converter-btn text-xs" title="Download plain text file">.txt</button>
            <button type="button" id="btn-print-doc" class="converter-btn text-xs">Print</button>
          </div>
        </div>

        <!-- Converted Output Area (Unicode) -->
        <div
          id="editor-output"
          contenteditable="true"
          spellcheck="false"
          class="converter-editor font-nepali select-text"
          data-font-nepali="true"
          data-placeholder="Converted Unicode text appears here instantly..."
        ></div>

        <div class="converter-pane-footer">
          <div class="flex items-center gap-4">
            <span>Characters: <strong id="output-char-count" class="text-[var(--text-primary)]">0</strong></span>
            <span>Words: <strong id="output-word-count" class="text-[var(--text-primary)]">0</strong></span>
          </div>
          <div id="copy-status-indicator" class="font-bold text-emerald-600 dark:text-emerald-400 opacity-0 transition-opacity">
            Copied to clipboard
          </div>
        </div>
      </div>
    </div>

    <!-- Educational & Technical Content -->
    <section class="mt-12 space-y-8">
      <div class="bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-2xl p-6 sm:p-8 shadow-sm">
        <h2 class="text-xl sm:text-2xl font-bold font-display text-[var(--text-primary)] mb-3">
          Why Standardize on Nepali Unicode?
        </h2>
        <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed mb-4">
          For decades, Nepali government offices, newspapers, and publishing presses relied on ASCII typefaces like <strong>Preeti</strong>, <strong>Kantipur</strong>, and <strong>Sagarmatha</strong>. Because these fonts remap English keystrokes to Devanagari shapes, the underlying file contains English characters (e.g. <code>g]kfn</code> for <strong>नेपाल</strong>).
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs sm:text-sm mt-4">
          <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
            <h3 class="font-bold text-[var(--text-primary)] mb-1">Universal Search &amp; SEO</h3>
            <p class="text-[var(--text-muted)]">Google and AI crawlers cannot index legacy ASCII text. Unicode makes Nepali documents searchable worldwide.</p>
          </div>
          <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
            <h3 class="font-bold text-[var(--text-primary)] mb-1">Mobile &amp; Cross-Platform</h3>
            <p class="text-[var(--text-muted)]">Unicode displays on iOS, Android, macOS, and Linux without installing custom TTF font files.</p>
          </div>
          <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
            <h3 class="font-bold text-[var(--text-primary)] mb-1">Database &amp; Archival</h3>
            <p class="text-[var(--text-muted)]">Standard UTF-8 encoding prevents corruption when transferring records across banking and legal software.</p>
          </div>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-2xl p-6 sm:p-8 shadow-sm mb-8">
        <h2 class="text-lg font-bold font-display text-[var(--text-primary)] mb-4">
          Frequently Asked Questions
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs sm:text-sm">
          <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
            <h3 class="font-bold text-[var(--text-primary)] mb-1.5">What is the difference between Preeti and Nepali Unicode?</h3>
            <p class="text-[var(--text-secondary)] leading-relaxed">
              Preeti is an ASCII-mapped font requiring pre-installed font files. Nepali Unicode is a global UTF-8 standard that works natively across all computers, smartphones, and web browsers.
            </p>
          </div>
          <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
            <h3 class="font-bold text-[var(--text-primary)] mb-1.5">Does the converter retain bold and italic styles?</h3>
            <p class="text-[var(--text-secondary)] leading-relaxed">
              Yes. All bold, italic, headings, and list structures are retained across DOM nodes. You can copy directly into Word or download a formatted Word document (.doc).
            </p>
          </div>
          <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
            <h3 class="font-bold text-[var(--text-primary)] mb-1.5">Can I convert pasted Unicode back into Preeti?</h3>
            <p class="text-[var(--text-secondary)] leading-relaxed">
              Yes. Use the <a href="/unicode-to-preeti/" class="text-rose-600 underline font-semibold">Unicode to Preeti Converter</a> for reverse conversions needed in Adobe InDesign and PageMaker.
            </p>
          </div>
          <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
            <h3 class="font-bold text-[var(--text-primary)] mb-1.5">Is my text stored on your servers?</h3>
            <p class="text-[var(--text-secondary)] leading-relaxed">
              No. All conversion operations occur client-side in your browser JavaScript engine. Your confidential documents and notes never leave your computer.
            </p>
          </div>
        </div>
      </div>
    </section>

  </div>

  <div id="converter-toast" class="converter-toast"></div>

  <!-- Self-Contained In-Browser Converter Script -->
  <script is:inline>
    (function initConverter() {
      // 1. Preeti to Unicode Replacement Tables
      const PREETI_TO_UNICODE_MAP = [
        ["k|m", "फ्र"], ["cf}F", "औँ"], ["cf}+", "औँ"], ["cf}", "औ"], ["cf]", "ओ"],
        ["cf", "आ"], ["pm", "ऊ"], ["P]", "ऐ"], ["8Þ", "ड़"], ["9Þ", "ढ़"],
        ["6«", "ट्र"], ["7«", "ठ्र"], ["8«", "ड्र"], ["9«", "ढ्र"], ["6|", "ट्र"],
        ["7|", "ठ्र"], ["8|", "ड्र"], ["9|", "ढ्र"], ["If", "क्ष"], ["0f", "ण"],
        ["if", "ष"], ["f}F", "ौँ"], ["f}+", "ौँ"], ["f]F", "ों"], ["f]+", "ों"],
        ["f}", "ौ"], ["f]", "ो"], ["k|", "प्र"], ["km", "फ"], ["Qm", "क्त"],
        ["qm", "क्र"], ["em", "झ"], ["1", "ज्ञ"], ["2", "द्द"], ["4", "द्ध"],
        ["Q", "त्त"], [">", "श्र"], ["?", "रु"], ["¿", "रू"], ["/\"", "रू"], ["/'", "रु"], ["B", "द्य"],
        ["I", "क्ष्"], ["q", "त्र"], ["å", "द्व"], ["§", "ट्ट"], ["•", "ड्ड"],
        ["°", "ड्ढ"], ["¶", "ठ्ठ"], ["Ý", "ट्ठ"], ["ß", "द्म"], ["¡", "ज्ञ्"],
        ["¢", "द्घ"], ["„", "ध्र"], ["›", "द्र"], ["‹", "ङ्घ"], ["Ë", "ङ्ग"],
        ["Í", "ङ्क"], ["Î", "ङ्ख"], ["Å", "हृ"],
        ["!", "१"], ["@", "२"], ["#", "३"], ["$", "४"], ["%", "५"],
        ["^", "६"], ["&", "७"], ["*", "८"], ["(", "९"], [")", "०"],
        ["ç", "ॐ"], ["˜", "ऽ"], [".", "।"], ["<", "?"],
        ["c", "अ"], ["O", "इ"], ["p", "उ"], ["P", "ए"], ["C", "ऋ"],
        ["S", "क्"], ["s", "क"], ["V", "ख्"], ["v", "ख"], ["U", "ग्"], ["u", "ग"],
        ["£", "घ्"], ["3", "घ"], ["ª", "ङ"], ["R", "च्"], ["r", "च"], ["5", "छ"],
        ["H", "ज्"], ["h", "ज"], ["‰", "झ्"], ["´", "झ"], ["~", "ञ्"], ["`", "ञ"],
        ["6", "ट"], ["7", "ठ"], ["8", "ड"], ["9", "ढ"], ["0", "ण्"],
        ["T", "त्"], ["t", "त"], ["Y", "थ्"], ["y", "थ"], ["b", "द"],
        ["W", "ध्"], ["w", "ध"], ["G", "न्"], ["g", "न"], ["K", "प्"], ["k", "प"],
        ["ˆ", "फ्"], ["m", "फ"], ["A", "ब्"], ["a", "ब"], ["E", "भ्"], ["e", "भ"],
        ["D", "म्"], ["d", "म"], ["o", "य"], ["/", "र"], ["N", "ल्"], ["n", "ल"],
        ["J", "व्"], ["j", "व"], ["Z", "श्"], ["z", "श"], ["i", "ष्"],
        [":", "स्"], [";", "स"], ["X", "ह्"], ["x", "ह"],
        ["f", "ा"], ["l", "ि"], ["L", "ी"], ["]", "े"], ["}", "ै"],
        ["'", "ु"], ['"', "ू"], ["[", "ृ"], ["+", "ं"], ["F", "ँ"],
        ["M", "ः"], ["\\", "्"], ["|", "्र"], ["Ø", "्य"], ["{", "र्"]
      ];

      const PREETI_HALF_CONS = '(?:[SVU£R~TYWGKˆAEDNJZ:X]|i(?![fF])|[svu3r5h´`67890tybwgkmaedonjzx]\\\\)';
      const PREETI_FULL_CONS = '(?:k\\|m|k\\||km|Qm|qm|em|If|if|6«|7«|8«|9«|6\\||7\\||8\\||9\\||8Þ|9Þ|1|2|4|Q|>|\\?|¿|B|I|q|å|§|•|°|¶|Ý|ß|¡|¢|„|›|‹|Ë|Í|Î|Å|[svu3r5h´`67890tybwgkmaedonjzx0cOpPC])';
      const PREETI_MATRAS = '[fL\\]}\'\"\\[+FM]';

      function hasDevanagari(text) {
        return /[\u0900-\u097F]/.test(text);
      }

      function preetiToUnicode(input) {
        if (!input) return '';
        let text = input;
        text = text.replaceAll('O{', 'ई');
        const rephPattern = new RegExp(`(${PREETI_HALF_CONS}*${PREETI_FULL_CONS}${PREETI_MATRAS}*)\\{`, 'g');
        text = text.replace(rephPattern, '{$1');
        const ikaarPattern = new RegExp(`l(${PREETI_HALF_CONS}*${PREETI_FULL_CONS})`, 'g');
        text = text.replace(ikaarPattern, '$1l');
        for (const [p, u] of PREETI_TO_UNICODE_MAP) {
          text = text.replaceAll(p, u);
        }
        return text;
      }

      // Universal text node recursion that skips English spans
      function convertNodesRecursively(node) {
        if (!node) return;
        if (node.nodeType === 1) {
          // If marked as English, LEAVE IT UNTOUCHED unless it contains Devanagari
          if (node.getAttribute('data-eng') === 'true' || node.classList.contains('eng-text')) {
            if (!/[\u0900-\u097F]/.test(node.textContent)) {
              return;
            }
            node.removeAttribute('data-eng');
            node.classList.remove('eng-text');
          }
          const children = Array.from(node.childNodes);
          for (let i = 0; i < children.length; i++) {
            convertNodesRecursively(children[i]);
          }
        } else if (node.nodeType === 3) {
          const text = node.nodeValue;
          if (text && text.length > 0) {
            node.nodeValue = preetiToUnicode(text);
          }
        }
      }

      // Reverse helper when pasting Unicode directly into Preeti box
      const CONTEXTUAL_RULES = [["((?:.्)*.)ि", "l$1"], ["र्((?:.्)*.)", "$1{"]];
      const END_HALANT_CONSONANTS = [
        ['क', 's'], ['ख', 'v'], ['ग', 'u'], ['घ', '3'], ['च', 'r'], ['छ', '5'],
        ['ज', 'h'], ['झ', '´'], ['ञ', '`'], ['ट', '6'], ['ठ', '7'], ['ड', '8'],
        ['ढ', '9'], ['ण', '0f'], ['त', 't'], ['थ', 'y'], ['द', 'b'], ['ध', 'w'],
        ['न', 'g'], ['प', 'k'], ['फ', 'km'], ['ब', 'a'], ['भ', 'e'], ['म', 'd'],
        ['य', 'o'], ['र', '/'], ['ल', 'n'], ['व', 'j'], ['श', 'z'], ['ष', 'if'],
        ['स', ';'], ['ह', 'x']
      ];
      const PREETI_CHAR_MAP = [
        ["❨", "-"], ["❩", "_"], ["‘", "…"], ["?", "<"], ["ॐ", "ç"], ["ऽ", "˜"], ["।", "."],
        ["m'", "'m"], ["m]", "]m"], ["mfF", "Fmf"], ["mF", "Fm"],
        ["०", ")"], ["१", "!"], ["२", "@"], ["३", "#"], ["४", "$"],
        ["५", "%"], ["६", "^"], ["७", "&"], ["८", "*"], ["९", "("],
        ["फ्र", "k|m"], ["झ", "em"], ["फ", "km"], ["क्त", "Qm"], ["क्र", "qm"],
        ["ज्ञ्", "¡"], ["द्घ", "¢"], ["ज्ञ", "1"], ["द्द", "2"], ["द्ध", "4"],
        ["श्र", ">"], ["रु", "?"], ["द्य", "B"], ["क्ष्", "I"], ["क्ष", "If"],
        ["त्त", "Q"], ["द्म", "b\\d"], ["त्र", "q"], ["ध्र", "w|"], ["ङ्घ", "‹"],
        ["ड्ड", "8\\8"], ["द्र", "b|"], ["ट्ट", "6\\6"], ["ड्ढ", "°"], ["ठ्ठ", "7\\7"],
        ["रू", "¿"], ["हृ", "x["], ["ङ्ग", "+u"], ["ङ्क", "+s"], ["ङ्ख", "+v"],
        ["ट्ठ", "7\\7"], ["द्व", "b\\j"], ["ट्र", "6|"], ["ठ्र", "7|"], ["ड्र", "8|"],
        ["ढ्र", "9|"], ["्र", "|"], ["ड़", "8Þ"], ["ढ़", "9Þ"],
        ["क्", "S"], ["क", "s"], ["ख्", "V"], ["ख", "v"], ["ग्", "U"], ["ग", "u"],
        ["घ्", "£"], ["घ", "3"], ["ङ", "ª"], ["च्", "R"], ["च", "r"], ["छ", "5"],
        ["ज्", "H"], ["ज", "h"], ["झ्", "‰"], ["झ", "´"], ["ञ्", "~"], ["ञ", "`"],
        ["ट", "6"], ["ठ", "7"], ["ड", "8"], ["ढ", "9"], ["ण्", "0"], ["ण", "0f"],
        ["त्", "T"], ["त", "t"], ["थ्", "Y"], ["थ", "y"], ["द", "b"], ["ध्", "W"],
        ["ध", "w"], ["न्", "G"], ["न", "g"], ["प्", "K"], ["प", "k"], ["फ्", "ˆ"],
        ["ब्", "A"], ["ब", "a"], ["भ्", "E"], ["भ", "e"], ["म्", "D"], ["म", "d"],
        ["य", "o"], ["र", "/"], ["ल्", "N"], ["ल", "n"], ["व्", "J"], ["व", "j"],
        ["श्", "Z"], ["श", "z"], ["ष्", "i"], ["ष", "if"], ["स्", ":"], ["स", ";"],
        ["ह्", "X"], ["ह", "x"], ["्य", "Ø"],
        ["औ", "cf}"], ["ओ", "cf]"], ["आ", "cf"], ["अ", "c"],
        ["ई", "O{"], ["इ", "O"], ["ऊ", "pm"], ["उ", "p"], ["ऋ", "C"], ["ऐ", "P]"], ["ए", "P"],
        ["ू", "\""], ["ु", "'"], ["ं", "+"], ["ा", "f"], ["ृ", "["],
        ["्", "\\"], ["े", "]"], ["ै", "}"], ["ँ", "F"], ["ी", "L"],
        ["ः", "M"], ["ो", "f]"], ["ौ", "f}"]
      ];

      function toPreeti(text) {
        if (!text) return '';
        let s = text;
        for (const [c, p] of END_HALANT_CONSONANTS) {
          const re = new RegExp(`${c}्(?=$|[^\\u0900-\\u097F])`, 'g');
          s = s.replace(re, `${p}\\`);
        }
        for (const [pattern, replacement] of CONTEXTUAL_RULES) {
          s = s.replace(new RegExp(pattern, 'g'), replacement);
        }
        for (const [u, p] of PREETI_CHAR_MAP) {
          s = s.replaceAll(u, p);
        }
        return s;
      }

      // 2. UI State
      let inputPreetiVisual = true;
      let currentFontSize = 20;
      let typingLayout = 'preeti'; // 'preeti' | 'english'

      const editorInput = document.getElementById('editor-input');
      const editorOutput = document.getElementById('editor-output');
      const inputFontTag = document.getElementById('input-font-tag');

      const inputCharCount = document.getElementById('input-char-count');
      const inputWordCount = document.getElementById('input-word-count');
      const outputCharCount = document.getElementById('output-char-count');
      const outputWordCount = document.getElementById('output-word-count');

      const modeBtnUniToPreeti = document.getElementById('mode-uni-to-preeti');
      const swapModeBtn = document.getElementById('swap-mode-btn');
      const selectTypingLayout = document.getElementById('select-typing-layout');
      const btnToggleInputFont = document.getElementById('btn-toggle-input-font');

      const btnFontSmaller = document.getElementById('btn-font-smaller');
      const btnFontLarger = document.getElementById('btn-font-larger');
      const labelFontSize = document.getElementById('label-font-size');

      const btnSampleText = document.getElementById('btn-sample-text');
      const btnPasteInput = document.getElementById('btn-paste-input');
      const btnClearInput = document.getElementById('btn-clear-input');

      const btnCopyRich = document.getElementById('btn-copy-rich');
      const btnCopyPlain = document.getElementById('btn-copy-plain');
      const btnDownloadDoc = document.getElementById('btn-download-doc');
      const btnDownloadTxt = document.getElementById('btn-download-txt');
      const btnPrintDoc = document.getElementById('btn-print-doc');
      const copyStatusIndicator = document.getElementById('copy-status-indicator');
      const toastEl = document.getElementById('converter-toast');

      const fmtButtons = document.querySelectorAll('.fmt-btn');

      const SAMPLE_GUIDE_UNICODE = `<h2>नेपाली युनिकोड तथा प्रिती कन्भर्टर प्रयोग निर्देशिका</h2><p>यो नेपालको आधुनिक <b><span class="eng-text" data-eng="true">TopNepali</span></b> अनलाइन टाइपिङ तथा फन्ट रूपान्तरण प्लेटफर्म हो । यसले <i><span class="eng-text" data-eng="true">Microsoft Word</span></i>, <i><span class="eng-text" data-eng="true">Adobe InDesign</span></i>, तथा <i><span class="eng-text" data-eng="true">Google Docs</span></i> को लागि पूर्ण फर्म्याटिङ संरक्षण गर्दछ ।</p><h3>प्रमुख विशेषताहरू <span class="eng-text" data-eng="true">(Key Highlights)</span> :</h3><ul><li><b>द्रुत किबोर्ड सर्टकट <span class="eng-text" data-eng="true">(Keyboard Chord)</span> :</b> किबोर्डमा <u><span class="eng-text" data-eng="true">Left Alt + Left Shift</span></u> थिचेर प्रिती र <span class="eng-text" data-eng="true">English QWERTY</span> बीच तुरुन्तै अदलबदल गर्न सकिन्छ ।</li><li><b>द्विभाषी टाइपिङ र अंग्रेजी संरक्षण <span class="eng-text" data-eng="true">(Bilingual Preservation)</span> :</b> युनिकोडबाट प्रिती बनाउँदा अंग्रेजी शब्दहरू जस्तै <b>मकै <span class="eng-text" data-eng="true">(corn)</span></b> वा <b>नेपाल <span class="eng-text" data-eng="true">(Nepal)</span></b> पेस्ट गर्दा पनि स्वतः सुरक्षित रहन्छन् । तर पुरानो प्रिती फन्ट आफैँमा अंग्रेजी किस्ट्रोक <span class="eng-text" data-eng="true">(ASCII)</span> हुने भएकाले प्रिती बक्समा पेस्ट गर्दा कुन अंग्रेजी हो छुट्याउन सकिँदैन र सबै युनिकोड बन्दछ । यदि प्रिती बक्समा अंग्रेजी शब्द राख्नुपरेमा <u><span class="eng-text" data-eng="true">Alt + Shift</span></u> थिची <span class="eng-text" data-eng="true">English QWERTY</span> मा टाइप गर्नुहोस्, त्यो अंग्रेजी युनिकोडमा सुरक्षित रहन्छ ।</li><li><b>पूर्ण फर्म्याटिङ संरक्षण :</b> बोल्ड <span class="eng-text" data-eng="true">(Bold)</span>, इटालिक <span class="eng-text" data-eng="true">(Italic)</span>, हेडिङहरू <span class="eng-text" data-eng="true">(H2, H3)</span>, र बुलेट सूची <span class="eng-text" data-eng="true">(Bullet List)</span> सहित <b><span class="eng-text" data-eng="true">Word (.doc)</span></b> फाइल डाउनलोड गर्न सकिन्छ ।</li><li><b>हलन्त र रेफ शुद्धता :</b> श्रीमान्, महान्, र छन् जस्ता शब्दहरू शुद्ध रूपान्तरण हुन्छन् ।</li></ul><p>तपाईं आफ्नो पाठ यहाँ सिधै टाइप गर्न वा बाहिरबाट <b><span class="eng-text" data-eng="true">Paste</span></b> गरी तत्काल रूपान्तरण गर्न सक्नुहुन्छ ।</p>`;

      function getSampleGuidePreeti() {
        const div = document.createElement('div');
        div.innerHTML = SAMPLE_GUIDE_UNICODE;
        function recurse(n) {
          if (!n) return;
          if (n.nodeType === 1) {
            if (n.getAttribute('data-eng') === 'true' || n.classList.contains('eng-text')) return;
            const children = Array.from(n.childNodes);
            for (let i = 0; i < children.length; i++) recurse(children[i]);
          } else if (n.nodeType === 3) {
            if (n.nodeValue) n.nodeValue = toPreeti(n.nodeValue);
          }
        }
        recurse(div);
        return div.innerHTML;
      }

      function showToast(msg) {
        if (toastEl) {
          toastEl.textContent = msg;
          toastEl.classList.add('is-visible');
          setTimeout(() => toastEl.classList.remove('is-visible'), 2200);
        }
        if (copyStatusIndicator) {
          copyStatusIndicator.textContent = msg;
          copyStatusIndicator.style.opacity = '1';
          setTimeout(() => { copyStatusIndicator.style.opacity = '0'; }, 2200);
        }
      }

      function setEditorFontSize(size) {
        currentFontSize = Math.max(14, Math.min(36, size));
        if (editorInput) editorInput.style.fontSize = `${currentFontSize}px`;
        if (editorOutput) editorOutput.style.fontSize = `${currentFontSize}px`;
        if (labelFontSize) labelFontSize.textContent = `${currentFontSize}px`;
      }

      function applyPreetiVisualState() {
        if (inputPreetiVisual) {
          editorInput.setAttribute('data-preeti-visual', 'true');
          editorInput.classList.add('font-preeti');
          editorInput.classList.remove('font-ascii');
          editorInput.style.fontFamily = "'Font_preeti', 'Preeti'";
          if (inputFontTag) inputFontTag.textContent = 'Nepali Visual';
        } else {
          editorInput.setAttribute('data-preeti-visual', 'false');
          editorInput.classList.remove('font-preeti');
          editorInput.classList.add('font-ascii');
          editorInput.style.fontFamily = "'JetBrains Mono', monospace";
          if (inputFontTag) inputFontTag.textContent = 'Raw ASCII Keys';
        }
      }

      function calculateStats(text) {
        const chars = text.length;
        const trimmed = text.trim();
        const words = trimmed ? trimmed.split(/\s+/).length : 0;
        return { chars, words };
      }

      function runConversion() {
        try {
          const inputText = editorInput.innerText || '';
          const inStats = calculateStats(inputText);
          if (inputCharCount) inputCharCount.textContent = inStats.chars.toLocaleString();
          if (inputWordCount) inputWordCount.textContent = inStats.words.toLocaleString();

          if (!inputText.trim()) {
            editorOutput.innerHTML = '';
            if (outputCharCount) outputCharCount.textContent = '0';
            if (outputWordCount) outputWordCount.textContent = '0';
            return;
          }

          const clone = editorInput.cloneNode(true);
          convertNodesRecursively(clone);
          editorOutput.innerHTML = clone.innerHTML;

          const outText = editorOutput.innerText || '';
          const outStats = calculateStats(outText);
          if (outputCharCount) outputCharCount.textContent = outStats.chars.toLocaleString();
          if (outputWordCount) outputWordCount.textContent = outStats.words.toLocaleString();
        } catch (e) {
          console.error('Conversion error:', e);
        }
      }

      // Windows-Style Left Alt + Left Shift Keyboard Shortcut (Preeti vs English)
      function breakOutOfEngSpan() {
        const sel = window.getSelection();
        if (!sel || sel.rangeCount === 0) return;
        const range = sel.getRangeAt(0);
        let container = range.startContainer;
        let parentEl = container.nodeType === 1 ? container : container.parentElement;
        let engSpan = parentEl ? parentEl.closest('.eng-text, [data-eng="true"]') : null;
        if (engSpan) {
          let nextNode = engSpan.nextSibling;
          if (nextNode && nextNode.nodeType === 3) {
            const newRange = document.createRange();
            newRange.setStart(nextNode, 0);
            newRange.collapse(true);
            sel.removeAllRanges();
            sel.addRange(newRange);
          } else {
            const newRange = document.createRange();
            newRange.setStartAfter(engSpan);
            newRange.collapse(true);
            sel.removeAllRanges();
            sel.addRange(newRange);
          }
        }
      }

      function toggleTypingLayout() {
        typingLayout = (typingLayout === 'preeti') ? 'english' : 'preeti';
        if (selectTypingLayout) selectTypingLayout.value = typingLayout;
        if (typingLayout === 'preeti') {
          breakOutOfEngSpan();
        }
        const name = (typingLayout === 'preeti') ? 'Preeti Typewriter' : 'English QWERTY';
        showToast(`Layout: ${name} (Alt+Shift)`);
      }

      window.addEventListener('keydown', (e) => {
        if (e.repeat) return;
        if ((e.code === 'AltLeft' || e.key === 'Alt') && e.shiftKey) {
          e.preventDefault();
          toggleTypingLayout();
          return;
        }
        if ((e.code === 'ShiftLeft' || e.key === 'Shift') && e.altKey) {
          e.preventDefault();
          toggleTypingLayout();
          return;
        }
      });

      // Keydown Handling on Preeti editorInput
      editorInput.addEventListener('keydown', (e) => {
        // Only ignore modifier combinations with Ctrl or Meta, or non-character navigation keys.
        // Do not block single character keystrokes on altKey alone because thumb release after Alt+Shift may lag by a few milliseconds.
        if (e.ctrlKey || e.metaKey || e.key.length > 1) return;

        if (typingLayout === 'english') {
          e.preventDefault();
          const sel = window.getSelection();
          if (sel && sel.rangeCount > 0) {
            const range = sel.getRangeAt(0);
            let container = range.startContainer;
            let parentEl = container.nodeType === 1 ? container : container.parentElement;
            let engSpan = parentEl ? parentEl.closest('.eng-text, [data-eng="true"]') : null;

            if (!engSpan) {
              if (container.nodeType === 3 && range.startOffset === 0 && container.previousSibling) {
                const prev = container.previousSibling;
                if (prev.nodeType === 1 && (prev.getAttribute('data-eng') === 'true' || prev.classList.contains('eng-text'))) {
                  engSpan = prev;
                  container = engSpan.lastChild || engSpan;
                }
              } else if (container.nodeType === 1 && range.startOffset > 0) {
                const prev = container.childNodes[range.startOffset - 1];
                if (prev && prev.nodeType === 1 && (prev.getAttribute('data-eng') === 'true' || prev.classList.contains('eng-text'))) {
                  engSpan = prev;
                  container = engSpan.lastChild || engSpan;
                }
              }
            }

            if (engSpan && engSpan.contains(container)) {
              if (container.nodeType === 3) {
                const offset = range.startOffset;
                container.nodeValue = container.nodeValue.slice(0, offset) + e.key + container.nodeValue.slice(offset);
                const newRange = document.createRange();
                newRange.setStart(container, offset + 1);
                newRange.collapse(true);
                sel.removeAllRanges();
                sel.addRange(newRange);
              } else {
                const textNode = document.createTextNode(e.key);
                engSpan.appendChild(textNode);
                const newRange = document.createRange();
                newRange.setStart(textNode, 1);
                newRange.collapse(true);
                sel.removeAllRanges();
                sel.addRange(newRange);
              }
            } else {
              const span = document.createElement('span');
              span.className = 'eng-text';
              span.setAttribute('data-eng', 'true');
              span.textContent = e.key;
              range.deleteContents();
              range.insertNode(span);
              const newRange = document.createRange();
              newRange.setStart(span.firstChild, 1);
              newRange.collapse(true);
              sel.removeAllRanges();
              sel.addRange(newRange);
            }
          }
          runConversion();
          return;
        } else if (typingLayout === 'preeti') {
          const sel = window.getSelection();
          if (sel && sel.rangeCount > 0) {
            const range = sel.getRangeAt(0);
            let container = range.startContainer;
            let parentEl = container.nodeType === 1 ? container : container.parentElement;
            let engSpan = parentEl ? parentEl.closest('.eng-text, [data-eng="true"]') : null;

            let isAfterEngSpan = false;
            if (!engSpan) {
              if (container.nodeType === 3 && (range.startOffset === 0 || container.nodeValue.length === 0) && container.previousSibling) {
                const prev = container.previousSibling;
                if (prev.nodeType === 1 && (prev.getAttribute('data-eng') === 'true' || prev.classList.contains('eng-text'))) {
                  engSpan = prev;
                  isAfterEngSpan = true;
                }
              } else if (container.nodeType === 1 && range.startOffset > 0) {
                const prev = container.childNodes[range.startOffset - 1];
                if (prev && prev.nodeType === 1 && (prev.getAttribute('data-eng') === 'true' || prev.classList.contains('eng-text'))) {
                  engSpan = prev;
                  isAfterEngSpan = true;
                }
              }
            }

            // If caret is inside or touching an engSpan, forcefully insert character outside the span as plain Preeti text
            if (engSpan) {
              e.preventDefault();
              let char = e.key;

              let isAtStart = (range.startContainer === engSpan.firstChild && range.startOffset === 0);
              let isAtEnd = isAfterEngSpan ||
                            (range.startContainer === engSpan.firstChild && range.startOffset >= engSpan.textContent.length) ||
                            (range.startContainer === engSpan && range.startOffset >= engSpan.childNodes.length);

              if (isAtStart) {
                const textNode = document.createTextNode(char);
                engSpan.parentNode.insertBefore(textNode, engSpan);
                const newRange = document.createRange();
                newRange.setStart(textNode, 1);
                newRange.collapse(true);
                sel.removeAllRanges();
                sel.addRange(newRange);
              } else if (isAtEnd) {
                const nextNode = engSpan.nextSibling;
                if (nextNode && nextNode.nodeType === 3) {
                  nextNode.nodeValue = char + (nextNode.nodeValue || '');
                  const newRange = document.createRange();
                  newRange.setStart(nextNode, 1);
                  newRange.collapse(true);
                  sel.removeAllRanges();
                  sel.addRange(newRange);
                } else {
                  const textNode = document.createTextNode(char);
                  engSpan.parentNode.insertBefore(textNode, engSpan.nextSibling);
                  const newRange = document.createRange();
                  newRange.setStart(textNode, 1);
                  newRange.collapse(true);
                  sel.removeAllRanges();
                  sel.addRange(newRange);
                }
              } else {
                const fullText = engSpan.textContent;
                const offset = (range.startContainer === engSpan.firstChild) ? range.startOffset : fullText.length;
                const part1 = fullText.slice(0, offset);
                const part2 = fullText.slice(offset);
                engSpan.textContent = part1;
                const textNode = document.createTextNode(char);
                engSpan.parentNode.insertBefore(textNode, engSpan.nextSibling);
                if (part2.length > 0) {
                  const span2 = engSpan.cloneNode(false);
                  span2.textContent = part2;
                  engSpan.parentNode.insertBefore(span2, textNode.nextSibling);
                }
                const newRange = document.createRange();
                newRange.setStart(textNode, 1);
                newRange.collapse(true);
                sel.removeAllRanges();
                sel.addRange(newRange);
              }
              runConversion();
              return;
            }
          }

          // Smart Preeti Ligature: typing ' or " immediately after / creates authentic ru (?) and roo (¿)
          if (e.key === "'" || e.key === '"') {
            const sel2 = window.getSelection();
            if (sel2 && sel2.rangeCount > 0) {
              const range2 = sel2.getRangeAt(0);
              if (range2.startContainer.nodeType === 3 && range2.startOffset > 0) {
                const text = range2.startContainer.nodeValue;
                const charBefore = text.slice(range2.startOffset - 1, range2.startOffset);
                if (charBefore === '/') {
                  e.preventDefault();
                  const replacement = (e.key === "'") ? '?' : '¿';
                  range2.setStart(range2.startContainer, range2.startOffset - 1);
                  range2.deleteContents();
                  const textNode = document.createTextNode(replacement);
                  range2.insertNode(textNode);
                  const newRange = document.createRange();
                  newRange.setStartAfter(textNode);
                  newRange.collapse(true);
                  sel2.removeAllRanges();
                  sel2.addRange(newRange);
                  runConversion();
                  return;
                }
              }
            }
          }
        }
      });

      // Real-time conversion on keystroke
      let debounceTimer = null;
      editorInput.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(runConversion, 15);
      });

      // Handle pasting Unicode directly into Preeti box
      editorInput.addEventListener('paste', (e) => {
        const text = e.clipboardData?.getData('text/plain') || '';
        if (hasDevanagari(text)) {
          e.preventDefault();
          const preetiAscii = toPreeti(text);
          document.execCommand('insertText', false, preetiAscii);
          showToast('Converted pasted Unicode to Preeti Visual');
          runConversion();
        }
      });

      // Toolbar formatting commands
      fmtButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const cmd = btn.dataset.cmd;
          const val = btn.dataset.val || null;
          editorInput.focus();
          document.execCommand(cmd, false, val);
          runConversion();
        });
      });

      // Mode Switch & Text Swap to Unicode to Preeti
      function switchAndSwapToUnicodeToPreeti() {
        const textToCarry = (editorOutput && editorOutput.innerHTML.trim())
          ? editorOutput.innerHTML
          : (editorInput ? editorInput.innerHTML : '');
        if (textToCarry) {
          sessionStorage.setItem('tn_converter_swap_text', textToCarry);
        }
        window.location.href = '/unicode-to-preeti/';
      }

      if (modeBtnUniToPreeti) {
        modeBtnUniToPreeti.addEventListener('click', switchAndSwapToUnicodeToPreeti);
      }
      if (swapModeBtn) {
        swapModeBtn.addEventListener('click', switchAndSwapToUnicodeToPreeti);
      }

      // Typing Layout Switcher Dropdown (Inside Input Pane)
      if (selectTypingLayout) {
        selectTypingLayout.addEventListener('change', (e) => {
          typingLayout = e.target.value;
          if (typingLayout === 'preeti') {
            breakOutOfEngSpan();
          }
          const name = e.target.options[e.target.selectedIndex].text;
          showToast(`Layout: ${name}`);
        });
      }

      // Preeti View Toggle (Input Pane)
      if (btnToggleInputFont) {
        btnToggleInputFont.addEventListener('click', () => {
          inputPreetiVisual = !inputPreetiVisual;
          applyPreetiVisualState();
        });
      }

      // Font Size Controls
      if (btnFontSmaller) {
        btnFontSmaller.addEventListener('click', () => setEditorFontSize(currentFontSize - 2));
      }
      if (btnFontLarger) {
        btnFontLarger.addEventListener('click', () => setEditorFontSize(currentFontSize + 2));
      }

      // Sample Text
      btnSampleText.addEventListener('click', () => {
        editorInput.innerHTML = getSampleGuidePreeti();
        runConversion();
        showToast('Loaded complete usage guide');
      });

      // Paste Button
      btnPasteInput.addEventListener('click', async () => {
        try {
          const text = await navigator.clipboard.readText();
          if (text) {
            editorInput.focus();
            if (hasDevanagari(text)) {
              const preetiAscii = toPreeti(text);
              document.execCommand('insertText', false, preetiAscii);
            } else {
              document.execCommand('insertText', false, text);
            }
            runConversion();
          }
        } catch {
          editorInput.focus();
        }
      });

      // Clear Button
      btnClearInput.addEventListener('click', () => {
        editorInput.innerHTML = '';
        editorOutput.innerHTML = '';
        if (inputCharCount) inputCharCount.textContent = '0';
        if (inputWordCount) inputWordCount.textContent = '0';
        if (outputCharCount) outputCharCount.textContent = '0';
        if (outputWordCount) outputWordCount.textContent = '0';
        editorInput.focus();
      });

      // Copy Formatted (Word & Google Docs)
      btnCopyRich.addEventListener('click', async () => {
        const htmlData = editorOutput.innerHTML;
        const textData = editorOutput.innerText || '';
        if (!textData.trim()) return;

        try {
          if (navigator.clipboard && window.ClipboardItem) {
            const blobHtml = new Blob([htmlData], { type: 'text/html' });
            const blobText = new Blob([textData], { type: 'text/plain' });
            await navigator.clipboard.write([
              new ClipboardItem({
                'text/html': blobHtml,
                'text/plain': blobText
              })
            ]);
            showToast('Copied formatted text for Word & Google Docs');
          } else {
            await navigator.clipboard.writeText(textData);
            showToast('Copied to clipboard');
          }
        } catch {
          const range = document.createRange();
          range.selectNodeContents(editorOutput);
          const sel = window.getSelection();
          sel.removeAllRanges();
          sel.addRange(range);
          document.execCommand('copy');
          sel.removeAllRanges();
          showToast('Copied to clipboard');
        }
      });

      // Copy Plain Text
      btnCopyPlain.addEventListener('click', async () => {
        const textData = editorOutput.innerText || '';
        if (!textData.trim()) return;
        try {
          await navigator.clipboard.writeText(textData);
          showToast('Copied plain text');
        } catch {
          const temp = document.createElement('textarea');
          temp.value = textData;
          document.body.appendChild(temp);
          temp.select();
          document.execCommand('copy');
          document.body.removeChild(temp);
          showToast('Copied plain text');
        }
      });

      // Download Formatted Word Document (.doc with bilingual font preserved)
      if (btnDownloadDoc) {
        btnDownloadDoc.addEventListener('click', () => {
          const htmlContent = editorOutput.innerHTML;
          if (!htmlContent.trim()) return;

          const docHtml = `<!DOCTYPE html>
<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
<head>
<meta charset='utf-8'>
<title>Nepali Unicode Document</title>
<!--[if gte mso 9]>
<xml>
  <w:WordDocument>
    <w:View>Print</w:View>
    <w:Zoom>100</w:Zoom>
    <w:DoNotOptimizeForBrowser/>
  </w:WordDocument>
</xml>
<![endif]-->
<style>
  body {
    font-family: 'Mukta', 'Kalimati', 'Kokila', Arial, sans-serif;
    font-size: 14pt;
    line-height: 1.6;
    color: #000000;
  }
  .eng-text {
    font-family: Arial, Calibri, sans-serif !important;
  }
  h1, h2, h3, h4 {
    font-family: 'Mukta', 'Kalimati', Arial, sans-serif;
    color: #000000;
  }
  p { margin: 0 0 10pt 0; }
  ul, ol { margin-bottom: 10pt; }
</style>
</head>
<body>
  ${htmlContent}
</body>
</html>`;

          const blob = new Blob(['\ufeff', docHtml], { type: 'application/msword;charset=utf-8' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = 'nepali-unicode.doc';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
          showToast('Downloaded Word document (formatting preserved)');
        });
      }

      // Download Plain Text (.txt)
      btnDownloadTxt.addEventListener('click', () => {
        const textData = editorOutput.innerText || '';
        if (!textData.trim()) return;
        const blob = new Blob([textData], { type: 'text/plain;charset=utf-8' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'nepali-unicode.txt';
        a.click();
        URL.revokeObjectURL(a.href);
        showToast('Downloaded nepali-unicode.txt');
      });

      // Print Document
      btnPrintDoc.addEventListener('click', () => {
        const printWin = window.open('', '', 'width=840,height=640');
        if (!printWin) return;
        printWin.document.write(`
          <!DOCTYPE html>
          <html>
            <head>
              <title>TopNepali Document Print</title>
              <style>
                body { font-family: 'Font_kokila', 'Mukta', -apple-system, sans-serif; padding: 40px; line-height: 1.8; color: #111; font-size: 18px; }
                .eng-text { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important; }
                h1, h2, h3 { color: #000; margin-top: 1.5em; margin-bottom: 0.5em; }
              </style>
            </head>
            <body>
              ${editorOutput.innerHTML}
            </body>
          </html>
        `);
        printWin.document.close();
        printWin.focus();
        printWin.print();
        printWin.close();
      });

      // Initial execution (respecting swapped carryover text from sessionStorage)
      setEditorFontSize(20);
      applyPreetiVisualState();

      const carriedSwapText = sessionStorage.getItem('tn_converter_swap_text');
      if (carriedSwapText) {
        sessionStorage.removeItem('tn_converter_swap_text');
        editorInput.innerHTML = carriedSwapText;
        runConversion();
        showToast('Swapped text successfully');
      } else {
        editorInput.innerHTML = getSampleGuidePreeti();
        runConversion();
      }
    })();
  </script>
</Layout>
