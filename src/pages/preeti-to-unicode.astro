---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Preeti to Unicode Converter — Real-Time Nepali Font & Rich Text Converter";
const pageDesc = "Free online bidirectional Preeti to Nepali Unicode converter. Convert formatted text, preserve bold and headings for Word & Google Docs, download documents, and access instant key cheat sheets.";
const canonicalUrl = "https://typing.topnepali.com/preeti-to-unicode";
const ogImageUrl = "https://img.topnepali.com/typing.tn/og/preeti-svg.webp";
const keywords = "Preeti to Unicode, Preeti to Unicode converter, Unicode to Preeti, Nepali font converter, Nepali Unicode converter online, Kantipur to Unicode, rich text Preeti converter, Preeti font keyboard chart, Loksewa Preeti converter";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How does the Preeti to Unicode converter preserve text formatting?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Unlike standard converters that strip text styling down to plain text, TopNepali's rich text converter traverses the DOM text nodes while maintaining HTML markup. When you copy with 'Copy Formatted', styling such as bold, italics, headings, and bullet points remain intact when pasted into Microsoft Word, Google Docs, or CMS platforms."
      }
    },
    {
      "@type": "Question",
      "name": "Why is Nepali Unicode preferred over Preeti font?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Preeti is a legacy ASCII-mapped font where English characters are visually replaced by Devanagari shapes. Without the Preeti font file installed, text appears as unreadable English symbols. Nepali Unicode is a global ISO standard supported natively across all operating systems, smartphones, search engines, and web browsers without requiring font downloads."
      }
    },
    {
      "@type": "Question",
      "name": "How do I type complex characters like श्रीमान् or काठमाडौँ in Preeti?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In Preeti: श्रीमान् is typed as >Ldfg\\ (Shift + . for श्र, Shift + L for ी, d for म, f for ा, g for न, and backslash for हलन्त). काठमाडौँ is typed as sf7df8f}+ (s for क, f for ा, 7 for ठ, d for म, 8 for ड, f} for ौ, and + for ँ)."
      }
    },
    {
      "@type": "Question",
      "name": "Can I convert Nepali Unicode back to Preeti font?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Click the 'Switch Conversion Mode' button or the Swap icon to instantly convert standard Unicode Devanagari text back into legacy Preeti ASCII characters."
      }
    }
  ]
};

const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Preeti to Unicode Converter by TopNepali",
  "url": canonicalUrl,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "NPR"
  },
  "description": pageDesc
};
---

<Layout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl={canonicalUrl}
  ogImage={ogImageUrl}
  keywords={keywords}
  schema={[appSchema, faqSchema]}
  activeNav="converter"
>
  <div class="converter-wrapper py-4 sm:py-6">

    <!-- Hero Header -->
    <header class="text-center max-w-3xl mx-auto pt-2 pb-6">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20 mb-2.5">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="16 3 21 3 21 8"></polyline>
          <line x1="4" y1="20" x2="21" y2="3"></line>
          <polyline points="21 16 21 21 16 21"></polyline>
          <line x1="15" y1="15" x2="21" y2="21"></line>
          <line x1="4" y1="4" x2="9" y2="9"></line>
        </svg>
        <span>BIDIRECTIONAL &amp; RICH TEXT COMPATIBLE</span>
      </div>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold font-display tracking-tight text-[var(--text-primary)]">
        Preeti to Unicode <span class="text-rose-600">Converter</span>
      </h1>
      <p class="mt-2 text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
        Convert legacy Preeti font text to standard Nepali Unicode in real-time. Retain bold, italic, headings, and list formatting when pasting into Word or Google Docs.
      </p>
    </header>

    <!-- Master Converter Toolbar -->
    <div class="converter-toolbar">
      <!-- Mode Switcher & Swap Chords -->
      <div class="flex items-center gap-1.5 flex-wrap">
        <div class="inline-flex p-1 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
          <button
            type="button"
            id="mode-preeti-to-uni"
            class="converter-btn converter-btn-primary"
            data-mode="toUnicode"
          >
            Preeti &rarr; Unicode
          </button>
          <button
            type="button"
            id="mode-uni-to-preeti"
            class="converter-btn"
            data-mode="toPreeti"
          >
            Unicode &rarr; Preeti
          </button>
        </div>

        <button
          type="button"
          id="swap-mode-btn"
          class="converter-btn p-2"
          title="Swap Input and Output Text"
          aria-label="Swap Input and Output"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 16V4m0 0L3 8m4-4l4 4m6 4v12m0 0l4-4m-4 4l-4-4"></path>
          </svg>
        </button>

        <!-- Manual Convert Action Button -->
        <button
          type="button"
          id="btn-convert-now"
          class="converter-btn converter-btn-primary font-bold px-3 py-1.5 flex items-center gap-1"
          title="Convert text immediately"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          <span>Convert Now</span>
        </button>
      </div>

      <!-- In-Browser Typing Engine Layout Selector (With Alt+Shift chord) -->
      <div class="flex items-center gap-2 flex-wrap">
        <span class="text-xs font-semibold text-[var(--text-muted)]">Typing Layout:</span>
        <select
          id="select-typing-layout"
          class="converter-btn text-xs font-medium cursor-pointer bg-[var(--bg-surface)] text-[var(--text-primary)] border border-[var(--border-subtle)] rounded-lg py-1 px-2 outline-none"
        >
          <option value="preeti" selected>Preeti Typewriter (ASCII)</option>
          <option value="traditional">Nepali Unicode (Traditional)</option>
          <option value="romanized">Nepali Unicode (Romanized)</option>
          <option value="english">English QWERTY</option>
        </select>
        <span class="text-[10px] font-mono text-[var(--text-muted)] border border-[var(--border-subtle)] px-1.5 py-0.5 rounded bg-[var(--bg-surface-subtle)] hidden sm:inline-block" title="Press Left Alt + Left Shift to toggle keyboard layout anytime">
          Left Alt+Shift
        </span>
      </div>

      <!-- Rich Text Formatting Actions -->
      <div class="flex items-center gap-1 bg-[var(--bg-surface-subtle)] p-1 rounded-xl border border-[var(--border-subtle)] flex-wrap">
        <button type="button" class="converter-btn fmt-btn p-1.5" data-cmd="bold" title="Bold (Ctrl+B)">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"></path><path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"></path></svg>
        </button>
        <button type="button" class="converter-btn fmt-btn p-1.5" data-cmd="italic" title="Italic (Ctrl+I)">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="4" x2="10" y2="4"></line><line x1="14" y1="20" x2="5" y2="20"></line><line x1="15" y1="4" x2="9" y2="20"></line></svg>
        </button>
        <button type="button" class="converter-btn fmt-btn p-1.5" data-cmd="underline" title="Underline (Ctrl+U)">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 3v7a6 6 0 0 0 6 6 6 6 0 0 0 6-6V3"></path><line x1="4" y1="21" x2="20" y2="21"></line></svg>
        </button>

        <div class="converter-divider"></div>

        <button type="button" class="converter-btn fmt-btn px-2 py-1 font-bold text-xs" data-cmd="formatBlock" data-val="h2" title="Heading 2">H2</button>
        <button type="button" class="converter-btn fmt-btn px-2 py-1 font-bold text-xs" data-cmd="formatBlock" data-val="h3" title="Heading 3">H3</button>

        <div class="converter-divider"></div>

        <button type="button" class="converter-btn fmt-btn p-1.5" data-cmd="insertUnorderedList" title="Bullet List">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
        </button>
        <button type="button" class="converter-btn fmt-btn p-1.5" data-cmd="insertOrderedList" title="Numbered List">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="10" y1="6" x2="21" y2="6"></line><line x1="10" y1="12" x2="21" y2="12"></line><line x1="10" y1="18" x2="21" y2="18"></line><path d="M4 6h1v4"></path><path d="M4 10h2"></path><path d="M6 18H4c0-1 2-2 2-3s-1-1.5-2-1"></path></svg>
        </button>
        <button type="button" class="converter-btn fmt-btn p-1.5" data-cmd="removeFormat" title="Clear Formatting">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>

        <div class="converter-divider"></div>

        <!-- Font Size Scaler -->
        <div class="flex items-center gap-1">
          <button type="button" id="btn-font-smaller" class="converter-btn px-1.5 py-0.5 text-xs font-bold" title="Decrease font size">A-</button>
          <span id="label-font-size" class="text-xs font-mono text-[var(--text-muted)] min-w-[32px] text-center font-bold">20px</span>
          <button type="button" id="btn-font-larger" class="converter-btn px-1.5 py-0.5 text-xs font-bold" title="Increase font size">A+</button>
        </div>
      </div>
    </div>

    <!-- Dual-Pane Workspace Grid -->
    <div class="converter-grid">
      <!-- Input Pane -->
      <div class="converter-pane">
        <div class="converter-pane-header">
          <div class="flex items-center gap-2">
            <span id="input-label" class="font-bold uppercase tracking-wider text-xs text-[var(--text-primary)]">
              Preeti Text Input
            </span>
            <button
              type="button"
              id="btn-toggle-input-font"
              class="converter-pill border border-rose-500/30 text-rose-600 dark:text-rose-400 bg-rose-500/10 cursor-pointer"
              title="Toggle between authentic Nepali Visual rendering and Raw ASCII characters"
            >
              <svg class="w-3 h-3 text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
              <span id="input-font-tag">Nepali Visual</span>
            </button>
          </div>

          <div class="flex items-center gap-1.5">
            <button type="button" id="btn-sample-text" class="converter-btn text-xs">Sample</button>
            <button type="button" id="btn-paste-input" class="converter-btn text-xs">Paste</button>
            <button type="button" id="btn-clear-input" class="converter-btn text-xs text-rose-600 hover:text-rose-700">Clear</button>
          </div>
        </div>

        <!-- Editable Input Content Area -->
        <div
          id="editor-input"
          contenteditable="true"
          spellcheck="false"
          class="converter-editor font-preeti select-text"
          data-placeholder="Type or paste Preeti text here..."
        ></div>

        <div class="converter-pane-footer">
          <div class="flex items-center gap-4">
            <span>Characters: <strong id="input-char-count" class="text-[var(--text-primary)]">0</strong></span>
            <span>Words: <strong id="input-word-count" class="text-[var(--text-primary)]">0</strong></span>
          </div>
          <span class="text-xs text-[var(--text-muted)] flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block animate-pulse"></span>
            Real-time live conversion
          </span>
        </div>
      </div>

      <!-- Output Pane -->
      <div class="converter-pane">
        <div class="converter-pane-header">
          <div class="flex items-center gap-2">
            <span id="output-label" class="font-bold uppercase tracking-wider text-xs text-[var(--text-primary)]">
              Nepali Unicode Output
            </span>
            <button
              type="button"
              id="btn-toggle-output-font"
              class="converter-pill border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 cursor-pointer"
              title="Output character encoding"
            >
              <span id="output-font-tag">UTF-8 UNICODE</span>
            </button>
          </div>

          <div class="flex items-center gap-1.5 flex-wrap">
            <button
              type="button"
              id="btn-copy-rich"
              class="converter-btn converter-btn-success text-xs font-bold"
              title="Copy formatted text with bold, italic, and headings preserved for Word / Google Docs"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span>Copy Formatted</span>
            </button>
            <button type="button" id="btn-copy-plain" class="converter-btn text-xs">Copy Plain</button>
            <button type="button" id="btn-download-txt" class="converter-btn text-xs">Download</button>
            <button type="button" id="btn-print-doc" class="converter-btn text-xs">Print</button>
          </div>
        </div>

        <!-- Converted Output Area -->
        <div
          id="editor-output"
          contenteditable="true"
          spellcheck="false"
          class="converter-editor font-nepali select-text"
          data-placeholder="Converted text appears here instantly..."
        ></div>

        <div class="converter-pane-footer">
          <div class="flex items-center gap-4">
            <span>Characters: <strong id="output-char-count" class="text-[var(--text-primary)]">0</strong></span>
            <span>Words: <strong id="output-word-count" class="text-[var(--text-primary)]">0</strong></span>
          </div>
          <div id="copy-status-indicator" class="font-bold text-emerald-600 dark:text-emerald-400 opacity-0 transition-opacity">
            Copied to clipboard
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Reference Cheat Sheet Table -->
    <section class="bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-2xl p-6 sm:p-8 shadow-sm mb-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6 pb-4 border-b border-[var(--border-subtle)]">
        <div>
          <h2 class="text-lg font-bold font-display text-[var(--text-primary)]">
            Frequently Used Preeti Character Codes
          </h2>
          <p class="text-xs text-[var(--text-muted)] mt-0.5">
            Quick reference keystrokes for tricky ligatures, half letters, and symbols.
          </p>
        </div>
        <a 
          href="/keyboard-layout" 
          class="inline-flex items-center gap-1.5 text-xs font-bold text-rose-600 dark:text-rose-400 hover:underline"
        >
          <span>View Full Keyboard Layout Visualizer</span>
          <span>&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 text-xs">
        <div class="p-3 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
          <span class="text-[10px] text-[var(--text-muted)] block uppercase font-bold">श्र (Shree)</span>
          <div class="mt-1 font-mono font-bold text-base text-[var(--text-primary)]">&gt;</div>
          <span class="text-[10px] text-[var(--text-secondary)]">Shift + .</span>
        </div>

        <div class="p-3 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
          <span class="text-[10px] text-[var(--text-muted)] block uppercase font-bold">ज्ञ (Gya)</span>
          <div class="mt-1 font-mono font-bold text-base text-[var(--text-primary)]">1</div>
          <span class="text-[10px] text-[var(--text-secondary)]">Key 1</span>
        </div>

        <div class="p-3 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
          <span class="text-[10px] text-[var(--text-muted)] block uppercase font-bold">क्ष (Kshya)</span>
          <div class="mt-1 font-mono font-bold text-base text-[var(--text-primary)]">If</div>
          <span class="text-[10px] text-[var(--text-secondary)]">Shift + I then F</span>
        </div>

        <div class="p-3 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
          <span class="text-[10px] text-[var(--text-muted)] block uppercase font-bold">त्र (Tra)</span>
          <div class="mt-1 font-mono font-bold text-base text-[var(--text-primary)]">q</div>
          <span class="text-[10px] text-[var(--text-secondary)]">Key Q</span>
        </div>

        <div class="p-3 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
          <span class="text-[10px] text-[var(--text-muted)] block uppercase font-bold">द्द (Dda)</span>
          <div class="mt-1 font-mono font-bold text-base text-[var(--text-primary)]">2</div>
          <span class="text-[10px] text-[var(--text-secondary)]">Key 2</span>
        </div>

        <div class="p-3 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
          <span class="text-[10px] text-[var(--text-muted)] block uppercase font-bold">द्ध (Ddha)</span>
          <div class="mt-1 font-mono font-bold text-base text-[var(--text-primary)]">4</div>
          <span class="text-[10px] text-[var(--text-secondary)]">Key 4</span>
        </div>

        <div class="p-3 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
          <span class="text-[10px] text-[var(--text-muted)] block uppercase font-bold">त्त (Tta)</span>
          <div class="mt-1 font-mono font-bold text-base text-[var(--text-primary)]">Q</div>
          <span class="text-[10px] text-[var(--text-secondary)]">Shift + Q</span>
        </div>

        <div class="p-3 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
          <span class="text-[10px] text-[var(--text-muted)] block uppercase font-bold">रु (Ru)</span>
          <div class="mt-1 font-mono font-bold text-base text-[var(--text-primary)]">?</div>
          <span class="text-[10px] text-[var(--text-secondary)]">Shift + /</span>
        </div>

        <div class="p-3 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
          <span class="text-[10px] text-[var(--text-muted)] block uppercase font-bold">हृ (Hri)</span>
          <div class="mt-1 font-mono font-bold text-base text-[var(--text-primary)]">x[</div>
          <span class="text-[10px] text-[var(--text-secondary)]">Key X then [</span>
        </div>

        <div class="p-3 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
          <span class="text-[10px] text-[var(--text-muted)] block uppercase font-bold">ॐ (Om)</span>
          <div class="mt-1 font-mono font-bold text-base text-[var(--text-primary)]">ç</div>
          <span class="text-[10px] text-[var(--text-secondary)]">Alt + 0231</span>
        </div>

        <div class="p-3 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
          <span class="text-[10px] text-[var(--text-muted)] block uppercase font-bold">। (Purna Biram)</span>
          <div class="mt-1 font-mono font-bold text-base text-[var(--text-primary)]">.</div>
          <span class="text-[10px] text-[var(--text-secondary)]">Period Key</span>
        </div>

        <div class="p-3 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
          <span class="text-[10px] text-[var(--text-muted)] block uppercase font-bold">हलन्त (Halanta)</span>
          <div class="mt-1 font-mono font-bold text-base text-[var(--text-primary)]">\</div>
          <span class="text-[10px] text-[var(--text-secondary)]">Backslash Key</span>
        </div>
      </div>
    </section>

    <!-- Detailed FAQ Section -->
    <section class="bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-2xl p-6 sm:p-8 shadow-sm">
      <h2 class="text-lg font-bold font-display text-[var(--text-primary)] mb-4">
        Frequently Asked Questions
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs sm:text-sm">
        <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
          <h3 class="font-bold text-[var(--text-primary)] mb-1.5">How does formatting preservation work?</h3>
          <p class="text-[var(--text-secondary)] leading-relaxed">
            Standard converters convert text into flat unstyled strings, erasing bold titles, bullet points, and paragraph splits. Our rich text engine parses HTML nodes and converts only the inner text tokens, allowing you to copy formatted rich text directly into Microsoft Word or Google Docs.
          </p>
        </div>

        <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
          <h3 class="font-bold text-[var(--text-primary)] mb-1.5">Why does Preeti text appear as English gibberish?</h3>
          <p class="text-[var(--text-secondary)] leading-relaxed">
            Preeti was engineered in the early 1990s as an ASCII font override. It hijacks standard English keyboard codepoints (like 'k' for क and 'v' for ख). If an operating system lacks the Preeti font file, it defaults back to standard Latin characters.
          </p>
        </div>

        <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
          <h3 class="font-bold text-[var(--text-primary)] mb-1.5">Is Nepali Unicode accepted in Loksewa and Court exams?</h3>
          <p class="text-[var(--text-secondary)] leading-relaxed">
            Yes. The Public Service Commission (Loksewa Aayog), the Supreme Court of Nepal, and all federal ministries now strictly mandate standard Nepali Unicode for electronic documentation, portals, and computer examination skills tests.
