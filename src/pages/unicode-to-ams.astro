---
import Layout from '../layouts/Layout.astro';
import '../styles/ams-font.css';

const pageTitle = "Unicode to AMS Converter — Nepali Unicode to IndiaFont AMS Calligraphy";
const pageDesc = "Convert standard Nepali Unicode Devanagari text into IndiaFont AMS ASCII keystrokes for Adobe Photoshop, Illustrator, and CorelDRAW calligraphy design.";
const canonicalUrl = "https://typing.topnepali.com/unicode-to-ams";
const ogImageUrl = "https://img.topnepali.com/typing.tn/og/default-svg.webp";
const keywords = "Unicode to AMS, Unicode to AMS converter, Indiafont converter, Nepali Unicode to AMS font, AMS calligraphy typing, convert Unicode to AMS Mantra, Photoshop Nepali calligraphy";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Why do graphic designers convert Nepali Unicode to AMS fonts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Graphic designers and flex printing shops use IndiaFont AMS typefaces (such as AMS Mantra, AMS Kirti, AMS Aaditya, AMS Hastkala) for exquisite wedding cards, banners, and logos in Adobe Photoshop and CorelDRAW. Because those applications cannot apply AMS calligraphy styles directly to standard Unicode, designers convert Unicode into AMS ASCII keystrokes and paste them into their design canvas with the AMS font family selected."
      }
    },
    {
      "@type": "Question",
      "name": "How do I use converted AMS text in Adobe Photoshop, Illustrator, or CorelDRAW?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "After typing or pasting your Nepali text, click 'Copy ASCII'. Open Photoshop or CorelDRAW, create a text box, select an installed AMS font (such as AMS Mantra or AMS Kirti) in the font dropdown, and paste (Ctrl+V). The calligraphy letters and ligatures will align seamlessly."
      }
    },
    {
      "@type": "Question",
      "name": "Can I type Nepali if I don't have a Nepali keyboard installed?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Our built-in in-browser typing engine intercepts standard English QWERTY keyboard keystrokes. Select 'Nepali Traditional' or 'Nepali Romanized' in the Typing Layout dropdown to type directly in Devanagari Unicode without installing any software."
      }
    },
    {
      "@type": "Question",
      "name": "Can I type mixed English words or brand names while writing Nepali?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Press Left Alt + Left Shift anytime or switch to English QWERTY in the typing layout to type English terms like (TopNepali) or brand names seamlessly. English words are automatically isolated and preserved without being scrambled."
      }
    }
  ]
};

const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Unicode to AMS Converter by TopNepali",
  "url": canonicalUrl,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "NPR"
  },
  "description": pageDesc
};
---

<Layout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl={canonicalUrl}
  ogImage={ogImageUrl}
  keywords={keywords}
  schema={[appSchema, faqSchema]}
  activeNav="converter"
>
  <div class="converter-wrapper py-4 sm:py-6">

    <!-- Hero Header -->
    <header class="text-center max-w-3xl mx-auto pt-2 pb-6">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 mb-2.5">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="16 3 21 3 21 8"></polyline>
          <line x1="4" y1="20" x2="21" y2="3"></line>
          <polyline points="21 16 21 21 16 21"></polyline>
          <line x1="15" y1="15" x2="21" y2="21"></line>
          <line x1="4" y1="4" x2="9" y2="9"></line>
        </svg>
        <span>CALLIGRAPHY COMPATIBILITY FOR PHOTOSHOP &amp; CORELDRAW</span>
      </div>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold font-display tracking-tight text-[var(--text-primary)]">
        Unicode to AMS <span class="text-amber-600 dark:text-amber-500">Converter</span>
      </h1>
      <p class="mt-2 text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
        Convert standard Nepali Unicode Devanagari text into IndiaFont AMS ASCII keystrokes for Adobe Photoshop, Illustrator, CorelDRAW, and calligraphy banner designs.
      </p>
    </header>

    <!-- Master Converter Toolbar -->
    <div class="converter-toolbar">
      <!-- Mode Switcher & Swap Chords -->
      <div class="flex items-center gap-1.5 flex-wrap">
        <div class="inline-flex p-1 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
          <button
            type="button"
            id="mode-ams-to-uni"
            class="converter-btn hover:bg-[var(--bg-surface)] cursor-pointer"
            title="Switch to AMS to Unicode Converter (swaps text automatically)"
          >
            AMS &rarr; Unicode
          </button>
          <button
            type="button"
            id="mode-uni-to-ams"
            class="converter-btn converter-btn-primary font-bold cursor-default pointer-events-none"
            title="Currently on Unicode to AMS Converter"
          >
            Unicode &rarr; AMS
          </button>
        </div>

        <button
          type="button"
          id="swap-mode-btn"
          class="converter-btn p-2 hover:bg-[var(--bg-surface)] cursor-pointer"
          title="Switch Converter and Swap Text"
          aria-label="Switch Converter and Swap Text"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 16V4m0 0L3 8m4-4l4 4m6 4v12m0 0l4-4m-4 4l-4-4"></path>
          </svg>
        </button>

        <a
          href="/unicode-to-preeti"
          class="converter-btn px-2.5 py-1 text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] border border-[var(--border-subtle)] rounded-xl"
          title="Switch to Unicode to Preeti Converter"
        >
          Unicode &harr; Preeti
        </a>
      </div>

      <!-- Rich Text Formatting Actions -->
      <div class="flex items-center gap-1 bg-[var(--bg-surface-subtle)] p-1 rounded-xl border border-[var(--border-subtle)] flex-wrap">
        <button type="button" class="converter-btn fmt-btn p-1.5" data-cmd="bold" title="Bold (Ctrl+B)">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"></path><path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"></path></svg>
        </button>
        <button type="button" class="converter-btn fmt-btn p-1.5" data-cmd="italic" title="Italic (Ctrl+I)">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="4" x2="10" y2="4"></line><line x1="14" y1="20" x2="5" y2="20"></line><line x1="15" y1="4" x2="9" y2="20"></line></svg>
        </button>
        <button type="button" class="converter-btn fmt-btn p-1.5" data-cmd="underline" title="Underline (Ctrl+U)">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 3v7a6 6 0 0 0 6 6 6 6 0 0 0 6-6V3"></path><line x1="4" y1="21" x2="20" y2="21"></line></svg>
        </button>

        <div class="converter-divider"></div>

        <button type="button" class="converter-btn fmt-btn px-2 py-1 font-bold text-xs" data-cmd="formatBlock" data-val="h2" title="Heading 2">H2</button>
        <button type="button" class="converter-btn fmt-btn px-2 py-1 font-bold text-xs" data-cmd="formatBlock" data-val="h3" title="Heading 3">H3</button>

        <div class="converter-divider"></div>

        <button type="button" class="converter-btn fmt-btn p-1.5" data-cmd="insertUnorderedList" title="Bullet List">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
        </button>
        <button type="button" class="converter-btn fmt-btn p-1.5" data-cmd="insertOrderedList" title="Numbered List">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="10" y1="6" x2="21" y2="6"></line><line x1="10" y1="12" x2="21" y2="12"></line><line x1="10" y1="18" x2="21" y2="18"></line><path d="M4 6h1v4"></path><path d="M4 10h2"></path><path d="M6 18H4c0-1 2-2 2-3s-1-1.5-2-1"></path></svg>
        </button>
        <button type="button" class="converter-btn fmt-btn p-1.5" data-cmd="removeFormat" title="Clear Formatting">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>

        <div class="converter-divider"></div>

        <!-- Font Size Scaler -->
        <div class="flex items-center gap-1">
          <button type="button" id="btn-font-smaller" class="converter-btn px-1.5 py-0.5 text-xs font-bold" title="Decrease font size">A-</button>
          <span id="label-font-size" class="text-xs font-mono text-[var(--text-muted)] min-w-[32px] text-center font-bold">20px</span>
          <button type="button" id="btn-font-larger" class="converter-btn px-1.5 py-0.5 text-xs font-bold" title="Increase font size">A+</button>
        </div>
      </div>
    </div>

    <!-- Dual-Pane Workspace Grid -->
    <div class="converter-grid">
      <!-- Input Pane (Nepali Unicode) -->
      <div class="converter-pane">
        <div class="converter-pane-header">
          <div class="flex items-center gap-2 flex-wrap">
            <span id="input-label" class="font-bold uppercase tracking-wider text-xs text-[var(--text-primary)]">
              Nepali Unicode Input
            </span>

            <div class="converter-pill border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 bg-emerald-500/10">
              <span id="input-font-tag">UTF-8 UNICODE</span>
            </div>

            <!-- Typing Layout Selector for Unicode Pane -->
            <div class="inline-flex items-center gap-1 pl-1">
              <span class="text-xs font-semibold text-[var(--text-muted)] hidden sm:inline">Layout:</span>
              <select
                id="select-typing-layout"
                class="converter-btn text-xs font-semibold cursor-pointer bg-[var(--bg-surface)] text-[var(--text-primary)] border border-[var(--border-subtle)] rounded-lg py-0.5 px-2 outline-none"
                title="Select typing layout or press Left Alt + Left Shift to toggle"
              >
                <option value="traditional" selected>Nepali Traditional</option>
                <option value="romanized">Nepali Romanized</option>
                <option value="english">English QWERTY</option>
              </select>
              <button
                type="button"
                id="btn-quick-romanized"
                class="converter-btn text-xs font-semibold px-2 py-0.5 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 rounded-lg hover:bg-emerald-500/20 transition-colors"
                title="Quick switch to Romanized phonetic typing"
              >
                Romanized?
              </button>
              <span class="text-[10px] font-mono text-[var(--text-muted)] border border-[var(--border-subtle)] px-1.5 py-0.5 rounded bg-[var(--bg-surface-subtle)] hidden sm:inline-block" title="Press Left Alt + Left Shift to toggle Traditional / English">
                Alt+Shift
              </span>
            </div>
          </div>

          <div class="flex items-center gap-1.5">
            <button type="button" id="btn-sample-text" class="converter-btn text-xs">Sample Guide</button>
            <button type="button" id="btn-paste-input" class="converter-btn text-xs">Paste</button>
            <button type="button" id="btn-clear-input" class="converter-btn text-xs text-rose-600 hover:text-rose-700">Clear</button>
          </div>
        </div>

        <!-- Editable Input Content Area (Unicode) -->
        <div
          id="editor-input"
          contenteditable="true"
          spellcheck="false"
          class="converter-editor font-nepali select-text"
          data-font-nepali="true"
          data-placeholder="Type in Nepali Unicode (Traditional/Romanized/English) or paste text here..."
        ></div>

        <div class="converter-pane-footer">
          <div class="flex items-center gap-4">
            <span>Characters: <strong id="input-char-count" class="text-[var(--text-primary)]">0</strong></span>
            <span>Words: <strong id="input-word-count" class="text-[var(--text-primary)]">0</strong></span>
          </div>
          <span class="text-xs text-[var(--text-muted)] flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block animate-pulse"></span>
            Real-time live conversion
          </span>
        </div>
      </div>

      <!-- Output Pane (AMS Calligraphy) -->
      <div class="converter-pane">
        <div class="converter-pane-header">
          <div class="flex items-center gap-2">
            <span id="output-label" class="font-bold uppercase tracking-wider text-xs text-[var(--text-primary)]">
              AMS Calligraphy Output
            </span>
            <button
              type="button"
              id="btn-toggle-output-font"
              class="converter-pill border border-amber-500/30 text-amber-600 dark:text-amber-400 bg-amber-500/10 cursor-pointer"
              title="Toggle between authentic AMS Calligraphy visual preview and Raw ASCII keys"
            >
              <svg class="w-3 h-3 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
              <span id="output-font-tag">AMS Visual</span>
            </button>
          </div>

          <div class="flex items-center gap-1.5 flex-wrap">
            <button
              type="button"
              id="btn-copy-rich"
              class="converter-btn converter-btn-success text-xs font-bold"
              title="Copy formatted text with bold, italic, and headings preserved for Word / Google Docs"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span>Copy Formatted</span>
            </button>
            <button type="button" id="btn-copy-plain" class="converter-btn text-xs font-bold" title="Copy plain ASCII characters for Adobe Photoshop / CorelDRAW">Copy ASCII</button>

            <!-- Formatted Word Document Download -->
            <button
              type="button"
              id="btn-download-doc"
              class="converter-btn text-xs font-bold border-blue-500/40 text-blue-600 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-950/30"
              title="Download formatted Microsoft Word document (.doc) with headings, bold, and styles preserved"
            >
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
              <span>Word (.doc)</span>
            </button>

            <!-- Plain Text File Download -->
            <button type="button" id="btn-download-txt" class="converter-btn text-xs" title="Download plain text file">.txt</button>
            <button type="button" id="btn-print-doc" class="converter-btn text-xs">Print</button>
          </div>
        </div>

        <!-- Converted Output Area (AMS Visual by Default) -->
        <div
          id="editor-output"
          contenteditable="true"
          spellcheck="false"
          class="converter-editor font-ams select-text"
          data-ams-visual="true"
          data-placeholder="Converted AMS calligraphy text appears here instantly..."
        ></div>

        <div class="converter-pane-footer">
          <div class="flex items-center gap-4">
            <span>Characters: <strong id="output-char-count" class="text-[var(--text-primary)]">0</strong></span>
            <span>Words: <strong id="output-word-count" class="text-[var(--text-primary)]">0</strong></span>
          </div>
          <div id="copy-status-indicator" class="font-bold text-emerald-600 dark:text-emerald-400 opacity-0 transition-opacity">
            Copied to clipboard
          </div>
        </div>
      </div>
    </div>

    <!-- Educational & Technical Content -->
    <section class="mt-12 space-y-8">
      <div class="bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-2xl p-6 sm:p-8 shadow-sm">
        <h2 class="text-xl sm:text-2xl font-bold font-display text-[var(--text-primary)] mb-3">
          How to Use AMS Calligraphy Text in Photoshop &amp; CorelDRAW
        </h2>
        <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed mb-4">
          Many graphic design applications like <strong>Adobe Photoshop</strong>, <strong>Illustrator</strong>, and <strong>CorelDRAW</strong> cannot directly style standard Unicode text with decorative IndiaFont AMS typefaces. By converting your standard Nepali Unicode text to AMS ASCII keystrokes, you can copy the exact glyph sequences and style them effortlessly with authentic calligraphy fonts.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs sm:text-sm mt-4">
          <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
            <h3 class="font-bold text-[var(--text-primary)] mb-1">1. Type or Paste in Unicode</h3>
            <p class="text-[var(--text-muted)]">Type your headlines in standard Nepali Traditional or Romanized in the input box, or paste from Word.</p>
          </div>
          <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
            <h3 class="font-bold text-[var(--text-primary)] mb-1">2. Click 'Copy ASCII'</h3>
            <p class="text-[var(--text-muted)]">The button copies the raw keystroke sequence formatted specifically for AMS IndiaFont typography.</p>
          </div>
          <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
            <h3 class="font-bold text-[var(--text-primary)] mb-1">3. Select AMS Font in Design App</h3>
            <p class="text-[var(--text-muted)]">In Photoshop or CorelDRAW, select your installed font (e.g. AMS Mantra) and paste (Ctrl+V).</p>
          </div>
        </div>
      </div>

      <!-- Related Converters & Typography Ecosystem -->
      <div class="bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-2xl p-6 sm:p-8 shadow-sm">
        <h2 class="text-lg font-bold font-display text-[var(--text-primary)] mb-3">
          Explore Related Nepali Typing Tools &amp; Typography
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs sm:text-sm">
          <a href="/ams-to-unicode" class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)] hover:border-amber-500/40 transition-colors group">
            <h3 class="font-bold text-[var(--text-primary)] group-hover:text-amber-600 mb-1">AMS to Unicode Converter &rarr;</h3>
            <p class="text-[var(--text-muted)]">Convert existing AMS ASCII designs back into standard Devanagari Unicode.</p>
          </a>
          <a href="/unicode-to-preeti" class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)] hover:border-emerald-500/40 transition-colors group">
            <h3 class="font-bold text-[var(--text-primary)] group-hover:text-emerald-600 mb-1">Unicode to Preeti Converter &rarr;</h3>
            <p class="text-[var(--text-muted)]">Convert Unicode to Preeti for InDesign, PageMaker, and government DTP printing.</p>
          </a>
          <a href="https://fonts.topnepali.com" class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)] hover:border-blue-500/40 transition-colors group">
            <h3 class="font-bold text-[var(--text-primary)] group-hover:text-blue-600 mb-1">Download Nepali &amp; AMS Fonts &rarr;</h3>
            <p class="text-[var(--text-muted)]">Browse 500+ free Nepali fonts, calligraphy styles, and Unicode typefaces on FontsDir.</p>
          </a>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-2xl p-6 sm:p-8 shadow-sm mb-8">
        <h2 class="text-lg font-bold font-display text-[var(--text-primary)] mb-4">
          Frequently Asked Questions
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs sm:text-sm">
          <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
            <h3 class="font-bold text-[var(--text-primary)] mb-1.5">How do I paste AMS text into Photoshop or CorelDRAW?</h3>
            <p class="text-[var(--text-secondary)] leading-relaxed">
              Click 'Copy ASCII', switch to Adobe Photoshop or CorelDRAW, create a text box, choose an AMS font (like AMS Mantra or AMS Kirti) in the font selector, and paste. All calligraphy curves and ligatures render in authentic style.
            </p>
          </div>
          <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
            <h3 class="font-bold text-[var(--text-primary)] mb-1.5">Can I type Nepali without installing any keyboard?</h3>
            <p class="text-[var(--text-secondary)] leading-relaxed">
              Yes. The built-in typing layout engine intercepts keystrokes on standard English keyboards. Select 'Nepali Traditional' or 'Romanized' in the Typing Layout dropdown to type directly.
            </p>
          </div>
          <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
            <h3 class="font-bold text-[var(--text-primary)] mb-1.5">Does the converter handle halantas, ra-kars, and rephs?</h3>
            <p class="text-[var(--text-secondary)] leading-relaxed">
              Yes. Rephs ('र' + '्' + consonant) map to trailing 'Q', ra-kars map to 'X' ligatures, and half-letters match the official IndiaFont keymap.
            </p>
          </div>
          <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
            <h3 class="font-bold text-[var(--text-primary)] mb-1.5">Can I convert pasted AMS text back into Unicode?</h3>
            <p class="text-[var(--text-secondary)] leading-relaxed">
              Yes. Click the Swap button or visit our <a href="/ams-to-unicode" class="text-amber-600 dark:text-amber-400 underline font-semibold">AMS to Unicode Converter</a> to reverse the operation instantly.
            </p>
          </div>
        </div>
      </div>
    </section>

  </div>

  <div id="converter-toast" class="converter-toast"></div>

  <!-- Self-Contained In-Browser Converter & Typing Engine Script -->
  <script is:inline>
    (function initConverter() {
      // 1. Hardware Matrix for Traditional, Romanized & English Typing
      const KEY_CODE_MAP = {
        "Backquote":{"uni":["ञ","॥"],"rom":["़","ऽ"]},
        "Digit1":{"uni":["१","ज्ञ"],"rom":["१","!"]},
        "Digit2":{"uni":["२","ई"],"rom":["२","@"]},
        "Digit3":{"uni":["३","घ"],"rom":["३","#"]},
        "Digit4":{"uni":["४","द्ध"],"rom":["४","$"]},
        "Digit5":{"uni":["५","छ"],"rom":["५","%"]},
        "Digit6":{"uni":["६","ट"],"rom":["६","^"]},
        "Digit7":{"uni":["७","ठ"],"rom":["७","&"]},
        "Digit8":{"uni":["८","ड"],"rom":["८","*"]},
        "Digit9":{"uni":["९","ढ"],"rom":["९","("]},
        "Digit0":{"uni":["०","ण"],"rom":["०",")"]},
        "Minus":{"uni":["औ","ओ"],"rom":["-","_"]},
        "Equal":{"uni":["‍","‌"],"rom":["‍","‌"]},
        "KeyQ":{"uni":["त्र","त्त"],"rom":["ट","ठ"]},
        "KeyW":{"uni":["ध","ड्ढ"],"rom":["ौ","औ"]},
        "KeyE":{"uni":["भ","ऐ"],"rom":["े","ै"]},
        "KeyR":{"uni":["च","द्ब"],"rom":["र","ृ"]},
        "KeyT":{"uni":["त","ट्ट"],"rom":["त","थ"]},
        "KeyY":{"uni":["थ","ठ्ठ"],"rom":["य","ञ"]},
        "KeyU":{"uni":["ग","ऊ"],"rom":["ु","ू"]},
        "KeyI":{"uni":["ष","क्ष"],"rom":["ि","ी"]},
        "KeyO":{"uni":["य","इ"],"rom":["ो","ओ"]},
        "KeyP":{"uni":["उ","ए"],"rom":["प","फ"]},
        "BracketLeft":{"uni":["र्","ृ"],"rom":["इ","ई"]},
        "BracketRight":{"uni":["े","ै"],"rom":["ए","ऐ"]},
        "Backslash":{"uni":["्","ं"],"rom":["ॐ","ः"]},
        "KeyA":{"uni":["ब","आ"],"rom":["ा","आ"]},
        "KeyS":{"uni":["क","ङ्क"],"rom":["स","श"]},
        "KeyD":{"uni":["म","ङ्ग"],"rom":["द","ध"]},
        "KeyF":{"uni":["ा","ँ"],"rom":["उ","ऊ"]},
        "KeyG":{"uni":["न","द्द"],"rom":["ग","घ"]},
        "KeyH":{"uni":["ज","झ"],"rom":["ह","अ"]},
        "KeyJ":{"uni":["व","ो"],"rom":["ज","झ"]},
        "KeyK":{"uni":["प","फ"],"rom":["क","ख"]},
        "KeyL":{"uni":["ि","ी"],"rom":["ल","॥"]},
        "Semicolon":{"uni":["स","ट्ठ"],"rom":[";",":"]},
        "Quote":{"uni":["ु","ू"],"rom":["'","\""]},
        "KeyZ":{"uni":["श","क्क"],"rom":["ष","ऋ"]},
        "KeyX":{"uni":["ह","ह्य"],"rom":["ड","ढ"]},
        "KeyC":{"uni":["अ","ऋ"],"rom":["च","छ"]},
        "KeyV":{"uni":["ख","ॐ"],"rom":["व","ँ"]},
        "KeyB":{"uni":["द","ौ"],"rom":["ब","भ"]},
        "KeyN":{"uni":["ल","द्य"],"rom":["न","ण"]},
        "KeyM":{"uni":["ः","ड्ड"],"rom":["म","ं"]},
        "Comma":{"uni":["ऽ","ङ"],"rom":[",","ङ"]},
        "Period":{"uni":["।","श्र"],"rom":["।","."]},
        "Slash":{"uni":["र","रु"],"rom":["्","?"]},
        "Space":{"uni":[" "," "],"rom":[" "," "]}
      };

      // 2. Comprehensive AMS IndiaFont <-> Unicode Character & Ligature Tables
      const CONSONANTS = {
        'क': 'k', 'ख': 'Ka', 'ग': 'ga', 'घ': 'Ga', 'ङ': 'ङ',
        'च': 'ca', 'छ': 'C', 'ज': 'ja', 'झ': 'Ja', 'ञ': 'ञ',
        'ट': 'o', 'ठ': 'O', 'ड': 'D', 'ढ': 'Z', 'ण': 'Na',
        'त': 'ta', 'थ': 'Ta', 'द': 'd', 'ध': 'Ya', 'न': 'na',
        'प': 'pa', 'फ': 'f', 'ब': 'ba', 'भ': 'Ba', 'म': 'ma',
        'य': 'ya', 'र': 'r', 'ल': 'la', 'व': 'va', 'श': 'Sa',
        'ष': 'Va', 'स': 'sa', 'ह': 'h', 'क्ष': 'Ha', 'त्र': 'Pa', 'ज्ञ': 'za',
        'श्र': 'SaX'
      };

      const HALF_CONSONANTS = {
        'क्': '|', 'ख्': 'K', 'ग्': 'g', 'घ्': 'G', 'ङ्': 'ङ्',
        'च्': 'c', 'ज्': 'j', 'त्': 't', 'थ्': 'T', 'द्': 'dx',
        'ध्': 'Y', 'न्': 'n', 'प्': 'p', 'फ्': '♣', 'ब्': 'b',
        'भ्': 'B', 'म्': 'm', 'ल्': 'l', 'व्': 'v', 'स्': 's',
        'ह्': 'hx', 'श्': 'S', 'झ्': 'J', 'ण्': 'N', 'य्': 'y',
        'ष्': 'V', 'ड्': 'Dx', 'ट्': 'ox', 'क्ष्': 'H', 'त्र्': 'P', 'ज्ञ्': 'z'
      };

      const INDEPENDENT_VOWELS = {
        'अ': 'A', 'आ': 'Aa', 'इ': 'q', 'ई': 'qQ', 'उ': 'w',
        'ऊ': 'W', 'ऋ': 'R', 'ए': 'F', 'ऐ': 'Fe', 'ओ': 'Aae', 'औ': 'AaE'
      };

      const MATRAS = {
        'ा': 'a', 'ि': 'i', 'ी': 'I', 'ु': 'u', 'ू': 'U',
        'ृ': '&', 'े': 'e', 'ै': 'E', 'ो': 'ae', 'ौ': 'aE',
        'ं': '/', 'ः': ':', 'ँ': '~'
      };

      const LIGATURES = {
        'श्री': 'SaXI', 'रु': '@', 'रू': '@',
        'द्ध': '♥', 'द्व': '☺', 'द्य': '♦'
      };

      const NUMERALS = {
        '०': '0', '१': '1', '२': '2', '३': '3', '४': '4',
        '५': '5', '६': '6', '७': '7', '८': '8', '९': '9'
      };

      function unicodeToAms(unicodeText) {
        if (!unicodeText) return '';
        let str = unicodeText;
        str = str.replace(/ङ्([कखगघ])/g, 'ं$1').replace(/ञ्([चछजझ])/g, 'ं$1');
        for (const [orig, repl] of Object.entries(LIGATURES)) {
          str = str.split(orig).join(repl);
        }

        let result = '';
        const chars = Array.from(str);

        for (let idx = 0; idx < chars.length; idx++) {
          const char = chars[idx];
          const next = chars[idx + 1] || '';
          const nnext = chars[idx + 2] || '';

          if (char === 'र' && next === '्' && idx + 2 < chars.length) {
            let aIdx = idx + 2;
            let acc = '';
            if (chars[aIdx + 1] === '्' && HALF_CONSONANTS[chars[aIdx] + chars[aIdx + 1]]) {
              acc += HALF_CONSONANTS[chars[aIdx] + chars[aIdx + 1]];
              aIdx += 2;
            }
            if (CONSONANTS[chars[aIdx]]) {
              acc += CONSONANTS[chars[aIdx]];
              if (++aIdx < chars.length && MATRAS[chars[aIdx]]) {
                acc += MATRAS[chars[aIdx]];
                aIdx++;
              }
              result += acc + 'Q';
              idx = aIdx - 1;
              continue;
            }
          }

          if (CONSONANTS[char] || HALF_CONSONANTS[char + next]) {
            let aIdx = idx;
            let acc = '';
            let hasI = false;
            while (aIdx < chars.length) {
              const cur = chars[aIdx];
              const curNext = chars[aIdx + 1];
              const curNnext = chars[aIdx + 2];
              if (curNext === '्' && curNnext === 'र') {
                acc += (CONSONANTS[cur] || cur) + 'X';
                aIdx += 3;
                if (chars[aIdx] === 'ि') {
                  hasI = true;
                  aIdx++;
                }
                break;
              }
              if (curNext === '्') {
                acc += HALF_CONSONANTS[cur + curNext] || cur;
                aIdx += 2;
              } else {
                acc += CONSONANTS[cur] || cur;
                aIdx++;
                if (chars[aIdx] === 'ि') {
                  hasI = true;
                  aIdx++;
                }
                break;
              }
            }
            if (hasI) {
              result += 'i' + acc;
              idx = aIdx - 1;
              continue;
            }
          }

          if (next === '्' && nnext === 'र') {
            result += (CONSONANTS[char] || char) + 'X';
            idx += 2;
            continue;
          }

          if (next === '्') {
            const pair = char + next;
            result += HALF_CONSONANTS[pair] || char;
            idx++;
            continue;
          }

          if (CONSONANTS[char]) result += CONSONANTS[char];
          else if (INDEPENDENT_VOWELS[char]) result += INDEPENDENT_VOWELS[char];
          else if (MATRAS[char]) result += MATRAS[char];
          else if (NUMERALS[char]) result += NUMERALS[char];
          else result += char;
        }
        return result;
      }

      // Universal text node recursion with bilingual English word isolation
      function convertNodesRecursively(node) {
        if (!node) return;
        if (node.nodeType === 1) {
          if (node.getAttribute('data-eng') === 'true' || node.classList.contains('eng-text')) {
            if (!/[\u0900-\u097F]/.test(node.textContent)) {
              return;
            }
            node.removeAttribute('data-eng');
            node.classList.remove('eng-text');
          }
          const children = Array.from(node.childNodes);
          for (let i = 0; i < children.length; i++) {
            convertNodesRecursively(children[i]);
          }
        } else if (node.nodeType === 3) {
          const text = node.nodeValue;
          if (!text || !text.length) return;

          const regex = /(\([A-Za-z0-9_+.,/ -]+\)|[A-Za-z][A-Za-z0-9_.-]*)/g;
          if (!regex.test(text)) {
            node.nodeValue = unicodeToAms(text);
          } else {
            regex.lastIndex = 0;
            const frag = document.createDocumentFragment();
            let lastIdx = 0;
            let match;
            while ((match = regex.exec(text)) !== null) {
              if (match.index > lastIdx) {
                const nepaliPart = unicodeToAms(text.slice(lastIdx, match.index));
                if (nepaliPart) frag.appendChild(document.createTextNode(nepaliPart));
              }
              const engSpan = document.createElement('span');
              engSpan.className = 'eng-text';
              engSpan.setAttribute('data-eng', 'true');
              engSpan.textContent = match[0];
              frag.appendChild(engSpan);
              lastIdx = regex.lastIndex;
            }
            if (lastIdx < text.length) {
              const remaining = unicodeToAms(text.slice(lastIdx));
              if (remaining) frag.appendChild(document.createTextNode(remaining));
            }
            if (node.parentNode) {
              node.parentNode.replaceChild(frag, node);
            }
          }
        }
      }

      // 3. UI State
      let outputAmsVisual = true;
      let currentFontSize = 20;
      let typingLayout = 'traditional'; // 'traditional' | 'romanized' | 'english'

      const editorInput = document.getElementById('editor-input');
      const editorOutput = document.getElementById('editor-output');
      const outputFontTag = document.getElementById('output-font-tag');

      const inputCharCount = document.getElementById('input-char-count');
      const inputWordCount = document.getElementById('input-word-count');
      const outputCharCount = document.getElementById('output-char-count');
      const outputWordCount = document.getElementById('output-word-count');

      const modeBtnAmsToUni = document.getElementById('mode-ams-to-uni');
      const swapModeBtn = document.getElementById('swap-mode-btn');
      const selectTypingLayout = document.getElementById('select-typing-layout');
      const btnQuickRomanized = document.getElementById('btn-quick-romanized');
      const btnToggleOutputFont = document.getElementById('btn-toggle-output-font');

      const btnFontSmaller = document.getElementById('btn-font-smaller');
      const btnFontLarger = document.getElementById('btn-font-larger');
      const labelFontSize = document.getElementById('label-font-size');

      const btnSampleText = document.getElementById('btn-sample-text');
      const btnPasteInput = document.getElementById('btn-paste-input');
      const btnClearInput = document.getElementById('btn-clear-input');

      const btnCopyRich = document.getElementById('btn-copy-rich');
      const btnCopyPlain = document.getElementById('btn-copy-plain');
      const btnDownloadDoc = document.getElementById('btn-download-doc');
      const btnDownloadTxt = document.getElementById('btn-download-txt');
      const btnPrintDoc = document.getElementById('btn-print-doc');
      const copyStatusIndicator = document.getElementById('copy-status-indicator');
      const toastEl = document.getElementById('converter-toast');

      const fmtButtons = document.querySelectorAll('.fmt-btn');

      const SAMPLE_GUIDE_UNICODE = `<h2>नेपाली युनिकोडबाट एएमएस क्यालिग्राफी कन्भर्टर प्रयोग निर्देशिका</h2><p>यो नेपालको आधुनिक <b><span class="eng-text" data-eng="true">TopNepali</span></b> अनलाइन टाइपिङ तथा एएमएस क्यालिग्राफी फन्ट रूपान्तरण प्लेटफर्म हो । यसले <i><span class="eng-text" data-eng="true">Adobe Photoshop</span></i>, <i><span class="eng-text" data-eng="true">CorelDRAW</span></i>, तथा <i><span class="eng-text" data-eng="true">Microsoft Word</span></i> को लागि पूर्ण फर्म्याटिङ संरक्षण गर्दछ ।</p><h3>प्रमुख विशेषताहरू <span class="eng-text" data-eng="true">(Key Highlights)</span> :</h3><ul><li><b>द्रुत किबोर्ड सर्टकट <span class="eng-text" data-eng="true">(Keyboard Chord)</span> :</b> किबोर्डमा <u><span class="eng-text" data-eng="true">Left Alt + Left Shift</span></u> थिचेर नेपाली र <span class="eng-text" data-eng="true">English QWERTY</span> बीच तुरुन्तै अदलबदल गर्न सकिन्छ ।</li><li><b>द्विभाषी टाइपिङ र अंग्रेजी संरक्षण <span class="eng-text" data-eng="true">(Bilingual Preservation)</span> :</b> युनिकोडबाट एएमएस बनाउँदा अंग्रेजी शब्दहरू जस्तै <b>मकै <span class="eng-text" data-eng="true">(corn)</span></b> वा <b>नेपाल <span class="eng-text" data-eng="true">(Nepal)</span></b> पेस्ट गर्दा पनि स्वतः सुरक्षित रहन्छन् र स्क्र्याम्बल हुँदैनन् ।</li><li><b>फोटोसप तथा कोरेलड्रको लागि सटीक :</b> क्यालिग्राफी विवाह कार्ड र ब्यानर डिजाइनका लागि <b>Copy ASCII</b> थिचेर सिधै फोटोसपको एएमएस मन्त्र फन्टमा पेस्ट गर्नुहोस् ।</li><li><b>हलन्त र रेफ शुद्धता :</b> श्रीमान्, श्रीमती, प्रकृति, र क्रिया जस्ता शब्दहरू शुद्ध रूपान्तरण हुन्छन् ।</li></ul><p>तपाईं आफ्नो पाठ यहाँ सिधै टाइप गर्न वा बाहिरबाट <b><span class="eng-text" data-eng="true">Paste</span></b> गरी तत्काल रूपान्तरण गर्न सक्नुहुन्छ ।</p>`;

      function showToast(msg) {
        if (toastEl) {
          toastEl.textContent = msg;
          toastEl.classList.add('is-visible');
          setTimeout(() => toastEl.classList.remove('is-visible'), 2200);
        }
        if (copyStatusIndicator) {
          copyStatusIndicator.textContent = msg;
          copyStatusIndicator.style.opacity = '1';
          setTimeout(() => { copyStatusIndicator.style.opacity = '0'; }, 2200);
        }
      }

      function setEditorFontSize(size) {
        currentFontSize = Math.max(14, Math.min(36, size));
        if (editorInput) editorInput.style.fontSize = `${currentFontSize}px`;
        if (editorOutput) editorOutput.style.fontSize = `${currentFontSize}px`;
        if (labelFontSize) labelFontSize.textContent = `${currentFontSize}px`;
      }

      function applyAmsVisualState() {
        if (outputAmsVisual) {
          editorOutput.setAttribute('data-ams-visual', 'true');
          editorOutput.classList.add('font-ams');
          editorOutput.classList.remove('font-ascii');
          editorOutput.style.fontFamily = "'Font_ams', 'AMS 1', 'AMS1', 'AMS Mantra', 'AMS Kirti', monospace";
          if (outputFontTag) outputFontTag.textContent = 'AMS Visual';
        } else {
          editorOutput.setAttribute('data-ams-visual', 'false');
          editorOutput.classList.remove('font-ams');
          editorOutput.classList.add('font-ascii');
          editorOutput.style.fontFamily = "'JetBrains Mono', monospace";
          if (outputFontTag) outputFontTag.textContent = 'Raw ASCII Keys';
        }
      }

      function calculateStats(text) {
        const chars = text.length;
        const trimmed = text.trim();
        const words = trimmed ? trimmed.split(/\s+/).length : 0;
        return { chars, words };
      }

      function runConversion() {
        try {
          const inputText = editorInput.innerText || '';
          const inStats = calculateStats(inputText);
          if (inputCharCount) inputCharCount.textContent = inStats.chars.toLocaleString();
          if (inputWordCount) inputWordCount.textContent = inStats.words.toLocaleString();

          if (!inputText.trim()) {
            editorOutput.innerHTML = '';
            if (outputCharCount) outputCharCount.textContent = '0';
            if (outputWordCount) outputWordCount.textContent = '0';
            return;
          }

          const clone = editorInput.cloneNode(true);
          convertNodesRecursively(clone);
          editorOutput.innerHTML = clone.innerHTML;

          const outText = editorOutput.innerText || '';
          const outStats = calculateStats(outText);
          if (outputCharCount) outputCharCount.textContent = outStats.chars.toLocaleString();
          if (outputWordCount) outputWordCount.textContent = outStats.words.toLocaleString();
        } catch (e) {
          console.error('Conversion error:', e);
        }
      }

      // 4. In-Browser Typing Engine: Hardware Interception for Traditional & Romanized
      function breakOutOfEngSpan() {
        const sel = window.getSelection();
        if (!sel || sel.rangeCount === 0) return;
        const range = sel.getRangeAt(0);
        let container = range.startContainer;
        let parentEl = container.nodeType === 1 ? container : container.parentElement;
        let engSpan = parentEl ? parentEl.closest('.eng-text, [data-eng="true"]') : null;
        if (engSpan) {
          let nextNode = engSpan.nextSibling;
          if (nextNode && nextNode.nodeType === 3) {
            const newRange = document.createRange();
            newRange.setStart(nextNode, 0);
            newRange.collapse(true);
            sel.removeAllRanges();
            sel.addRange(newRange);
          } else {
            const newRange = document.createRange();
            newRange.setStartAfter(engSpan);
            newRange.collapse(true);
            sel.removeAllRanges();
            sel.addRange(newRange);
          }
        }
      }

      function toggleTypingLayout() {
        typingLayout = (typingLayout === 'english') ? 'traditional' : 'english';
        if (selectTypingLayout) selectTypingLayout.value = typingLayout;
        if (typingLayout !== 'english') {
          breakOutOfEngSpan();
        }
        const name = (typingLayout === 'english') ? 'English QWERTY' : (typingLayout === 'romanized' ? 'Nepali Romanized' : 'Nepali Traditional');
        showToast(`Layout: ${name} (Alt+Shift)`);
      }

      window.addEventListener('keydown', (e) => {
        if (e.repeat) return;
        if ((e.code === 'AltLeft' || e.key === 'Alt') && e.shiftKey) {
          e.preventDefault();
          toggleTypingLayout();
          return;
        }
        if ((e.code === 'ShiftLeft' || e.key === 'Shift') && e.altKey) {
          e.preventDefault();
          toggleTypingLayout();
          return;
        }
      });

      // Keydown Handling on editorInput
      editorInput.addEventListener('keydown', (e) => {
        if (e.ctrlKey || e.metaKey || e.key.length > 1) return;

        if (typingLayout === 'english') {
          e.preventDefault();
          const sel = window.getSelection();
          if (sel && sel.rangeCount > 0) {
            const range = sel.getRangeAt(0);
            let container = range.startContainer;
            let parentEl = container.nodeType === 1 ? container : container.parentElement;
            let engSpan = parentEl ? parentEl.closest('.eng-text, [data-eng="true"]') : null;

            if (!engSpan) {
              if (container.nodeType === 3 && range.startOffset === 0 && container.previousSibling) {
                const prev = container.previousSibling;
                if (prev.nodeType === 1 && (prev.getAttribute('data-eng') === 'true' || prev.classList.contains('eng-text'))) {
                  engSpan = prev;
                  container = engSpan.lastChild || engSpan;
                }
              } else if (container.nodeType === 1 && range.startOffset > 0) {
                const prev = container.childNodes[range.startOffset - 1];
                if (prev && prev.nodeType === 1 && (prev.getAttribute('data-eng') === 'true' || prev.classList.contains('eng-text'))) {
                  engSpan = prev;
                  container = engSpan.lastChild || engSpan;
                }
              }
            }

            if (engSpan && engSpan.contains(container)) {
              if (container.nodeType === 3) {
                const offset = range.startOffset;
                container.nodeValue = container.nodeValue.slice(0, offset) + e.key + container.nodeValue.slice(offset);
                const newRange = document.createRange();
                newRange.setStart(container, offset + 1);
                newRange.collapse(true);
                sel.removeAllRanges();
                sel.addRange(newRange);
              } else {
                const textNode = document.createTextNode(e.key);
                engSpan.appendChild(textNode);
                const newRange = document.createRange();
                newRange.setStart(textNode, 1);
                newRange.collapse(true);
                sel.removeAllRanges();
                sel.addRange(newRange);
              }
            } else {
              const span = document.createElement('span');
              span.className = 'eng-text';
              span.setAttribute('data-eng', 'true');
              span.textContent = e.key;
              range.deleteContents();
              range.insertNode(span);
              const newRange = document.createRange();
              newRange.setStart(span.firstChild, 1);
              newRange.collapse(true);
              sel.removeAllRanges();
              sel.addRange(newRange);
            }
          }
          runConversion();
          return;
        }

        // Devanagari In-Browser Typing Interception (Traditional / Romanized)
        const mapping = KEY_CODE_MAP[e.code];
        if (mapping) {
          const modeKey = (typingLayout === 'romanized') ? 'rom' : 'uni';
          const charPair = mapping[modeKey];
          if (charPair) {
            e.preventDefault();
            const char = e.shiftKey ? charPair[1] : charPair[0];
            const sel = window.getSelection();
            if (sel && sel.rangeCount > 0) {
              const range = sel.getRangeAt(0);
              let container = range.startContainer;
              let parentEl = container.nodeType === 1 ? container : container.parentElement;
              let engSpan = parentEl ? parentEl.closest('.eng-text, [data-eng="true"]') : null;

              if (engSpan) {
                let isAtStart = (range.startContainer === engSpan.firstChild && range.startOffset === 0);
                if (isAtStart) {
                  const textNode = document.createTextNode(char);
                  engSpan.parentNode.insertBefore(textNode, engSpan);
                  const newRange = document.createRange();
                  newRange.setStart(textNode, 1);
                  newRange.collapse(true);
                  sel.removeAllRanges();
                  sel.addRange(newRange);
                } else {
                  const textNode = document.createTextNode(char);
                  engSpan.parentNode.insertBefore(textNode, engSpan.nextSibling);
                  const newRange = document.createRange();
                  newRange.setStart(textNode, 1);
                  newRange.collapse(true);
                  sel.removeAllRanges();
                  sel.addRange(newRange);
                }
              } else {
                range.deleteContents();
                const textNode = document.createTextNode(char);
                range.insertNode(textNode);
                const newRange = document.createRange();
                newRange.setStart(textNode, textNode.length);
                newRange.collapse(true);
                sel.removeAllRanges();
                sel.addRange(newRange);
              }
            }
            runConversion();
            return;
          }
        }
      });

      // Real-time conversion on keystroke
      let debounceTimer = null;
      editorInput.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(runConversion, 15);
      });

      // Toolbar formatting commands
      fmtButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const cmd = btn.dataset.cmd;
          const val = btn.dataset.val || null;
          editorInput.focus();
          document.execCommand(cmd, false, val);
          runConversion();
        });
      });

      // Mode Switch & Text Swap to AMS to Unicode
      function switchAndSwapToAmsToUni() {
        const textToCarry = (editorOutput && editorOutput.innerHTML.trim())
          ? editorOutput.innerHTML
          : (editorInput ? editorInput.innerHTML : '');
        if (textToCarry) {
          sessionStorage.setItem('tn_converter_swap_text', textToCarry);
        }
        window.location.href = '/ams-to-unicode';
      }

      if (modeBtnAmsToUni) {
        modeBtnAmsToUni.addEventListener('click', switchAndSwapToAmsToUni);
      }
      if (swapModeBtn) {
        swapModeBtn.addEventListener('click', switchAndSwapToAmsToUni);
      }

      // Typing Layout Switcher Dropdown (Inside Input Pane)
      if (selectTypingLayout) {
        selectTypingLayout.addEventListener('change', (e) => {
          typingLayout = e.target.value;
          if (typingLayout !== 'english') {
            breakOutOfEngSpan();
          }
          const name = e.target.options[e.target.selectedIndex].text;
          showToast(`Layout: ${name}`);
        });
      }

      // Quick Romanized Button
      if (btnQuickRomanized) {
        btnQuickRomanized.addEventListener('click', () => {
          typingLayout = 'romanized';
          if (selectTypingLayout) selectTypingLayout.value = 'romanized';
          breakOutOfEngSpan();
          showToast('Switched to Nepali Romanized Typing');
        });
      }

      // AMS View Toggle (Output Pane)
      if (btnToggleOutputFont) {
        btnToggleOutputFont.addEventListener('click', () => {
          outputAmsVisual = !outputAmsVisual;
          applyAmsVisualState();
        });
      }

      // Font Size Controls
      if (btnFontSmaller) {
        btnFontSmaller.addEventListener('click', () => setEditorFontSize(currentFontSize - 2));
      }
      if (btnFontLarger) {
        btnFontLarger.addEventListener('click', () => setEditorFontSize(currentFontSize + 2));
      }

      // Sample Text
      btnSampleText.addEventListener('click', () => {
        editorInput.innerHTML = SAMPLE_GUIDE_UNICODE;
        runConversion();
        showToast('Loaded complete usage guide');
      });

      // Paste Button
      btnPasteInput.addEventListener('click', async () => {
        try {
          const text = await navigator.clipboard.readText();
          if (text) {
            editorInput.focus();
            document.execCommand('insertText', false, text);
            runConversion();
          }
        } catch {
          editorInput.focus();
        }
      });

      // Clear Button
      btnClearInput.addEventListener('click', () => {
        editorInput.innerHTML = '';
        editorOutput.innerHTML = '';
        if (inputCharCount) inputCharCount.textContent = '0';
        if (inputWordCount) inputWordCount.textContent = '0';
        if (outputCharCount) outputCharCount.textContent = '0';
        if (outputWordCount) outputWordCount.textContent = '0';
        editorInput.focus();
      });

      // Copy Formatted (Word & Google Docs)
      btnCopyRich.addEventListener('click', async () => {
        const htmlData = editorOutput.innerHTML;
        const textData = editorOutput.innerText || '';
        if (!textData.trim()) return;

        try {
          if (navigator.clipboard && window.ClipboardItem) {
            const blobHtml = new Blob([htmlData], { type: 'text/html' });
            const blobText = new Blob([textData], { type: 'text/plain' });
            await navigator.clipboard.write([
              new ClipboardItem({
                'text/html': blobHtml,
                'text/plain': blobText
              })
            ]);
            showToast('Copied formatted text for Word & Google Docs');
          } else {
            await navigator.clipboard.writeText(textData);
            showToast('Copied to clipboard');
          }
        } catch {
          const range = document.createRange();
          range.selectNodeContents(editorOutput);
          const sel = window.getSelection();
          sel.removeAllRanges();
          sel.addRange(range);
          document.execCommand('copy');
          sel.removeAllRanges();
          showToast('Copied to clipboard');
        }
      });

      // Copy Plain Text / ASCII
      btnCopyPlain.addEventListener('click', async () => {
        const textData = editorOutput.innerText || '';
        if (!textData.trim()) return;
        try {
          await navigator.clipboard.writeText(textData);
          showToast('Copied ASCII text for Photoshop & CorelDRAW');
        } catch {
          const temp = document.createElement('textarea');
          temp.value = textData;
          document.body.appendChild(temp);
          temp.select();
          document.execCommand('copy');
          document.body.removeChild(temp);
          showToast('Copied plain ASCII');
        }
      });

      // Download Formatted Word Document
      if (btnDownloadDoc) {
        btnDownloadDoc.addEventListener('click', () => {
          const htmlContent = editorOutput.innerHTML;
          if (!htmlContent.trim()) return;

          const docHtml = `<!DOCTYPE html>
<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
<head>
<meta charset='utf-8'>
<title>AMS Calligraphy Document</title>
<!--[if gte mso 9]>
<xml>
  <w:WordDocument>
    <w:View>Print</w:View>
    <w:Zoom>100</w:Zoom>
    <w:DoNotOptimizeForBrowser/>
  </w:WordDocument>
</xml>
<![endif]-->
<style>
  body {
    font-family: 'AMS 1', 'AMS1', 'AMS Mantra', 'AMS Kirti', 'AMS Calligraphy', Arial, sans-serif;
    font-size: 14pt;
    line-height: 1.6;
    color: #000000;
  }
  .eng-text {
    font-family: Arial, Calibri, sans-serif !important;
  }
  h1, h2, h3, h4 {
    font-family: 'AMS 1', 'AMS1', 'AMS Mantra', 'AMS Kirti', Arial, sans-serif;
    color: #000000;
  }
  p { margin: 0 0 10pt 0; }
  ul, ol { margin-bottom: 10pt; }
</style>
</head>
<body>
  ${htmlContent}
</body>
</html>`;

          const blob = new Blob(['\ufeff', docHtml], { type: 'application/msword;charset=utf-8' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = 'nepali-ams-calligraphy.doc';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
          showToast('Downloaded Word document (formatting preserved)');
        });
      }

      // Download Plain Text (.txt)
      btnDownloadTxt.addEventListener('click', () => {
        const textData = editorOutput.innerText || '';
        if (!textData.trim()) return;
        const blob = new Blob([textData], { type: 'text/plain;charset=utf-8' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'nepali-ams-calligraphy.txt';
        a.click();
        URL.revokeObjectURL(a.href);
        showToast('Downloaded nepali-ams-calligraphy.txt');
      });

      // Print Document
      btnPrintDoc.addEventListener('click', () => {
        const printWin = window.open('', '', 'width=840,height=640');
        if (!printWin) return;
        printWin.document.write(`
          <!DOCTYPE html>
          <html>
            <head>
              <title>TopNepali AMS Document Print</title>
              <style>
                body { font-family: 'AMS 1', 'AMS1', 'AMS Mantra', 'AMS Kirti', -apple-system, sans-serif; padding: 40px; line-height: 1.8; color: #111; font-size: 18px; }
                .eng-text { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important; }
                h1, h2, h3 { color: #000; margin-top: 1.5em; margin-bottom: 0.5em; }
              </style>
            </head>
            <body>
              ${editorOutput.innerHTML}
            </body>
          </html>
        `);
        printWin.document.close();
        printWin.focus();
        printWin.print();
        printWin.close();
      });

      // Initial execution (respecting swapped carryover text from sessionStorage)
      setEditorFontSize(20);
      applyAmsVisualState();

      const carriedSwapText = sessionStorage.getItem('tn_converter_swap_text');
      if (carriedSwapText) {
        sessionStorage.removeItem('tn_converter_swap_text');
        editorInput.innerHTML = carriedSwapText;
        runConversion();
        showToast('Swapped text successfully');
      } else {
        editorInput.innerHTML = SAMPLE_GUIDE_UNICODE;
        runConversion();
      }
    })();
  </script>
</Layout>
