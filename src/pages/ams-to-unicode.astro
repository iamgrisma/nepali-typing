---
import Layout from '../layouts/Layout.astro';
import '../styles/ams-font.css';

const pageTitle = "AMS to Unicode Converter — IndiaFont Calligraphy to Nepali Unicode";
const pageDesc = "Convert IndiaFont AMS calligraphy font text into standard Nepali Unicode instantly. Fully compatible with Word, Google Docs, social media, and websites. Free in-browser tool.";
const canonicalUrl = "https://typing.topnepali.com/ams-to-unicode";
const ogImageUrl = "https://img.topnepali.com/typing.tn/og/default-svg.webp";
const keywords = "AMS to Unicode, AMS font converter, Indiafont to Unicode, AMS to Nepali Unicode converter, AMS Mantra converter, AMS calligraphy font converter, convert AMS to Unicode";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is an AMS font and why does it need conversion to Unicode?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "AMS fonts (such as AMS Mantra, AMS Kirti, AMS Aaditya, and AMS Calligraphy) are specialized decorative ASCII fonts developed for IndiaFont calligraphy in Adobe Photoshop, CorelDRAW, and Illustrator. Because AMS fonts map stylish Devanagari shapes onto English ASCII keystrokes, the raw text is unreadable on websites, social media, and smartphones without the proprietary font file installed. Converting AMS to Nepali Unicode standardizes the text into globally compliant UTF-8 Devanagari."
      }
    },
    {
      "@type": "Question",
      "name": "Does this AMS converter retain bold, italic, and heading formatting?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Our converter uses recursive DOM node transformation rather than basic text replacement. All bold, italic, headings (H2/H3), bullet lists, and paragraphs remain completely intact during conversion and can be copied or exported directly as a Microsoft Word document (.doc) with zero loss of structure."
      }
    },
    {
      "@type": "Question",
      "name": "How does the AMS to Unicode engine handle complex conjuncts, ra-kars, and rephs?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The engine accurately reorganizes raswa ikaar markers (which appear before consonants in AMS typing like 'ik' for 'कि'), ra-kar ligatures (like 'paX' for 'प्र' and 'kX' for 'क्र'), and trailing reph ligatures ('Q' for preceding 'र्') into clean, standard Devanagari Unicode codepoints."
      }
    },
    {
      "@type": "Question",
      "name": "Can I convert Nepali Unicode back into AMS for Photoshop and CorelDRAW?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Switch to our Unicode to AMS Converter to generate exact AMS ASCII keystrokes for Adobe Photoshop, Illustrator, CorelDRAW, and PageMaker calligraphy layouts."
      }
    }
  ]
};

const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "AMS to Unicode Converter by TopNepali",
  "url": canonicalUrl,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "NPR"
  },
  "description": pageDesc
};
---

<Layout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl={canonicalUrl}
  ogImage={ogImageUrl}
  keywords={keywords}
  schema={[appSchema, faqSchema]}
  activeNav="converter"
>
  <div class="converter-wrapper py-4 sm:py-6">

    <!-- Hero Header -->
    <header class="text-center max-w-3xl mx-auto pt-2 pb-6">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20 mb-2.5">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="16 3 21 3 21 8"></polyline>
          <line x1="4" y1="20" x2="21" y2="3"></line>
          <polyline points="21 16 21 21 16 21"></polyline>
          <line x1="15" y1="15" x2="21" y2="21"></line>
          <line x1="4" y1="4" x2="9" y2="9"></line>
        </svg>
        <span>STANDALONE RICH-TEXT COMPATIBLE • INDIAFONT CALLIGRAPHY</span>
      </div>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold font-display tracking-tight text-[var(--text-primary)]">
        AMS to Unicode <span class="text-amber-600 dark:text-amber-500">Converter</span>
      </h1>
      <p class="mt-2 text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
        Convert IndiaFont AMS calligraphy ASCII text into standard Nepali Unicode in real-time. Retain bold, italic, headings, and list formatting when pasting into Word or Google Docs.
      </p>
    </header>

    <!-- Master Converter Toolbar -->
    <div class="converter-toolbar">
      <!-- Mode Switcher & Swap Chords -->
      <div class="flex items-center gap-1.5 flex-wrap">
        <div class="inline-flex p-1 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
          <button
            type="button"
            id="mode-ams-to-uni"
            class="converter-btn converter-btn-primary font-bold cursor-default pointer-events-none"
            title="Currently on AMS to Unicode Converter"
          >
            AMS &rarr; Unicode
          </button>
          <button
            type="button"
            id="mode-uni-to-ams"
            class="converter-btn hover:bg-[var(--bg-surface)] cursor-pointer"
            title="Switch to Unicode to AMS Converter (swaps text automatically)"
          >
            Unicode &rarr; AMS
          </button>
        </div>

        <button
          type="button"
          id="swap-mode-btn"
          class="converter-btn p-2 hover:bg-[var(--bg-surface)] cursor-pointer"
          title="Switch Converter and Swap Text"
          aria-label="Switch Converter and Swap Text"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 16V4m0 0L3 8m4-4l4 4m6 4v12m0 0l4-4m-4 4l-4-4"></path>
          </svg>
        </button>

        <a
          href="/preeti-to-unicode"
          class="converter-btn px-2.5 py-1 text-xs font-semibold text-[var(--text-secondary)] hover:text-[var(--text-primary)] border border-[var(--border-subtle)] rounded-xl"
          title="Switch to Preeti to Unicode Converter"
        >
          Preeti &harr; Unicode
        </a>
      </div>

      <!-- Rich Text Formatting Actions -->
      <div class="flex items-center gap-1 bg-[var(--bg-surface-subtle)] p-1 rounded-xl border border-[var(--border-subtle)] flex-wrap">
        <button type="button" class="converter-btn fmt-btn p-1.5" data-cmd="bold" title="Bold (Ctrl+B)">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"></path><path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"></path></svg>
        </button>
        <button type="button" class="converter-btn fmt-btn p-1.5" data-cmd="italic" title="Italic (Ctrl+I)">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="4" x2="10" y2="4"></line><line x1="14" y1="20" x2="5" y2="20"></line><line x1="15" y1="4" x2="9" y2="20"></line></svg>
        </button>
        <button type="button" class="converter-btn fmt-btn p-1.5" data-cmd="underline" title="Underline (Ctrl+U)">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 3v7a6 6 0 0 0 6 6 6 6 0 0 0 6-6V3"></path><line x1="4" y1="21" x2="20" y2="21"></line></svg>
        </button>

        <div class="converter-divider"></div>

        <button type="button" class="converter-btn fmt-btn px-2 py-1 font-bold text-xs" data-cmd="formatBlock" data-val="h2" title="Heading 2">H2</button>
        <button type="button" class="converter-btn fmt-btn px-2 py-1 font-bold text-xs" data-cmd="formatBlock" data-val="h3" title="Heading 3">H3</button>

        <div class="converter-divider"></div>

        <button type="button" class="converter-btn fmt-btn p-1.5" data-cmd="insertUnorderedList" title="Bullet List">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
        </button>
        <button type="button" class="converter-btn fmt-btn p-1.5" data-cmd="insertOrderedList" title="Numbered List">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="10" y1="6" x2="21" y2="6"></line><line x1="10" y1="12" x2="21" y2="12"></line><line x1="10" y1="18" x2="21" y2="18"></line><path d="M4 6h1v4"></path><path d="M4 10h2"></path><path d="M6 18H4c0-1 2-2 2-3s-1-1.5-2-1"></path></svg>
        </button>
        <button type="button" class="converter-btn fmt-btn p-1.5" data-cmd="removeFormat" title="Clear Formatting">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>

        <div class="converter-divider"></div>

        <!-- Font Size Scaler -->
        <div class="flex items-center gap-1">
          <button type="button" id="btn-font-smaller" class="converter-btn px-1.5 py-0.5 text-xs font-bold" title="Decrease font size">A-</button>
          <span id="label-font-size" class="text-xs font-mono text-[var(--text-muted)] min-w-[32px] text-center font-bold">20px</span>
          <button type="button" id="btn-font-larger" class="converter-btn px-1.5 py-0.5 text-xs font-bold" title="Increase font size">A+</button>
        </div>
      </div>
    </div>

    <!-- Dual-Pane Workspace Grid -->
    <div class="converter-grid">
      <!-- Input Pane (AMS Calligraphy) -->
      <div class="converter-pane">
        <div class="converter-pane-header">
          <div class="flex items-center gap-2 flex-wrap">
            <span id="input-label" class="font-bold uppercase tracking-wider text-xs text-[var(--text-primary)]">
              AMS Calligraphy Input
            </span>

            <!-- AMS Visual Toggle -->
            <button
              type="button"
              id="btn-toggle-input-font"
              class="converter-pill border border-amber-500/30 text-amber-600 dark:text-amber-400 bg-amber-500/10 cursor-pointer"
              title="Toggle between authentic AMS Calligraphy visual preview and Raw ASCII keys"
            >
              <svg class="w-3 h-3 text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
              <span id="input-font-tag">AMS Visual</span>
            </button>
          </div>

          <div class="flex items-center gap-1.5">
            <button type="button" id="btn-sample-text" class="converter-btn text-xs">Sample Guide</button>
            <button type="button" id="btn-paste-input" class="converter-btn text-xs">Paste</button>
            <button type="button" id="btn-clear-input" class="converter-btn text-xs text-rose-600 hover:text-rose-700">Clear</button>
          </div>
        </div>

        <!-- Editable Input Content Area (AMS Visual by Default) -->
        <div
          id="editor-input"
          contenteditable="true"
          spellcheck="false"
          class="converter-editor font-ams select-text"
          data-ams-visual="true"
          data-placeholder="Type in AMS ASCII (e.g. SauBa ivavaah, naepaala, deSa) or paste text here..."
        ></div>

        <div class="converter-pane-footer">
          <div class="flex items-center gap-4">
            <span>Characters: <strong id="input-char-count" class="text-[var(--text-primary)]">0</strong></span>
            <span>Words: <strong id="input-word-count" class="text-[var(--text-primary)]">0</strong></span>
          </div>
          <span class="text-xs text-[var(--text-muted)] flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block animate-pulse"></span>
            Real-time live conversion
          </span>
        </div>
      </div>

      <!-- Output Pane (Nepali Unicode) -->
      <div class="converter-pane">
        <div class="converter-pane-header">
          <div class="flex items-center gap-2">
            <span id="output-label" class="font-bold uppercase tracking-wider text-xs text-[var(--text-primary)]">
              Nepali Unicode Output
            </span>
            <div class="converter-pill border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 bg-emerald-500/10">
              <span id="output-font-tag">UTF-8 UNICODE</span>
            </div>
          </div>

          <div class="flex items-center gap-1.5 flex-wrap">
            <button
              type="button"
              id="btn-copy-rich"
              class="converter-btn converter-btn-success text-xs font-bold"
              title="Copy formatted text with bold, italic, and headings preserved for Word / Google Docs"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span>Copy Formatted</span>
            </button>
            <button type="button" id="btn-copy-plain" class="converter-btn text-xs" title="Copy plain text">Copy Text</button>

            <!-- Formatted Word Document Download -->
            <button
              type="button"
              id="btn-download-doc"
              class="converter-btn text-xs font-bold border-blue-500/40 text-blue-600 dark:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-950/30"
              title="Download formatted Microsoft Word document (.doc) with headings, bold, and styles preserved"
            >
              <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
              <span>Word (.doc)</span>
            </button>

            <!-- Plain Text File Download -->
            <button type="button" id="btn-download-txt" class="converter-btn text-xs" title="Download plain text file">.txt</button>
            <button type="button" id="btn-print-doc" class="converter-btn text-xs">Print</button>
          </div>
        </div>

        <!-- Converted Output Area (Unicode) -->
        <div
          id="editor-output"
          contenteditable="true"
          spellcheck="false"
          class="converter-editor font-nepali select-text"
          data-font-nepali="true"
          data-placeholder="Converted Unicode text appears here instantly..."
        ></div>

        <div class="converter-pane-footer">
          <div class="flex items-center gap-4">
            <span>Characters: <strong id="output-char-count" class="text-[var(--text-primary)]">0</strong></span>
            <span>Words: <strong id="output-word-count" class="text-[var(--text-primary)]">0</strong></span>
          </div>
          <div id="copy-status-indicator" class="font-bold text-emerald-600 dark:text-emerald-400 opacity-0 transition-opacity">
            Copied to clipboard
          </div>
        </div>
      </div>
    </div>

    <!-- Educational & Technical Content -->
    <section class="mt-12 space-y-8">
      <div class="bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-2xl p-6 sm:p-8 shadow-sm">
        <h2 class="text-xl sm:text-2xl font-bold font-display text-[var(--text-primary)] mb-3">
          Why Convert AMS IndiaFont Calligraphy to Nepali Unicode?
        </h2>
        <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed mb-4">
          In Nepal and India, graphic designers and printing presses frequently use <strong>IndiaFont AMS typefaces</strong> (such as <em>AMS Mantra</em>, <em>AMS Kirti</em>, <em>AMS Aaditya</em>, <em>AMS Leafy</em>, and <em>AMS Hastkala</em>) to produce stunning decorative headlines for wedding cards, banners, invitation letters, and flex prints. Because these fonts remap Devanagari calligraphy shapes onto standard English ASCII keyboard positions, the raw text looks like English gibberish (e.g. <code>SauBa ivavaah</code> for <strong>शुभ विवाह</strong> or <code>deSa</code> for <strong>देश</strong>).
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs sm:text-sm mt-4">
          <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
            <h3 class="font-bold text-[var(--text-primary)] mb-1">Universal Web &amp; Social Media</h3>
            <p class="text-[var(--text-muted)]">Raw AMS text cannot be posted on Facebook, WhatsApp, or websites. Unicode renders accurately on all smartphones and browsers.</p>
          </div>
          <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
            <h3 class="font-bold text-[var(--text-primary)] mb-1">Search Engine Indexing (SEO)</h3>
            <p class="text-[var(--text-muted)]">Google and AI crawlers cannot index ASCII calligraphy codes. Converting to Unicode makes documents fully searchable worldwide.</p>
          </div>
          <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
            <h3 class="font-bold text-[var(--text-primary)] mb-1">Office &amp; Archival Safety</h3>
            <p class="text-[var(--text-muted)]">Standard UTF-8 encoding ensures wedding names, invitation lists, and ceremonial programs are never corrupted across computers.</p>
          </div>
        </div>
      </div>

      <!-- Related Converters & Typography Ecosystem -->
      <div class="bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-2xl p-6 sm:p-8 shadow-sm">
        <h2 class="text-lg font-bold font-display text-[var(--text-primary)] mb-3">
          Explore Related Nepali Typing Tools &amp; Typography
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs sm:text-sm">
          <a href="/unicode-to-ams" class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)] hover:border-amber-500/40 transition-colors group">
            <h3 class="font-bold text-[var(--text-primary)] group-hover:text-amber-600 mb-1">Unicode to AMS Converter &rarr;</h3>
            <p class="text-[var(--text-muted)]">Convert Nepali Unicode text back into AMS ASCII keystrokes for Photoshop and CorelDRAW.</p>
          </a>
          <a href="/preeti-to-unicode" class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)] hover:border-rose-500/40 transition-colors group">
            <h3 class="font-bold text-[var(--text-primary)] group-hover:text-rose-600 mb-1">Preeti to Unicode Converter &rarr;</h3>
            <p class="text-[var(--text-muted)]">Convert traditional typewriter Preeti and Kantipur ASCII documents to standard Unicode.</p>
          </a>
          <a href="https://fonts.topnepali.com" class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)] hover:border-blue-500/40 transition-colors group">
            <h3 class="font-bold text-[var(--text-primary)] group-hover:text-blue-600 mb-1">Download Nepali &amp; AMS Fonts &rarr;</h3>
            <p class="text-[var(--text-muted)]">Browse 500+ free Nepali fonts, calligraphy styles, and Unicode typefaces on FontsDir.</p>
          </a>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-2xl p-6 sm:p-8 shadow-sm mb-8">
        <h2 class="text-lg font-bold font-display text-[var(--text-primary)] mb-4">
          Frequently Asked Questions
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs sm:text-sm">
          <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
            <h3 class="font-bold text-[var(--text-primary)] mb-1.5">What is the difference between Preeti and AMS fonts?</h3>
            <p class="text-[var(--text-secondary)] leading-relaxed">
              Preeti follows the Remington typewriter key layout widely used in Nepali government offices and newspapers. AMS fonts are specialized IndiaFont calligraphy typefaces with a different ASCII encoding designed for wedding invitations, posters, and banner design in Photoshop.
            </p>
          </div>
          <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
            <h3 class="font-bold text-[var(--text-primary)] mb-1.5">Does the converter retain bold and italic styles?</h3>
            <p class="text-[var(--text-secondary)] leading-relaxed">
              Yes. All bold, italic, headings, and list structures are retained across DOM nodes. You can copy directly into Word or download a formatted Word document (.doc).
            </p>
          </div>
          <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
            <h3 class="font-bold text-[var(--text-primary)] mb-1.5">Can I convert Unicode back into AMS for Photoshop?</h3>
            <p class="text-[var(--text-secondary)] leading-relaxed">
              Yes. Use the <a href="/unicode-to-ams" class="text-amber-600 dark:text-amber-400 underline font-semibold">Unicode to AMS Converter</a> to generate ASCII keystrokes that you can paste directly into Photoshop or CorelDRAW text layers.
            </p>
          </div>
          <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
            <h3 class="font-bold text-[var(--text-primary)] mb-1.5">Is my text stored on your servers?</h3>
            <p class="text-[var(--text-secondary)] leading-relaxed">
              No. All conversion operations occur client-side in your browser JavaScript engine. Your confidential documents and notes never leave your device.
            </p>
          </div>
        </div>
      </div>
    </section>

  </div>

  <div id="converter-toast" class="converter-toast"></div>

  <!-- Self-Contained In-Browser Converter Script -->
  <script is:inline>
    (function initConverter() {
      // 1. AMS IndiaFont <-> Unicode Replacement Engine
      const CONSONANTS = {
        'क': 'k', 'ख': 'Ka', 'ग': 'ga', 'घ': 'Ga', 'ङ': 'ङ',
        'च': 'ca', 'छ': 'C', 'ज': 'ja', 'झ': 'Ja', 'ञ': 'ञ',
        'ट': 'o', 'ठ': 'O', 'ड': 'D', 'ढ': 'Z', 'ण': 'Na',
        'त': 'ta', 'थ': 'Ta', 'द': 'd', 'ध': 'Ya', 'न': 'na',
        'प': 'pa', 'फ': 'f', 'ब': 'ba', 'भ': 'Ba', 'म': 'ma',
        'य': 'ya', 'र': 'r', 'ल': 'la', 'व': 'va', 'श': 'Sa',
        'ष': 'Va', 'स': 'sa', 'ह': 'h', 'क्ष': 'Ha', 'त्र': 'Pa', 'ज्ञ': 'za',
        'श्र': 'SaX'
      };

      const HALF_CONSONANTS = {
        'क्': '|', 'ख्': 'K', 'ग्': 'g', 'घ्': 'G', 'ङ्': 'ङ्',
        'च्': 'c', 'ज्': 'j', 'त्': 't', 'थ्': 'T', 'द्': 'dx',
        'ध्': 'Y', 'न्': 'n', 'प्': 'p', 'फ्': '♣', 'ब्': 'b',
        'भ्': 'B', 'म्': 'm', 'ल्': 'l', 'व्': 'v', 'स्': 's',
        'ह्': 'hx', 'श्': 'S', 'झ्': 'J', 'ण्': 'N', 'य्': 'y',
        'ष्': 'V', 'ड्': 'Dx', 'ट्': 'ox', 'क्ष्': 'H', 'त्र्': 'P', 'ज्ञ्': 'z'
      };

      const INDEPENDENT_VOWELS = {
        'अ': 'A', 'आ': 'Aa', 'इ': 'q', 'ई': 'qQ', 'उ': 'w',
        'ऊ': 'W', 'ऋ': 'R', 'ए': 'F', 'ऐ': 'Fe', 'ओ': 'Aae', 'औ': 'AaE'
      };

      const MATRAS = {
        'ा': 'a', 'ि': 'i', 'ी': 'I', 'ु': 'u', 'ू': 'U',
        'ृ': '&', 'े': 'e', 'ै': 'E', 'ो': 'ae', 'ौ': 'aE',
        'ं': '/', 'ः': ':', 'ँ': '~'
      };

      const LIGATURES = {
        'श्री': 'SaXI', 'रु': '@', 'रू': '@',
        'द्ध': '♥', 'द्व': '☺', 'द्य': '♦'
      };

      const NUMERALS = {
        '०': '0', '१': '1', '२': '2', '३': '3', '४': '4',
        '५': '5', '६': '6', '७': '7', '८': '8', '९': '9'
      };

      let REVERSE_MAP = null;
      let SORTED_KEYS = null;

      function initReverseMap() {
        if (REVERSE_MAP) return;
        REVERSE_MAP = {};
        const add = (tbl) => {
          for (const [k, v] of Object.entries(tbl)) {
            REVERSE_MAP[v] = k;
          }
        };
        add(LIGATURES);
        add(CONSONANTS);
        add(HALF_CONSONANTS);
        add(INDEPENDENT_VOWELS);
        add(MATRAS);
        add(NUMERALS);
        REVERSE_MAP['X'] = '्र';
        SORTED_KEYS = Object.keys(REVERSE_MAP).sort((a, b) => b.length - a.length);
      }

      function hasDevanagari(text) {
        return /[\u0900-\u097F]/.test(text);
      }

      function amsToUnicode(amsText) {
        if (!amsText) return '';
        initReverseMap();

        let text = amsText.replace(/ax/g, '्');
        let result = '';
        let ptr = 0;
        let pendingI = false;
        let lastChar = '';

        while (ptr < text.length) {
          let matchedUnicode = null;
          let matchedKey = '';

          for (const key of SORTED_KEYS) {
            if (text.startsWith(key, ptr)) {
              matchedUnicode = REVERSE_MAP[key];
              matchedKey = key;
              break;
            }
          }

          const cur = text[ptr];
          if (cur === 'Q') {
            if (lastChar) {
              result = result.slice(0, result.length - lastChar.length) + 'र्' + lastChar;
              lastChar = 'र्' + lastChar;
            } else {
              result += 'र्';
            }
            ptr++;
            continue;
          }

          if (matchedKey) {
            if (matchedKey === 'i') {
              if (text[ptr + matchedKey.length] === 'Q') {
                result += 'ि';
                lastChar = 'ि';
                ptr += matchedKey.length;
                continue;
              }
              pendingI = true;
              ptr += matchedKey.length;
              continue;
            }

            let glyph = matchedUnicode;
            ptr += matchedKey.length;

            if (text.startsWith('X', ptr)) {
              glyph += '्र';
              ptr += 1;
            }

            if (pendingI) {
              glyph += 'ि';
              pendingI = false;
            }
            result += glyph;
            lastChar = glyph;
          } else {
            result += cur;
            lastChar = cur;
            ptr++;
          }
        }

        return result
          .replace(/([0-9०-९])ं([0-9०-९])/g, '$1/$2')
          .replace(/([0-9०-९])ः([0-9०-९])/g, '$1:$2');
      }

      function unicodeToAms(unicodeText) {
        if (!unicodeText) return '';
        let str = unicodeText;
        str = str.replace(/ङ्([कखगघ])/g, 'ं$1').replace(/ञ्([चछजझ])/g, 'ं$1');
        for (const [orig, repl] of Object.entries(LIGATURES)) {
          str = str.split(orig).join(repl);
        }

        let result = '';
        const chars = Array.from(str);

        for (let idx = 0; idx < chars.length; idx++) {
          const char = chars[idx];
          const next = chars[idx + 1] || '';
          const nnext = chars[idx + 2] || '';

          if (char === 'र' && next === '्' && idx + 2 < chars.length) {
            let aIdx = idx + 2;
            let acc = '';
            if (chars[aIdx + 1] === '्' && HALF_CONSONANTS[chars[aIdx] + chars[aIdx + 1]]) {
              acc += HALF_CONSONANTS[chars[aIdx] + chars[aIdx + 1]];
              aIdx += 2;
            }
            if (CONSONANTS[chars[aIdx]]) {
              acc += CONSONANTS[chars[aIdx]];
              if (++aIdx < chars.length && MATRAS[chars[aIdx]]) {
                acc += MATRAS[chars[aIdx]];
                aIdx++;
              }
              result += acc + 'Q';
              idx = aIdx - 1;
              continue;
            }
          }

          if (CONSONANTS[char] || HALF_CONSONANTS[char + next]) {
            let aIdx = idx;
            let acc = '';
            let hasI = false;
            while (aIdx < chars.length) {
              const cur = chars[aIdx];
              const curNext = chars[aIdx + 1];
              const curNnext = chars[aIdx + 2];
              if (curNext === '्' && curNnext === 'र') {
                acc += (CONSONANTS[cur] || cur) + 'X';
                aIdx += 3;
                if (chars[aIdx] === 'ि') {
                  hasI = true;
                  aIdx++;
                }
                break;
              }
              if (curNext === '्') {
                acc += HALF_CONSONANTS[cur + curNext] || cur;
                aIdx += 2;
              } else {
                acc += CONSONANTS[cur] || cur;
                aIdx++;
                if (chars[aIdx] === 'ि') {
                  hasI = true;
                  aIdx++;
                }
                break;
              }
            }
            if (hasI) {
              result += 'i' + acc;
              idx = aIdx - 1;
              continue;
            }
          }

          if (next === '्' && nnext === 'र') {
            result += (CONSONANTS[char] || char) + 'X';
            idx += 2;
            continue;
          }

          if (next === '्') {
            const pair = char + next;
            result += HALF_CONSONANTS[pair] || char;
            idx++;
            continue;
          }

          if (CONSONANTS[char]) result += CONSONANTS[char];
          else if (INDEPENDENT_VOWELS[char]) result += INDEPENDENT_VOWELS[char];
          else if (MATRAS[char]) result += MATRAS[char];
          else if (NUMERALS[char]) result += NUMERALS[char];
          else result += char;
        }
        return result;
      }

      // Universal text node recursion that skips English spans
      function convertNodesRecursively(node) {
        if (!node) return;
        if (node.nodeType === 1) {
          if (node.getAttribute('data-eng') === 'true' || node.classList.contains('eng-text')) {
            if (!/[\u0900-\u097F]/.test(node.textContent)) {
              return;
            }
            node.removeAttribute('data-eng');
            node.classList.remove('eng-text');
          }
          const children = Array.from(node.childNodes);
          for (let i = 0; i < children.length; i++) {
            convertNodesRecursively(children[i]);
          }
        } else if (node.nodeType === 3) {
          const text = node.nodeValue;
          if (text && text.length > 0) {
            node.nodeValue = amsToUnicode(text);
          }
        }
      }

      // 2. UI State
      let inputAmsVisual = true;
      let currentFontSize = 20;

      const editorInput = document.getElementById('editor-input');
      const editorOutput = document.getElementById('editor-output');
      const inputFontTag = document.getElementById('input-font-tag');

      const inputCharCount = document.getElementById('input-char-count');
      const inputWordCount = document.getElementById('input-word-count');
      const outputCharCount = document.getElementById('output-char-count');
      const outputWordCount = document.getElementById('output-word-count');

      const modeBtnUniToAms = document.getElementById('mode-uni-to-ams');
      const swapModeBtn = document.getElementById('swap-mode-btn');
      const btnToggleInputFont = document.getElementById('btn-toggle-input-font');

      const btnFontSmaller = document.getElementById('btn-font-smaller');
      const btnFontLarger = document.getElementById('btn-font-larger');
      const labelFontSize = document.getElementById('label-font-size');

      const btnSampleText = document.getElementById('btn-sample-text');
      const btnPasteInput = document.getElementById('btn-paste-input');
      const btnClearInput = document.getElementById('btn-clear-input');

      const btnCopyRich = document.getElementById('btn-copy-rich');
      const btnCopyPlain = document.getElementById('btn-copy-plain');
      const btnDownloadDoc = document.getElementById('btn-download-doc');
      const btnDownloadTxt = document.getElementById('btn-download-txt');
      const btnPrintDoc = document.getElementById('btn-print-doc');
      const copyStatusIndicator = document.getElementById('copy-status-indicator');
      const toastEl = document.getElementById('converter-toast');

      const fmtButtons = document.querySelectorAll('.fmt-btn');

      const SAMPLE_GUIDE_UNICODE = `<h2>इन्डियाफन्ट एएमएस तथा नेपाली युनिकोड प्रयोग निर्देशिका</h2><p>यो नेपालको आधुनिक <b><span class="eng-text" data-eng="true">TopNepali</span></b> अनलाइन टाइपिङ तथा एएमएस क्यालिग्राफी फन्ट रूपान्तरण प्लेटफर्म हो । यसले <i><span class="eng-text" data-eng="true">Adobe Photoshop</span></i>, <i><span class="eng-text" data-eng="true">CorelDRAW</span></i>, तथा <i><span class="eng-text" data-eng="true">Microsoft Word</span></i> को लागि पूर्ण फर्म्याटिङ संरक्षण गर्दछ ।</p><h3>प्रमुख एएमएस नमुना वाक्यांशहरू <span class="eng-text" data-eng="true">(Sample Calligraphy Headlines)</span> :</h3><ul><li><b>शुभ विवाह तथा मांगलिक कार्य :</b> विवाह निमन्त्रणा र ब्यानर डिजाइनको लागि लोकप्रिय एएमएस मन्त्र फन्ट ।</li><li><b>हार्दिक निमन्त्रणा तथा स्वागतम् :</b> विवाह, पास्नी, र औपचारिक समारोहका आकर्षक शीर्षकहरू ।</li><li><b>श्रीमान् तथा श्रीमती :</b> हलन्त, रेफ, र संयुक्त अक्षरहरूको शुद्ध र सटीक रूपान्तरण ।</li><li><b>जननी जन्मभूमिश्च स्वर्गादपि गरीयसी :</b> नेपाल मेरो गौरवमय देश हो ।</li></ul><p>तपाईं आफ्नो पाठ यहाँ सिधै टाइप गर्न वा बाहिरबाट <b><span class="eng-text" data-eng="true">Paste</span></b> गरी तत्काल रूपान्तरण गर्न सक्नुहुन्छ ।</p>`;

      function getSampleGuideAms() {
        const div = document.createElement('div');
        div.innerHTML = SAMPLE_GUIDE_UNICODE;
        function recurse(n) {
          if (!n) return;
          if (n.nodeType === 1) {
            if (n.getAttribute('data-eng') === 'true' || n.classList.contains('eng-text')) return;
            const children = Array.from(n.childNodes);
            for (let i = 0; i < children.length; i++) recurse(children[i]);
          } else if (n.nodeType === 3) {
            if (n.nodeValue) n.nodeValue = unicodeToAms(n.nodeValue);
          }
        }
        recurse(div);
        return div.innerHTML;
      }

      function showToast(msg) {
        if (toastEl) {
          toastEl.textContent = msg;
          toastEl.classList.add('is-visible');
          setTimeout(() => toastEl.classList.remove('is-visible'), 2200);
        }
        if (copyStatusIndicator) {
          copyStatusIndicator.textContent = msg;
          copyStatusIndicator.style.opacity = '1';
          setTimeout(() => { copyStatusIndicator.style.opacity = '0'; }, 2200);
        }
      }

      function setEditorFontSize(size) {
        currentFontSize = Math.max(14, Math.min(36, size));
        if (editorInput) editorInput.style.fontSize = `${currentFontSize}px`;
        if (editorOutput) editorOutput.style.fontSize = `${currentFontSize}px`;
        if (labelFontSize) labelFontSize.textContent = `${currentFontSize}px`;
      }

      function applyAmsVisualState() {
        if (inputAmsVisual) {
          editorInput.setAttribute('data-ams-visual', 'true');
          editorInput.classList.add('font-ams');
          editorInput.classList.remove('font-ascii');
          editorInput.style.fontFamily = "'Font_ams', 'AMS Mantra', 'AMS Kirti', 'AMS Aaditya', monospace";
          if (inputFontTag) inputFontTag.textContent = 'AMS Visual';
        } else {
          editorInput.setAttribute('data-ams-visual', 'false');
          editorInput.classList.remove('font-ams');
          editorInput.classList.add('font-ascii');
          editorInput.style.fontFamily = "'JetBrains Mono', monospace";
          if (inputFontTag) inputFontTag.textContent = 'Raw ASCII Keys';
        }
      }

      function calculateStats(text) {
        const chars = text.length;
        const trimmed = text.trim();
        const words = trimmed ? trimmed.split(/\s+/).length : 0;
        return { chars, words };
      }

      function runConversion() {
        try {
          const inputText = editorInput.innerText || '';
          const inStats = calculateStats(inputText);
          if (inputCharCount) inputCharCount.textContent = inStats.chars.toLocaleString();
          if (inputWordCount) inputWordCount.textContent = inStats.words.toLocaleString();

          if (!inputText.trim()) {
            editorOutput.innerHTML = '';
            if (outputCharCount) outputCharCount.textContent = '0';
            if (outputWordCount) outputWordCount.textContent = '0';
            return;
          }

          const clone = editorInput.cloneNode(true);
          convertNodesRecursively(clone);
          editorOutput.innerHTML = clone.innerHTML;

          const outText = editorOutput.innerText || '';
          const outStats = calculateStats(outText);
          if (outputCharCount) outputCharCount.textContent = outStats.chars.toLocaleString();
          if (outputWordCount) outputWordCount.textContent = outStats.words.toLocaleString();
        } catch (e) {
          console.error('Conversion error:', e);
        }
      }

      // Real-time conversion on keystroke
      let debounceTimer = null;
      editorInput.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(runConversion, 15);
      });

      // Handle pasting Unicode directly into AMS box
      editorInput.addEventListener('paste', (e) => {
        const text = e.clipboardData?.getData('text/plain') || '';
        if (hasDevanagari(text)) {
          e.preventDefault();
          const amsAscii = unicodeToAms(text);
          document.execCommand('insertText', false, amsAscii);
          showToast('Converted pasted Unicode to AMS Visual');
          runConversion();
        }
      });

      // Toolbar formatting commands
      fmtButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const cmd = btn.dataset.cmd;
          const val = btn.dataset.val || null;
          editorInput.focus();
          document.execCommand(cmd, false, val);
          runConversion();
        });
      });

      // Mode Switch & Text Swap to Unicode to AMS
      function switchAndSwapToUnicodeToAms() {
        const textToCarry = (editorOutput && editorOutput.innerHTML.trim())
          ? editorOutput.innerHTML
          : (editorInput ? editorInput.innerHTML : '');
        if (textToCarry) {
          sessionStorage.setItem('tn_converter_swap_text', textToCarry);
        }
        window.location.href = '/unicode-to-ams';
      }

      if (modeBtnUniToAms) {
        modeBtnUniToAms.addEventListener('click', switchAndSwapToUnicodeToAms);
      }
      if (swapModeBtn) {
        swapModeBtn.addEventListener('click', switchAndSwapToUnicodeToAms);
      }

      // AMS View Toggle (Input Pane)
      if (btnToggleInputFont) {
        btnToggleInputFont.addEventListener('click', () => {
          inputAmsVisual = !inputAmsVisual;
          applyAmsVisualState();
        });
      }

      // Font Size Controls
      if (btnFontSmaller) {
        btnFontSmaller.addEventListener('click', () => setEditorFontSize(currentFontSize - 2));
      }
      if (btnFontLarger) {
        btnFontLarger.addEventListener('click', () => setEditorFontSize(currentFontSize + 2));
      }

      // Sample Text
      btnSampleText.addEventListener('click', () => {
        editorInput.innerHTML = getSampleGuideAms();
        runConversion();
        showToast('Loaded complete AMS usage guide');
      });

      // Paste Button
      btnPasteInput.addEventListener('click', async () => {
        try {
          const text = await navigator.clipboard.readText();
          if (text) {
            editorInput.focus();
            if (hasDevanagari(text)) {
              const amsAscii = unicodeToAms(text);
              document.execCommand('insertText', false, amsAscii);
            } else {
              document.execCommand('insertText', false, text);
            }
            runConversion();
          }
        } catch {
          editorInput.focus();
        }
      });

      // Clear Button
      btnClearInput.addEventListener('click', () => {
        editorInput.innerHTML = '';
        editorOutput.innerHTML = '';
        if (inputCharCount) inputCharCount.textContent = '0';
        if (inputWordCount) inputWordCount.textContent = '0';
        if (outputCharCount) outputCharCount.textContent = '0';
        if (outputWordCount) outputWordCount.textContent = '0';
        editorInput.focus();
      });

      // Copy Formatted (Word & Google Docs)
      btnCopyRich.addEventListener('click', async () => {
        const htmlData = editorOutput.innerHTML;
        const textData = editorOutput.innerText || '';
        if (!textData.trim()) return;

        try {
          if (navigator.clipboard && window.ClipboardItem) {
            const blobHtml = new Blob([htmlData], { type: 'text/html' });
            const blobText = new Blob([textData], { type: 'text/plain' });
            await navigator.clipboard.write([
              new ClipboardItem({
                'text/html': blobHtml,
                'text/plain': blobText
              })
            ]);
            showToast('Copied formatted text for Word & Google Docs');
          } else {
            await navigator.clipboard.writeText(textData);
            showToast('Copied to clipboard');
          }
        } catch {
          const range = document.createRange();
          range.selectNodeContents(editorOutput);
          const sel = window.getSelection();
          sel.removeAllRanges();
          sel.addRange(range);
          document.execCommand('copy');
          sel.removeAllRanges();
          showToast('Copied to clipboard');
        }
      });

      // Copy Plain Text
      btnCopyPlain.addEventListener('click', async () => {
        const textData = editorOutput.innerText || '';
        if (!textData.trim()) return;
        try {
          await navigator.clipboard.writeText(textData);
          showToast('Copied plain text');
        } catch {
          const temp = document.createElement('textarea');
          temp.value = textData;
          document.body.appendChild(temp);
          temp.select();
          document.execCommand('copy');
          document.body.removeChild(temp);
          showToast('Copied plain text');
        }
      });

      // Download Formatted Word Document (.doc with bilingual font preserved)
      if (btnDownloadDoc) {
        btnDownloadDoc.addEventListener('click', () => {
          const htmlContent = editorOutput.innerHTML;
          if (!htmlContent.trim()) return;

          const docHtml = `<!DOCTYPE html>
<html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
<head>
<meta charset='utf-8'>
<title>Nepali Unicode Document</title>
<!--[if gte mso 9]>
<xml>
  <w:WordDocument>
    <w:View>Print</w:View>
    <w:Zoom>100</w:Zoom>
    <w:DoNotOptimizeForBrowser/>
  </w:WordDocument>
</xml>
<![endif]-->
<style>
  body {
    font-family: 'Mukta', 'Kalimati', 'Kokila', Arial, sans-serif;
    font-size: 14pt;
    line-height: 1.6;
    color: #000000;
  }
  .eng-text {
    font-family: Arial, Calibri, sans-serif !important;
  }
  h1, h2, h3, h4 {
    font-family: 'Mukta', 'Kalimati', Arial, sans-serif;
    color: #000000;
  }
  p { margin: 0 0 10pt 0; }
  ul, ol { margin-bottom: 10pt; }
</style>
</head>
<body>
  ${htmlContent}
</body>
</html>`;

          const blob = new Blob(['\ufeff', docHtml], { type: 'application/msword;charset=utf-8' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = 'nepali-unicode.doc';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
          showToast('Downloaded Word document (formatting preserved)');
        });
      }

      // Download Plain Text (.txt)
      btnDownloadTxt.addEventListener('click', () => {
        const textData = editorOutput.innerText || '';
        if (!textData.trim()) return;
        const blob = new Blob([textData], { type: 'text/plain;charset=utf-8' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'nepali-unicode.txt';
        a.click();
        URL.revokeObjectURL(a.href);
        showToast('Downloaded nepali-unicode.txt');
      });

      // Print Document
      btnPrintDoc.addEventListener('click', () => {
        const printWin = window.open('', '', 'width=840,height=640');
        if (!printWin) return;
        printWin.document.write(`
          <!DOCTYPE html>
          <html>
            <head>
              <title>TopNepali Document Print</title>
              <style>
                body { font-family: 'Font_kokila', 'Mukta', -apple-system, sans-serif; padding: 40px; line-height: 1.8; color: #111; font-size: 18px; }
                .eng-text { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important; }
                h1, h2, h3 { color: #000; margin-top: 1.5em; margin-bottom: 0.5em; }
              </style>
            </head>
            <body>
              ${editorOutput.innerHTML}
            </body>
          </html>
        `);
        printWin.document.close();
        printWin.focus();
        printWin.print();
        printWin.close();
      });

      // Initial execution (respecting swapped carryover text from sessionStorage)
      setEditorFontSize(20);
      applyAmsVisualState();

      const carriedSwapText = sessionStorage.getItem('tn_converter_swap_text');
      if (carriedSwapText) {
        sessionStorage.removeItem('tn_converter_swap_text');
        editorInput.innerHTML = carriedSwapText;
        runConversion();
        showToast('Swapped text successfully');
      } else {
        editorInput.innerHTML = getSampleGuideAms();
        runConversion();
      }
    })();
  </script>
</Layout>
