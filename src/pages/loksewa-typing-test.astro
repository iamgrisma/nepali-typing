---
import Layout from '../layouts/Layout.astro';
import ModeSelector from '../components/ModeSelector.astro';
import TypingEngine from '../components/TypingEngine.astro';
import KeyboardVisualizer from '../components/KeyboardVisualizer.astro';
import DetailedStatsModal from '../components/DetailedStatsModal.astro';
import HistoryDrawer from '../components/HistoryDrawer.astro';

const pageTitle = "Loksewa Nepali Typing Test Simulator (5 Minutes) — TopNepali Typing";
const pageDesc = "Simulate the official Public Service Commission (Loksewa Aayog) 5-minute Nepali typing test for Computer Operator and Assistant Computer Operator exams. Practice marking formulas and error penalties.";
const canonicalUrl = "https://typing.topnepali.com/loksewa-typing-test";
const ogImageUrl = "https://img.topnepali.com/typing.tn/og/loksewa-svg.webp";
const keywords = "Loksewa typing test, Loksewa computer operator typing test, Loksewa 5 minute typing test, Nepali typing test for Loksewa, Loksewa typing marking scheme, Kharidar typing test, Nayab Subba computer practical exam, PSC typing syllabus";

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Loksewa Nepali Typing Test Simulator — Typeshala Bench",
  "alternateName": "Public Service Commission (PSC) Nepal 5-Minute Typing Simulator",
  "applicationCategory": "EducationalApplication",
  "operatingSystem": "All (Web, Windows, macOS, Linux, iOS, Android)",
  "browserRequirements": "Requires HTML5 & JavaScript enabled browser",
  "softwareVersion": "2.0",
  "url": canonicalUrl,
  "image": ogImageUrl,
  "description": pageDesc,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "NPR",
    "availability": "https://schema.org/InStock"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "bestRating": "5",
    "worstRating": "1",
    "ratingCount": "1980",
    "reviewCount": "1560"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the Loksewa Aayog Computer Operator typing test format?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Loksewa Aayog computer practical exam includes a 5-minute Nepali typing test and a 5-minute English typing test. Candidates must type a printed passage on a computer terminal under strict invigilation."
      }
    },
    {
      "@type": "Question",
      "name": "How does Loksewa calculate marks for typing tests?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Loksewa uses a Net Word formula: Net Words = Total Words Typed - (Errors × Penalty Factor). The Net Words are divided by 5 to find Net Words Per Minute (WPM). Minimum qualification is 20 Net WPM for Nepali and 25 Net WPM for English."
      }
    },
    {
      "@type": "Question",
      "name": "Which keyboard layout is used in Loksewa exams?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Loksewa exam centers generally provide standard MPP Nepali Unicode Traditional layout or Preeti ASCII font on Windows desktop PCs. Candidates can verify the specific layout designated in their exam admission card."
      }
    }
  ]
};
---

<Layout 
  title={pageTitle}
  description={pageDesc}
  canonicalUrl={canonicalUrl}
  ogImage={ogImageUrl}
  keywords={keywords}
  schema={[softwareSchema, faqSchema]}
  activeNav="loksewa"
>
  <div class="container px-4">
    
    <!-- Hero Introduction Header -->
    <header class="text-center max-w-3xl mx-auto pt-2 pb-5">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20 mb-2.5">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>
        <span>PSC / LOKSEWA 5-MINUTE EXAM SIMULATOR</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-extrabold font-display tracking-tight text-[var(--text-primary)]">
        Loksewa Nepali Typing Test Simulator (5 Minutes)
      </h1>
      <p class="text-xs sm:text-sm text-[var(--text-secondary)] mt-1.5 leading-relaxed">
        Realistic 300-second timed simulation matching Public Service Commission standards. Prepare for Computer Operator, Assistant Computer Operator, Kharidar, and Bank recruitment practicals.
      </p>
    </header>

    <!-- Preconfigured Mode Selector Toolbar (5 Minutes / 300 Seconds) -->
    <ModeSelector defaultLang="nepali_unicode" defaultMode="time" defaultDuration={300} />

    <!-- Core Interactive Typing Workbench -->
    <TypingEngine defaultLang="nepali_unicode" defaultMode="time" defaultDuration={300} />

    <!-- Interactive Hardware Keyboard Visualizer -->
    <KeyboardVisualizer defaultLang="nepali_unicode" />

    <!-- Loksewa Exam Specific Syllabus & Guide -->
    <section class="mt-10 pt-8 border-t border-[var(--border-subtle)] space-y-10">
      
      <!-- Key Exam Standards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="p-5 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] shadow-sm">
          <div class="flex items-center gap-2 mb-2">
            <svg class="w-4 h-4 text-purple-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            <h3 class="font-bold text-sm text-[var(--text-primary)]">300 Seconds (5 Min) Module</h3>
          </div>
          <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
            Exactly replicates the standard 5-minute timed examination window stipulated in Loksewa Aayog (PSC) computer practical syllabus.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] shadow-sm">
          <div class="flex items-center gap-2 mb-2">
            <svg class="w-4 h-4 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            <h3 class="font-bold text-sm text-[var(--text-primary)]">Pass Threshold: &ge; 20 Net WPM</h3>
          </div>
          <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
            Candidates must type at least 100 net correct words in 5 minutes (average &ge; 20 Net WPM) with &ge; 85% accuracy to qualify for final selection.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] shadow-sm">
          <div class="flex items-center gap-2 mb-2">
            <svg class="w-4 h-4 text-sky-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            <h3 class="font-bold text-sm text-[var(--text-primary)]">Civic Examination Corpora</h3>
          </div>
          <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
            Practice with authentic administrative, constitutional, and civic governance passages designed to match real exam hall test papers.
          </p>
        </div>
      </div>

      <!-- Syllabus & Posts Breakdown Table -->
      <article class="bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-2xl p-6 sm:p-8 shadow-sm">
        <h2 class="text-lg font-bold font-display text-[var(--text-primary)] mb-3">
          Public Service Commission (Loksewa Aayog) Practical Examination Syllabus
        </h2>
        <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed mb-6">
          The computer practical examination is conducted in stage two for administrative and technical appointments. Below is the official syllabus and speed allocation across public posts:
        </p>

        <div class="overflow-x-auto text-xs">
          <table class="w-full border-collapse border border-[var(--border-subtle)] text-left">
            <thead>
              <tr class="bg-[var(--bg-surface-subtle)] text-[var(--text-primary)] font-bold">
                <th class="p-3 border border-[var(--border-subtle)]">Exam / Post</th>
                <th class="p-3 border border-[var(--border-subtle)]">Service Level</th>
                <th class="p-3 border border-[var(--border-subtle)]">Nepali Speed (5 Min)</th>
                <th class="p-3 border border-[var(--border-subtle)]">English Speed (5 Min)</th>
                <th class="p-3 border border-[var(--border-subtle)]">Marking Weight</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[var(--border-subtle)] text-[var(--text-secondary)]">
              <tr>
                <td class="p-3 border border-[var(--border-subtle)] font-semibold text-[var(--text-primary)]">Computer Operator (कम्प्युटर अपरेटर)</td>
                <td class="p-3 border border-[var(--border-subtle)]">Non-Gazetted 1st / 5th Level</td>
                <td class="p-3 border border-[var(--border-subtle)]">&ge; 20 Net WPM</td>
                <td class="p-3 border border-[var(--border-subtle)]">&ge; 25 Net WPM</td>
                <td class="p-3 border border-[var(--border-subtle)]">5 Marks (Nepali) + 5 Marks (English)</td>
              </tr>
              <tr>
                <td class="p-3 border border-[var(--border-subtle)] font-semibold text-[var(--text-primary)]">Assistant Computer Operator (सहायक कम्प्युटर अपरेटर)</td>
                <td class="p-3 border border-[var(--border-subtle)]">Non-Gazetted 2nd / 4th Level</td>
                <td class="p-3 border border-[var(--border-subtle)]">&ge; 18–20 Net WPM</td>
                <td class="p-3 border border-[var(--border-subtle)]">&ge; 22–25 Net WPM</td>
                <td class="p-3 border border-[var(--border-subtle)]">Practical Paper Component</td>
              </tr>
              <tr>
                <td class="p-3 border border-[var(--border-subtle)] font-semibold text-[var(--text-primary)]">Kharidar & Nayab Subba (खरिदार / नायब सुब्बा)</td>
                <td class="p-3 border border-[var(--border-subtle)]">Administration / Judiciary</td>
                <td class="p-3 border border-[var(--border-subtle)]">&ge; 15–20 Net WPM</td>
                <td class="p-3 border border-[var(--border-subtle)]">&ge; 20 Net WPM</td>
                <td class="p-3 border border-[var(--border-subtle)]">Computer Skill Test (Pass Required)</td>
              </tr>
              <tr>
                <td class="p-3 border border-[var(--border-subtle)] font-semibold text-[var(--text-primary)]">Public Banks (RBB, NBL, ADBL, NRB)</td>
                <td class="p-3 border border-[var(--border-subtle)]">Assistant / Officer Level</td>
                <td class="p-3 border border-[var(--border-subtle)]">&ge; 20 Net WPM</td>
                <td class="p-3 border border-[var(--border-subtle)]">&ge; 25 Net WPM</td>
                <td class="p-3 border border-[var(--border-subtle)]">Practical Interview Qualification</td>
              </tr>
            </tbody>
          </table>
        </div>
      </article>

      <!-- Loksewa Evaluation Formula & Marking Breakdown -->
      <article class="bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-2xl p-6 sm:p-8 shadow-sm">
        <h2 class="text-lg font-bold font-display text-[var(--text-primary)] mb-4">
          Public Service Commission Typing Marking System & Error Penalty Formula
        </h2>
        
        <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed mb-6">
          In Public Service Commission practical examinations, speed alone does not guarantee a passing grade. Every mistyped letter, missing punctuation, or skipped word penalizes your final score:
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs">
          <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
            <h3 class="font-bold text-sm text-[var(--text-primary)] mb-2.5">Official Marking Formula</h3>
            <div class="p-3 rounded-lg bg-[var(--bg-surface)] border border-[var(--border-subtle)] font-mono text-[11px] mb-3">
              Net Words = Gross Words Typed - (Errors &times; Penalty Factor)<br />
              Net Speed (WPM) = Net Words / 5 Minutes<br />
              Accuracy (%) = (Net Words / Gross Words Typed) &times; 100
            </div>
            <p class="text-[var(--text-secondary)] leading-relaxed">
              If a candidate types 130 words with 10 uncorrected errors in 5 minutes, their Net Words drop to 120, yielding <strong>24 Net WPM</strong> (Pass). However, if an over-eager typist attempts 150 words but commits 35 uncorrected errors, their Net Words plunge to 115, lowering their speed to <strong>19 Net WPM</strong> and resulting in disqualification.
            </p>
          </div>

          <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
            <h3 class="font-bold text-sm text-[var(--text-primary)] mb-2.5">Exam Day Hall Strategies</h3>
            <ul class="space-y-2 text-[var(--text-secondary)]">
              <li><strong>Prioritize Accuracy Over Blind Speed:</strong> Rushing leads to compounding errors that cost valuable marks and break typing rhythm.</li>
              <li><strong>Physical Keyboard Inspection:</strong> Test key travel during the 2-minute warmup. Confirm the Space bar, Backslash (\), and Shift keys respond smoothly.</li>
              <li><strong>Watch Punctuation Closely:</strong> Ensure Devanagari full stops (।), commas (,), and hyphens match the printed question paper accurately.</li>
              <li><strong>Maintain Pacing Cadence:</strong> Avoid sprinting through easy words and freezing on complex conjuncts. A consistent 22-25 WPM rhythm easily secures full marks.</li>
            </ul>
          </div>
        </div>
      </article>

      <!-- FAQ Section -->
      <section class="bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-2xl p-6 sm:p-8 shadow-sm">
        <h2 class="text-lg font-bold font-display text-[var(--text-primary)] mb-4">
          Loksewa Practical Typing Exam FAQs
        </h2>
        
        <div class="space-y-4 text-xs sm:text-sm">
          <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
            <h3 class="font-bold text-[var(--text-primary)] mb-1.5">What is the minimum passing score in the Loksewa typing test?</h3>
            <p class="text-[var(--text-secondary)] leading-relaxed">
              Candidates must obtain at least 20 Net WPM in Nepali typing and 25 Net WPM in English typing with a minimum of 85% accuracy. Scoring below 20 Net WPM in Nepali leads to automatic disqualification in the computer practical phase.
            </p>
          </div>

          <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
            <h3 class="font-bold text-[var(--text-primary)] mb-1.5">Which keyboard layout is provided in Loksewa examination halls?</h3>
            <p class="text-[var(--text-secondary)] leading-relaxed">
              Most examination centers designate standard Nepali Unicode Traditional layout on Windows desktop terminals. Some centers also support Preeti font based on the specific advertisement syllabus. Candidates can practice both modes on Typeshala Bench.
            </p>
          </div>

          <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
            <h3 class="font-bold text-[var(--text-primary)] mb-1.5">Can I also practice English typing for Loksewa here?</h3>
            <p class="text-[var(--text-secondary)] leading-relaxed">
              Yes, navigate to our dedicated <a href="/english-typing-test" class="text-purple-600 dark:text-purple-400 font-bold hover:underline">English Typing Speed Test</a> to practice the 5-minute English module (&ge; 25 WPM) required by the Public Service Commission.
            </p>
          </div>

          <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
            <h3 class="font-bold text-[var(--text-primary)] mb-1.5">How does the 300-second timer on this page simulate the real test?</h3>
            <p class="text-[var(--text-secondary)] leading-relaxed">
              The 300-second countdown replicates the uninterrupted 5-minute test window. Live WPM, gross strokes, uncorrected errors, and Net WPM are computed dynamically, simulating real PSC examination scoring upon test completion.
            </p>
          </div>
        </div>
      </section>

    </section>

    <!-- Modals & Drawers -->
    <DetailedStatsModal />
    <HistoryDrawer />

  </div>
</Layout>
