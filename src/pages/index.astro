---
import Layout from '../layouts/Layout.astro';
import ModeSelector from '../components/ModeSelector.astro';
import TypingEngine from '../components/TypingEngine.astro';
import KeyboardVisualizer from '../components/KeyboardVisualizer.astro';
import DetailedStatsModal from '../components/DetailedStatsModal.astro';
import HistoryDrawer from '../components/HistoryDrawer.astro';
import SeoContent from '../components/SeoContent.astro';
import FaqSection from '../components/FaqSection.astro';
---

<Layout 
  title="Typeshala Bench — Online Nepali & English Typing Test, Speed Benchmark & Certification"
  description="Practice on the modern Typeshala Bench across English QWERTY, Nepali Unicode Traditional, Romanized Phonetic, and Preeti ASCII. Test your real-time WPM typing speed with authentic Dantya Katha stories, adaptive drills, and verifiable certificates."
  canonicalUrl="https://typing.topnepali.com"
  ogImage="https://img.topnepali.com/typing.tn/og/default-svg.webp"
  activeNav="test"
>
  <div class="container px-4">
    <!-- Primary SEO Landmark Heading (Single H1) -->
    <h1 class="sr-only">Typeshala Bench — Online Nepali &amp; English Typing Speed Test &amp; Benchmark</h1>

    <!-- Mode Selector Toolbar -->
    <ModeSelector />

    <!-- Core Interactive Typing Workbench -->
    <TypingEngine />

    <!-- Interactive Hardware Keyboard Visualizer -->
    <KeyboardVisualizer defaultLang="nepali_unicode" />

    <!-- Comprehensive Authoritative English Educational & SEO Guide -->
    <SeoContent />

    <!-- Structured FAQs Section with JSON-LD -->
    <FaqSection />

    <!-- Modals & Drawers -->
    <DetailedStatsModal />
    <HistoryDrawer />

  </div>
</Layout>
