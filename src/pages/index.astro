  <!-- Client Script for Interactive Home Layout Map Tabs & Character Lookup -->
  <script is:inline type="module">
    import { state } from '/js/core/state.js';
    import { renderKeyboard } from '/js/ui/keyboard-view.js';
    import { KEY_ROWS } from '/js/data/keyboards.js';

    function initHomeLayoutSection() {
      const tabBtns = document.querySelectorAll('.home-layout-tab-btn');
      const directLink = document.getElementById('home-tab-direct-link');
      const searchInput = document.getElementById('home-char-search');

      const MODE_URLS = {
        nepali_unicode: { url: '/nepali-traditional-typing-test', title: 'Launch Traditional Test Bench' },
        nepali_romanized: { url: '/romanized-nepali-typing-test', title: 'Launch Romanized Test Bench' },
        nepali_preeti: { url: '/preeti-typing-test', title: 'Launch Preeti Test Bench' },
        english: { url: '/english-typing-test', title: 'Launch English Test Bench' }
      };

      // Tab switcher
      tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          tabBtns.forEach(b => {
            b.classList.remove('active', 'bg-[var(--accent-primary)]', 'text-white', 'font-bold');
            b.classList.add('bg-[var(--bg-surface-subtle)]', 'text-[var(--text-secondary)]', 'font-semibold');
          });
          btn.classList.add('active', 'bg-[var(--accent-primary)]', 'text-white', 'font-bold');
          btn.classList.remove('bg-[var(--bg-surface-subtle)]', 'text-[var(--text-secondary)]', 'font-semibold');

          const selectedLayout = btn.dataset.layout;
          state.lang = selectedLayout;
          renderKeyboard();

          if (directLink && MODE_URLS[selectedLayout]) {
            directLink.href = MODE_URLS[selectedLayout].url;
            const span = directLink.querySelector('span');
            if (span) span.textContent = MODE_URLS[selectedLayout].title;
          }
        });
      });

      // Character search
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          const q = e.target.value.trim();
          document.querySelectorAll('.keycap.is-target').forEach(el => el.classList.remove('is-target'));
          if (!q) return;

          let found = null;
          for (const row of KEY_ROWS) {
            for (const k of row) {
              if (k.special || k.shell) continue;
              const chNormal = state.lang === 'nepali_unicode' ? k.uni?.[0] :
                               state.lang === 'nepali_romanized' ? k.rom?.[0] :
                               state.lang === 'nepali_preeti' ? k.pre?.[2] : k.eng?.[0];
              const chShift = state.lang === 'nepali_unicode' ? k.uni?.[1] :
                              state.lang === 'nepali_romanized' ? k.rom?.[1] :
                              state.lang === 'nepali_preeti' ? k.pre?.[3] : k.eng?.[1];

              if (chNormal === q || (chNormal && chNormal.includes(q))) {
                found = { code: k.code };
                break;
              }
              if (chShift === q || (chShift && chShift.includes(q))) {
                found = { code: k.code };
                break;
              }
            }
            if (found) break;
          }

          if (found) {
            const targetEl = document.querySelector(`.keycap[data-code="${found.code}"]`);
            if (targetEl) targetEl.classList.add('is-target');
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHomeLayoutSection);
    } else {
      initHomeLayoutSection();
    }
  </script>
