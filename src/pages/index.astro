---
import Layout from '../layouts/Layout.astro';
import ModeSelector from '../components/ModeSelector.astro';
import TypingEngine from '../components/TypingEngine.astro';
import KeyboardVisualizer from '../components/KeyboardVisualizer.astro';
import DetailedStatsModal from '../components/DetailedStatsModal.astro';
import HistoryDrawer from '../components/HistoryDrawer.astro';
import SeoContent from '../components/SeoContent.astro';
import FaqSection from '../components/FaqSection.astro';
---

<Layout>
  <div class="container">
    
    <!-- Hero / Intro Badge -->
    <div class="text-center mb-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-red-500/10 text-red-600 dark:text-red-400 border border-red-500/20 mb-2">
        <span>🇳🇵 नेपाली भाषा, साहित्य र प्रविधिको टाइपिङ प्लेटफर्म</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold font-display tracking-tight text-[var(--text-primary)]">
        नेपाली Typing Test <span class="text-[var(--accent-primary)]">PRO</span>
      </h1>
      <p class="text-xs sm:text-sm text-[var(--text-muted)] max-w-xl mx-auto mt-1">
        नेपाली युनिकोड (ट्रेडिसनल र रोमनाइज्ड), प्रिती फन्ट र अङ्ग्रेजी किबोर्डमा वास्तविक समयको विश्लेषणसहित टाइपिङ अभ्यास।
      </p>
    </div>

    <!-- Mode Selector Toolbar -->
    <ModeSelector />

    <!-- Core Interactive Typing Workbench -->
    <TypingEngine />

    <!-- Interactive Hardware Keyboard Visualizer -->
    <KeyboardVisualizer />

    <!-- Rich Cultural, Literary & Educational SEO Guides -->
    <SeoContent />

    <!-- Structured FAQs Section -->
    <FaqSection />

    <!-- Modals & Drawers -->
    <DetailedStatsModal />
    <HistoryDrawer />

  </div>
</Layout>
