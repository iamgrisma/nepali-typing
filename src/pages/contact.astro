---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

const pageTitle = "Contact & Support — Typeshala Bench & TopNepali";
const pageDesc = "Connect with the Typeshala Bench engineering and editorial team. Submit bug reports, request custom institutional typing tests, or inquire about typography drivers.";
const canonicalUrl = "https://typing.topnepali.com/contact";
const ogImageUrl = "https://img.topnepali.com/typing.tn/og/contact-svg.webp";
const keywords = "Contact Typeshala, Typeshala support, Nepali typing bug report, TopNepali contact, typing exam support";
---

<Layout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl={canonicalUrl}
  ogImage={ogImageUrl}
  keywords={keywords}
  activeNav="contact"
>
  <div class="container max-w-4xl py-6 sm:py-8 space-y-10">

    <!-- Header / Hero -->
    <header class="text-center max-w-2xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-sky-500/10 text-sky-600 dark:text-sky-400 border border-sky-500/20">
        <Icon name="lucide:message-square" class="w-3.5 h-3.5" />
        <span>DIRECT CHANNELS &amp; INQUIRIES</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold font-display tracking-tight text-[var(--text-primary)]">
        Contact & Support
      </h1>
      <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
        Have feedback, discovered an uncommon ligated glyph bug, or want to deploy customized typing benchmarks for your institute? We are here to help.
      </p>
    </header>

    <!-- Contact Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

      <!-- Card 1: Direct Support Email -->
      <div class="bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-2xl p-6 sm:p-7 space-y-3 shadow-sm flex flex-col justify-between">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-xl bg-rose-500/10 text-rose-500 flex items-center justify-center border border-rose-500/20">
            <Icon name="lucide:mail" class="w-5 h-5" />
          </div>
          <h2 class="text-lg font-bold font-display text-[var(--text-primary)]">
            Email Support
          </h2>
          <p class="text-xs sm:text-sm text-[var(--text-muted)] leading-relaxed">
            For general questions, certificate verification inquiries, privacy data requests, or partnership discussions:
          </p>
          <div class="pt-1">
            <a 
              href="mailto:typing@topnepali.com" 
              class="text-sm sm:text-base font-bold text-rose-500 hover:underline flex items-center gap-1.5"
            >
              <span>typing@topnepali.com</span>
              <Icon name="lucide:arrow-up-right" class="w-4 h-4" />
            </a>
          </div>
        </div>
        <p class="text-[11px] text-[var(--text-muted)] pt-3 border-t border-[var(--border-subtle)]">
          Typical response latency: Within 24 hours on business days.
        </p>
      </div>

      <!-- Card 2: Technical Support & Feedback -->
      <div class="bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-2xl p-6 sm:p-7 space-y-3 shadow-sm flex flex-col justify-between">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-xl bg-purple-500/10 text-purple-500 flex items-center justify-center border border-purple-500/20">
            <Icon name="lucide:message-square" class="w-5 h-5" />
          </div>
          <h2 class="text-lg font-bold font-display text-[var(--text-primary)]">
            Technical Feedback & Reports
          </h2>
          <p class="text-xs sm:text-sm text-[var(--text-muted)] leading-relaxed">
            Report keyboard visualizer quirks, Unicode grapheme segmentation suggestions, or request new Dantya Katha stories:
          </p>
          <div class="pt-1">
            <a 
              href="mailto:contact@topnepali.com?subject=Typeshala%20Technical%20Feedback" 
              class="text-sm sm:text-base font-bold text-purple-500 hover:underline flex items-center gap-1.5"
            >
              <span>contact@topnepali.com</span>
              <Icon name="lucide:arrow-up-right" class="w-4 h-4" />
            </a>
          </div>
        </div>
        <p class="text-[11px] text-[var(--text-muted)] pt-3 border-t border-[var(--border-subtle)]">
          Direct engineering desk for platform improvements and custom dictionary feedback.
        </p>
      </div>

      <!-- Card 3: Institutional & Examination Tests -->
      <div class="bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-2xl p-6 sm:p-7 space-y-3 shadow-sm flex flex-col justify-between">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center border border-emerald-500/20">
            <Icon name="lucide:building-2" class="w-5 h-5" />
          </div>
          <h2 class="text-lg font-bold font-display text-[var(--text-primary)]">
            Colleges &amp; Training Institutes
          </h2>
          <p class="text-xs sm:text-sm text-[var(--text-muted)] leading-relaxed">
            Computer operator training centers and educational institutions looking to conduct proctored cohort examinations with bulk verification.
          </p>
        </div>
        <div class="pt-3 border-t border-[var(--border-subtle)]">
          <a 
            href="mailto:typing@topnepali.com?subject=Institutional%20Typing%20Exam%20Inquiry" 
            class="text-xs font-bold text-emerald-500 hover:underline"
          >
            Request Institutional Access &rarr;
          </a>
        </div>
      </div>

      <!-- Card 4: TopNepali Network Ecosystem -->
      <div class="bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-2xl p-6 sm:p-7 space-y-3 shadow-sm flex flex-col justify-between">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-xl bg-blue-500/10 text-blue-500 flex items-center justify-center border border-blue-500/20">
            <Icon name="lucide:globe" class="w-5 h-5" />
          </div>
          <h2 class="text-lg font-bold font-display text-[var(--text-primary)]">
            TopNepali Network
          </h2>
          <p class="text-xs sm:text-sm text-[var(--text-muted)] leading-relaxed">
            Explore sister projects across Nepali typography, fonts directory, election archives, P2P file transfer, and utilities.
          </p>
        </div>
        <div class="pt-3 border-t border-[var(--border-subtle)]">
          <a 
            href="https://topnepali.com" 
            target="_blank" 
            rel="noopener" 
            class="text-xs font-bold text-blue-500 hover:underline"
          >
            Visit TopNepali.com &rarr;
          </a>
        </div>
      </div>

    </div>

  </div>
</Layout>
