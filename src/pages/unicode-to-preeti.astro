---
import Layout from '../layouts/Layout.astro';

const pageTitle = "Unicode to Preeti Converter — Instant Nepali Unicode to Preeti Font";
const pageDesc = "Free online Unicode to Preeti font converter. Transform standard Nepali Unicode into legacy Preeti ASCII text with rich text formatting, Word export, and instant clipboard copying.";
const canonicalUrl = "https://typing.topnepali.com/unicode-to-preeti";
const ogImageUrl = "https://img.topnepali.com/typing.tn/og/preeti-svg.webp";
const keywords = "Unicode to Preeti, Unicode to Preeti converter, Nepali font converter, Nepali Unicode to Preeti font, convert Unicode to Preeti, Preeti font typing, Kantipur converter";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Why do some printing presses and publishers still request Preeti font?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Many legacy desktop publishing (DTP) workflows, older versions of Adobe InDesign, PageMaker, and Flex printing software in Nepal were configured exclusively for legacy ASCII Type 1 / TrueType fonts like Preeti and Kantipur. Converting Unicode back to Preeti allows seamless compatibility with those legacy publishing setups."
      }
    },
    {
      "@type": "Question",
      "name": "How does the Unicode to Preeti converter handle word-final halantas?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The converter automatically recognizes trailing halantas in words such as श्रीमान्, महान्, and छन् and produces proper Preeti backslash sequences (>Ldfg\\, dxfg\\, 5g\\) without corrupting adjacent words."
      }
    },
    {
      "@type": "Question",
      "name": "How can I type Nepali if I don't have a Nepali keyboard installed?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our in-browser typing engine intercepts physical keystrokes on any standard English QWERTY keyboard. You can select Nepali Unicode Traditional or Romanized in the Typing Layout dropdown to type directly in Devanagari without downloading any software."
      }
    }
  ]
};

const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Unicode to Preeti Converter by TopNepali",
  "url": canonicalUrl,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "NPR"
  },
  "description": pageDesc
};
---

<Layout
  title={pageTitle}
  description={pageDesc}
  canonicalUrl={canonicalUrl}
  ogImage={ogImageUrl}
  keywords={keywords}
  schema={[appSchema, faqSchema]}
  activeNav="converter"
>
  <div class="converter-wrapper py-4 sm:py-6">

    <!-- Hero Header -->
    <header class="text-center max-w-3xl mx-auto pt-2 pb-6">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 mb-2.5">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="16 3 21 3 21 8"></polyline>
          <line x1="4" y1="20" x2="21" y2="3"></line>
          <polyline points="21 16 21 21 16 21"></polyline>
          <line x1="15" y1="15" x2="21" y2="21"></line>
          <line x1="4" y1="4" x2="9" y2="9"></line>
        </svg>
        <span>REVERSE COMPATIBILITY FOR DTP &amp; PRINTING</span>
      </div>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold font-display tracking-tight text-[var(--text-primary)]">
        Unicode to Preeti <span class="text-emerald-600">Converter</span>
      </h1>
      <p class="mt-2 text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
        Convert standard Nepali Unicode Devanagari text back into legacy Preeti ASCII font for Adobe InDesign, PageMaker, and publishing presses.
      </p>
    </header>

    <!-- Master Converter Toolbar -->
    <div class="converter-toolbar">
      <!-- Mode Switcher & Swap Chords -->
      <div class="flex items-center gap-1.5 flex-wrap">
        <div class="inline-flex p-1 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
          <button
            type="button"
            id="mode-uni-to-preeti"
            class="converter-btn converter-btn-primary"
            data-mode="toPreeti"
          >
            Unicode &rarr; Preeti
          </button>
          <button
            type="button"
            id="mode-preeti-to-uni"
            class="converter-btn"
            data-mode="toUnicode"
          >
            Preeti &rarr; Unicode
          </button>
        </div>

        <button
          type="button"
          id="swap-mode-btn"
          class="converter-btn p-2"
          title="Swap Input and Output Text"
          aria-label="Swap Input and Output"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 16V4m0 0L3 8m4-4l4 4m6 4v12m0 0l4-4m-4 4l-4-4"></path>
          </svg>
        </button>

        <!-- Manual Convert Action Button -->
        <button
          type="button"
          id="btn-convert-now"
          class="converter-btn converter-btn-primary font-bold px-3 py-1.5 flex items-center gap-1"
          title="Convert text immediately"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
          <span>Convert Now</span>
        </button>
      </div>

      <!-- In-Browser Typing Engine Layout Selector (With Alt+Shift chord) -->
      <div class="flex items-center gap-2 flex-wrap">
        <span class="text-xs font-semibold text-[var(--text-muted)]">Typing Layout:</span>
        <select
          id="select-typing-layout"
          class="converter-btn text-xs font-medium cursor-pointer bg-[var(--bg-surface)] text-[var(--text-primary)] border border-[var(--border-subtle)] rounded-lg py-1 px-2 outline-none"
        >
          <option value="traditional" selected>Nepali Unicode (Traditional)</option>
          <option value="romanized">Nepali Unicode (Romanized)</option>
          <option value="english">English QWERTY</option>
          <option value="preeti">Preeti Typewriter (ASCII)</option>
        </select>
        <span class="text-[10px] font-mono text-[var(--text-muted)] border border-[var(--border-subtle)] px-1.5 py-0.5 rounded bg-[var(--bg-surface-subtle)] hidden sm:inline-block" title="Press Left Alt + Left Shift to toggle keyboard layout anytime">
          Left Alt+Shift
        </span>
      </div>

      <!-- Rich Text Formatting Actions -->
      <div class="flex items-center gap-1 bg-[var(--bg-surface-subtle)] p-1 rounded-xl border border-[var(--border-subtle)] flex-wrap">
        <button type="button" class="converter-btn fmt-btn p-1.5" data-cmd="bold" title="Bold (Ctrl+B)">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 4h8a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"></path><path d="M6 12h9a4 4 0 0 1 4 4 4 4 0 0 1-4 4H6z"></path></svg>
        </button>
        <button type="button" class="converter-btn fmt-btn p-1.5" data-cmd="italic" title="Italic (Ctrl+I)">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="19" y1="4" x2="10" y2="4"></line><line x1="14" y1="20" x2="5" y2="20"></line><line x1="15" y1="4" x2="9" y2="20"></line></svg>
        </button>
        <button type="button" class="converter-btn fmt-btn p-1.5" data-cmd="underline" title="Underline (Ctrl+U)">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 3v7a6 6 0 0 0 6 6 6 6 0 0 0 6-6V3"></path><line x1="4" y1="21" x2="20" y2="21"></line></svg>
        </button>

        <div class="converter-divider"></div>

        <button type="button" class="converter-btn fmt-btn px-2 py-1 font-bold text-xs" data-cmd="formatBlock" data-val="h2" title="Heading 2">H2</button>
        <button type="button" class="converter-btn fmt-btn px-2 py-1 font-bold text-xs" data-cmd="formatBlock" data-val="h3" title="Heading 3">H3</button>

        <div class="converter-divider"></div>

        <button type="button" class="converter-btn fmt-btn p-1.5" data-cmd="insertUnorderedList" title="Bullet List">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
        </button>
        <button type="button" class="converter-btn fmt-btn p-1.5" data-cmd="insertOrderedList" title="Numbered List">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="10" y1="6" x2="21" y2="6"></line><line x1="10" y1="12" x2="21" y2="12"></line><line x1="10" y1="18" x2="21" y2="18"></line><path d="M4 6h1v4"></path><path d="M4 10h2"></path><path d="M6 18H4c0-1 2-2 2-3s-1-1.5-2-1"></path></svg>
        </button>
        <button type="button" class="converter-btn fmt-btn p-1.5" data-cmd="removeFormat" title="Clear Formatting">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>

        <div class="converter-divider"></div>

        <!-- Font Size Scaler -->
        <div class="flex items-center gap-1">
          <button type="button" id="btn-font-smaller" class="converter-btn px-1.5 py-0.5 text-xs font-bold" title="Decrease font size">A-</button>
          <span id="label-font-size" class="text-xs font-mono text-[var(--text-muted)] min-w-[32px] text-center font-bold">20px</span>
          <button type="button" id="btn-font-larger" class="converter-btn px-1.5 py-0.5 text-xs font-bold" title="Increase font size">A+</button>
        </div>
      </div>
    </div>

    <!-- Dual-Pane Workspace Grid -->
    <div class="converter-grid">
      <!-- Input Pane (Nepali Unicode) -->
      <div class="converter-pane">
        <div class="converter-pane-header">
          <div class="flex items-center gap-2">
            <span id="input-label" class="font-bold uppercase tracking-wider text-xs text-[var(--text-primary)]">
              Nepali Unicode Input
            </span>
            <button
              type="button"
              id="btn-toggle-input-font"
              class="converter-pill border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 cursor-pointer"
              title="Input encoding"
            >
              <span id="input-font-tag">UTF-8 UNICODE</span>
            </button>
          </div>

          <div class="flex items-center gap-1.5">
            <button type="button" id="btn-sample-text" class="converter-btn text-xs">Sample</button>
            <button type="button" id="btn-paste-input" class="converter-btn text-xs">Paste</button>
            <button type="button" id="btn-clear-input" class="converter-btn text-xs text-rose-600 hover:text-rose-700">Clear</button>
          </div>
        </div>

        <!-- Editable Input Content Area -->
        <div
          id="editor-input"
          contenteditable="true"
          spellcheck="false"
          class="converter-editor font-nepali select-text"
          data-placeholder="Type in Nepali Unicode or paste text here..."
        ></div>

        <div class="converter-pane-footer">
          <div class="flex items-center gap-4">
            <span>Characters: <strong id="input-char-count" class="text-[var(--text-primary)]">0</strong></span>
            <span>Words: <strong id="input-word-count" class="text-[var(--text-primary)]">0</strong></span>
          </div>
          <span class="text-xs text-[var(--text-muted)] flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-emerald-500 inline-block animate-pulse"></span>
            Real-time live conversion
          </span>
        </div>
      </div>

      <!-- Output Pane (Preeti) -->
      <div class="converter-pane">
        <div class="converter-pane-header">
          <div class="flex items-center gap-2">
            <span id="output-label" class="font-bold uppercase tracking-wider text-xs text-[var(--text-primary)]">
              Preeti Text Output
            </span>
            <button
              type="button"
              id="btn-toggle-output-font"
              class="converter-pill border border-rose-500/30 text-rose-600 dark:text-rose-400 bg-rose-500/10 cursor-pointer"
              title="Toggle between authentic Nepali Visual rendering and Raw ASCII characters"
            >
              <svg class="w-3 h-3 text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
              <span id="output-font-tag">Nepali Visual</span>
            </button>
          </div>

          <div class="flex items-center gap-1.5 flex-wrap">
            <button
              type="button"
              id="btn-copy-rich"
              class="converter-btn converter-btn-success text-xs font-bold"
              title="Copy formatted text with bold, italic, and headings preserved for Word / Google Docs"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span>Copy Formatted</span>
            </button>
            <button type="button" id="btn-copy-plain" class="converter-btn text-xs">Copy Plain ASCII</button>
            <button type="button" id="btn-download-txt" class="converter-btn text-xs">Download</button>
            <button type="button" id="btn-print-doc" class="converter-btn text-xs">Print</button>
          </div>
        </div>

        <!-- Converted Output Area -->
        <div
          id="editor-output"
          contenteditable="true"
          spellcheck="false"
          class="converter-editor font-preeti select-text"
          data-placeholder="Converted Preeti text appears here instantly..."
        ></div>

        <div class="converter-pane-footer">
          <div class="flex items-center gap-4">
            <span>Characters: <strong id="output-char-count" class="text-[var(--text-primary)]">0</strong></span>
            <span>Words: <strong id="output-word-count" class="text-[var(--text-primary)]">0</strong></span>
          </div>
          <div id="copy-status-indicator" class="font-bold text-emerald-600 dark:text-emerald-400 opacity-0 transition-opacity">
            Copied to clipboard
          </div>
        </div>
      </div>
    </div>

    <!-- Frequently Asked Questions -->
    <section class="bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-2xl p-6 sm:p-8 shadow-sm mb-8">
      <h2 class="text-lg font-bold font-display text-[var(--text-primary)] mb-4">
        Frequently Asked Questions
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs sm:text-sm">
        <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
          <h3 class="font-bold text-[var(--text-primary)] mb-1.5">How do I paste Preeti text into InDesign or PageMaker?</h3>
          <p class="text-[var(--text-secondary)] leading-relaxed">
            Click 'Copy Plain ASCII', then paste directly into Adobe InDesign or PageMaker text frames with the font family set to Preeti or Kantipur. All ligatures and raswa ikaar markers align naturally.
          </p>
        </div>

        <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
          <h3 class="font-bold text-[var(--text-primary)] mb-1.5">Can I type Nepali without installing any keyboard?</h3>
          <p class="text-[var(--text-secondary)] leading-relaxed">
            Yes. The built-in typing layout engine intercepts keystrokes on standard English keyboards. Select 'Nepali Unicode (Traditional)' or 'Romanized' in the Typing Layout dropdown to type directly.
          </p>
        </div>

        <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
          <h3 class="font-bold text-[var(--text-primary)] mb-1.5">Does the converter handle halantas and rephs accurately?</h3>
          <p class="text-[var(--text-secondary)] leading-relaxed">
            Yes. Words ending in halanta such as श्रीमान् and महान् map directly to proper Preeti backslash sequences (>Ldfg\, dxfg\), while rephs and ikaars are repositioned contextually.
          </p>
        </div>

        <div class="p-4 rounded-xl bg-[var(--bg-surface-subtle)] border border-[var(--border-subtle)]">
          <h3 class="font-bold text-[var(--text-primary)] mb-1.5">Are formatting tags preserved?</h3>
          <p class="text-[var(--text-secondary)] leading-relaxed">
            Yes. Bold, italic, headings (H2/H3), and list elements are preserved during conversion so you can copy formatted rich text directly into Microsoft Word or Google Docs.
          </p>
        </div>
      </div>
    </section>

  </div>

  <div id="converter-toast" class="converter-toast"></div>

  <!-- Self-Contained In-Browser Converter & Typing Engine Script (Zero external module dependencies) -->
  <script is:inline>
    (function initConverter() {
      // 1. Hardware Matrix for Traditional, Romanized & Preeti Keyboards
      const KEY_CODE_MAP = {
        "Backquote":{"uni":["ञ","॥"],"rom":["़","ऽ"],"pre":["`","~","ञ","ञ्"]},
        "Digit1":{"uni":["१","ज्ञ"],"rom":["१","!"],"pre":["1","!","ज्ञ","१"]},
        "Digit2":{"uni":["२","ई"],"rom":["२","@"],"pre":["2","@","द्द","२"]},
        "Digit3":{"uni":["३","घ"],"rom":["३","#"],"pre":["3","#","घ","३"]},
        "Digit4":{"uni":["४","द्ध"],"rom":["४","$"],"pre":["4","$","द्ध","४"]},
        "Digit5":{"uni":["५","छ"],"rom":["५","%"],"pre":["5","%","छ","५"]},
        "Digit6":{"uni":["६","ट"],"rom":["६","^"],"pre":["6","^","ट","६"]},
        "Digit7":{"uni":["७","ठ"],"rom":["७","&"],"pre":["7","&","ठ","७"]},
        "Digit8":{"uni":["८","ड"],"rom":["८","*"],"pre":["8","*","ड","८"]},
        "Digit9":{"uni":["९","ढ"],"rom":["९","("],"pre":["9","(","ढ","९"]},
        "Digit0":{"uni":["०","ण"],"rom":["०",")"],"pre":["0",")","ण","०"]},
        "Minus":{"uni":["औ","ओ"],"rom":["-","_"],"pre":["-","_","❨","❩"]},
        "Equal":{"uni":["‍","‌"],"rom":["‍","‌"],"pre":[".","+",".","ं"]},
        "KeyQ":{"uni":["त्र","त्त"],"rom":["ट","ठ"],"pre":["q","Q","त्र","त्त"]},
        "KeyW":{"uni":["ध","ड्ढ"],"rom":["ौ","औ"],"pre":["w","W","ध","ध्"]},
        "KeyE":{"uni":["भ","ऐ"],"rom":["े","ै"],"pre":["e","E","भ","भ्"]},
        "KeyR":{"uni":["च","द्ब"],"rom":["र","ृ"],"pre":["r","R","च","च्"]},
        "KeyT":{"uni":["त","ट्ट"],"rom":["त","थ"],"pre":["t","T","त","त्"]},
        "KeyY":{"uni":["थ","ठ्ठ"],"rom":["य","ञ"],"pre":["y","Y","थ","थ्"]},
        "KeyU":{"uni":["ग","ऊ"],"rom":["ु","ू"],"pre":["u","U","ग","ग्"]},
        "KeyI":{"uni":["ष","क्ष"],"rom":["ि","ी"],"pre":["i","I","ष","क्ष्"]},
        "KeyO":{"uni":["य","इ"],"rom":["ो","ओ"],"pre":["o","O","य","इ"]},
        "KeyP":{"uni":["उ","ए"],"rom":["प","फ"],"pre":["p","P","उ","ए"]},
        "BracketLeft":{"uni":["र्","ृ"],"rom":["इ","ई"],"pre":["[","{","ृ","र्"]},
        "BracketRight":{"uni":["े","ै"],"rom":["ए","ऐ"],"pre":["]","}","े","ै"]},
        "Backslash":{"uni":["्","ं"],"rom":["ॐ","ः"],"pre":["\\","|","्","्र"]},
        "KeyA":{"uni":["ब","आ"],"rom":["ा","आ"],"pre":["a","A","ब","ब्"]},
        "KeyS":{"uni":["क","ङ्क"],"rom":["स","श"],"pre":["s","S","क","क्"]},
        "KeyD":{"uni":["म","ङ्ग"],"rom":["द","ध"],"pre":["d","D","म","म्"]},
        "KeyF":{"uni":["ा","ँ"],"rom":["उ","ऊ"],"pre":["f","F","ा","ँ"]},
        "KeyG":{"uni":["न","द्द"],"rom":["ग","घ"],"pre":["g","G","न","न्"]},
        "KeyH":{"uni":["ज","झ"],"rom":["ह","अ"],"pre":["h","H","ज","ज्"]},
        "KeyJ":{"uni":["व","ो"],"rom":["ज","झ"],"pre":["j","J","व","व्"]},
        "KeyK":{"uni":["प","फ"],"rom":["क","ख"],"pre":["k","K","प","प्"]},
        "KeyL":{"uni":["ि","ी"],"rom":["ल","॥"],"pre":["l","L","ि","ी"]},
        "Semicolon":{"uni":["स","ट्ठ"],"rom":[";",":"],"pre":[";",":","स","स्"]},
        "Quote":{"uni":["ु","ू"],"rom":["'","\""],"pre":["'","\"","ु","ू"]},
        "KeyZ":{"uni":["श","क्क"],"rom":["ष","ऋ"],"pre":["z","Z","श","श्"]},
        "KeyX":{"uni":["ह","ह्य"],"rom":["ड","ढ"],"pre":["x","X","ह","ह्"]},
        "KeyC":{"uni":["अ","ऋ"],"rom":["च","छ"],"pre":["c","C","अ","ऋ"]},
        "KeyV":{"uni":["ख","ॐ"],"rom":["व","ँ"],"pre":["v","V","ख","ख्"]},
        "KeyB":{"uni":["द","ौ"],"rom":["ब","भ"],"pre":["b","B","द","द्य"]},
        "KeyN":{"uni":["ल","द्य"],"rom":["न","ण"],"pre":["n","N","ल","ल्"]},
        "KeyM":{"uni":["ः","ड्ड"],"rom":["म","ं"],"pre":["m","M","फ","ः"]},
        "Comma":{"uni":["ऽ","ङ"],"rom":[",","ङ"],"pre":[",","<",",","?"]},
        "Period":{"uni":["।","श्र"],"rom":["।","."],"pre":[".",">","।","श्र"]},
        "Slash":{"uni":["र","रु"],"rom":["्","?"],"pre":["/","?","र","रु"]},
        "Space":{"uni":[" "," "],"rom":[" "," "],"pre":[" "," "]}
      };

      // 2. Comprehensive Preeti <-> Unicode Character & Ligature Tables
      const CONTEXTUAL_RULES = [
        ["((?:.्)*.)ि", "l$1"],
        ["र्((?:.्)*.)", "$1{"]
      ];

      const END_HALANT_CONSONANTS = [
        ['क', 's'], ['ख', 'v'], ['ग', 'u'], ['घ', '3'],
        ['च', 'r'], ['छ', '5'], ['ज', 'h'], ['झ', '´'],
        ['ञ', '`'], ['ट', '6'], ['ठ', '7'], ['ड', '8'], ['ढ', '9'], ['ण', '0f'],
        ['त', 't'], ['थ', 'y'], ['द', 'b'], ['ध', 'w'], ['न', 'g'],
        ['प', 'k'], ['फ', 'km'], ['ब', 'a'], ['भ', 'e'], ['म', 'd'],
        ['य', 'o'], ['र', '/'], ['ल', 'n'], ['व', 'j'],
        ['श', 'z'], ['ष', 'if'], ['स', ';'], ['ह', 'x']
      ];

      const PREETI_CHAR_MAP = [
        ["❨", "-"], ["❩", "_"], ["‘", "…"], ["?", "<"],
        ["ॐ", "ç"], ["ऽ", "˜"], ["।", "."],
        ["m'", "'m"], ["m]", "]m"], ["mfF", "Fmf"], ["mF", "Fm"],
        ["०", ")"], ["१", "!"], ["२", "@"], ["३", "#"], ["४", "$"],
        ["५", "%"], ["६", "^"], ["७", "&"], ["८", "*"], ["९", "("],
        ["फ्र", "k|m"], ["झ", "em"], ["फ", "km"], ["क्त", "Qm"], ["क्र", "qm"],
        ["ज्ञ्", "¡"], ["द्घ", "¢"], ["ज्ञ", "1"], ["द्द", "2"], ["द्ध", "4"],
        ["श्र", ">"], ["रु", "?"], ["द्य", "B"], ["क्ष्", "I"], ["क्ष", "If"],
        ["त्त", "Q"], ["द्म", "b\\d"], ["त्र", "q"], ["ध्र", "w|"], ["ङ्घ", "‹"],
        ["ड्ड", "8\\8"], ["द्र", "b|"], ["ट्ट", "6\\6"], ["ड्ढ", "°"], ["ठ्ठ", "7\\7"],
        ["रू", "/\""], ["हृ", "x["], ["ङ्ग", "+u"], ["ङ्क", "+s"], ["ङ्ख", "+v"],
        ["ट्ठ", "7\\7"], ["द्व", "b\\j"], ["ट्र", "6|"], ["ठ्र", "7|"], ["ड्र", "8|"],
        ["ढ्र", "9|"], ["्र", "|"], ["ड़", "8Þ"], ["ढ़", "9Þ"],
        ["क्", "S"], ["क", "s"], ["ख्", "V"], ["ख", "v"], ["ग्", "U"], ["ग", "u"],
        ["घ्", "£"], ["घ", "3"], ["ङ", "ª"], ["च्", "R"], ["च", "r"], ["छ", "5"],
        ["ज्", "H"], ["ज", "h"], ["झ्", "‰"], ["झ", "´"], ["ञ्", "~"], ["ञ", "`"],
        ["ट", "6"], ["ठ", "7"], ["ड", "8"], ["ढ", "9"], ["ण्", "0"], ["ण", "0f"],
        ["त्", "T"], ["त", "t"], ["थ्", "Y"], ["थ", "y"], ["द", "b"], ["ध्", "W"],
        ["ध", "w"], ["न्", "G"], ["न", "g"], ["प्", "K"], ["प", "k"], ["फ्", "ˆ"],
        ["ब्", "A"], ["ब", "a"], ["भ्", "E"], ["भ", "e"], ["म्", "D"], ["म", "d"],
        ["य", "o"], ["र", "/"], ["ल्", "N"], ["ल", "n"], ["व्", "J"], ["व", "j"],
        ["श्", "Z"], ["श", "z"], ["ष्", "i"], ["ष", "if"], ["स्", ":"], ["स", ";"],
        ["ह्", "X"], ["ह", "x"], ["्य", "Ø"],
        ["औ", "cf}"], ["ओ", "cf]"], ["आ", "cf"], ["अ", "c"],
        ["ई", "O{"], ["इ", "O"], ["ऊ", "pm"], ["उ", "p"], ["ऋ", "C"], ["ऐ", "P]"], ["ए", "P"],
        ["ू", "\""], ["ु", "'"], ["ं", "+"], ["ा", "f"], ["ृ", "["],
        ["्", "\\"], ["े", "]"], ["ै", "}"], ["ँ", "F"], ["ी", "L"],
        ["ः", "M"], ["ो", "f]"], ["ौ", "f}"]
      ];

      const PREETI_TO_UNICODE_MAP = [
        ["k|m", "फ्र"], ["cf}F", "औँ"], ["cf}+", "औँ"], ["cf}", "औ"], ["cf]", "ओ"],
        ["cf", "आ"], ["pm", "ऊ"], ["P]", "ऐ"], ["8Þ", "ड़"], ["9Þ", "ढ़"],
        ["6«", "ट्र"], ["7«", "ठ्र"], ["8«", "ड्र"], ["9«", "ढ्र"], ["6|", "ट्र"],
        ["7|", "ठ्र"], ["8|", "ड्र"], ["9|", "ढ्र"], ["If", "क्ष"], ["0f", "ण"],
        ["if", "ष"], ["f}F", "ौँ"], ["f}+", "ौँ"], ["f]F", "ों"], ["f]+", "ों"],
        ["f}", "ौ"], ["f]", "ो"], ["k|", "प्र"], ["km", "फ"], ["Qm", "क्त"],
        ["qm", "क्र"], ["em", "झ"], ["1", "ज्ञ"], ["2", "द्द"], ["4", "द्ध"],
        ["Q", "त्त"], [">", "श्र"], ["?", "रु"], ["¿", "रू"], ["B", "द्य"],
        ["I", "क्ष्"], ["q", "त्र"], ["å", "द्व"], ["§", "ट्ट"], ["•", "ड्ड"],
        ["°", "ड्ढ"], ["¶", "ठ्ठ"], ["Ý", "ट्ठ"], ["ß", "द्म"], ["¡", "ज्ञ्"],
        ["¢", "द्घ"], ["„", "ध्र"], ["›", "द्र"], ["‹", "ङ्घ"], ["Ë", "ङ्ग"],
        ["Í", "ङ्क"], ["Î", "ङ्ख"], ["Å", "हृ"],
        ["!", "१"], ["@", "२"], ["#", "३"], ["$", "४"], ["%", "५"],
        ["^", "६"], ["&", "७"], ["*", "८"], ["(", "९"], [")", "०"],
        ["ç", "ॐ"], ["˜", "ऽ"], [".", "।"], ["<", "?"],
        ["c", "अ"], ["O", "इ"], ["p", "उ"], ["P", "ए"], ["C", "ऋ"],
        ["S", "क्"], ["s", "क"], ["V", "ख्"], ["v", "ख"], ["U", "ग्"], ["u", "ग"],
        ["£", "घ्"], ["3", "घ"], ["ª", "ङ"], ["R", "च्"], ["r", "च"], ["5", "छ"],
        ["H", "ज्"], ["h", "ज"], ["‰", "झ्"], ["´", "झ"], ["~", "ञ्"], ["`", "ञ"],
        ["6", "ट"], ["7", "ठ"], ["8", "ड"], ["9", "ढ"], ["0", "ण्"],
        ["T", "त्"], ["t", "त"], ["Y", "थ्"], ["y", "थ"], ["b", "द"],
        ["W", "ध्"], ["w", "ध"], ["G", "न्"], ["g", "न"], ["K", "प्"], ["k", "प"],
        ["ˆ", "फ्"], ["m", "फ"], ["A", "ब्"], ["a", "ब"], ["E", "भ्"], ["e", "भ"],
        ["D", "म्"], ["d", "म"], ["o", "य"], ["/", "र"], ["N", "ल्"], ["n", "ल"],
        ["J", "व्"], ["j", "व"], ["Z", "श्"], ["z", "श"], ["i", "ष्"],
        [":", "स्"], [";", "स"], ["X", "ह्"], ["x", "ह"],
        ["f", "ा"], ["l", "ि"], ["L", "ी"], ["]", "े"], ["}", "ै"],
        ["'", "ु"], ['"', "ू"], ["[", "ृ"], ["+", "ं"], ["F", "ँ"],
        ["M", "ः"], ["\\", "्"], ["|", "्र"], ["Ø", "्य"], ["{", "र्"]
      ];

      const PREETI_HALF_CONS = '(?:[SVU£R~TYWGKˆAEDNJZ:X]|i(?![fF])|[svu3r5h´`67890tybwgkmaedonjzx]\\\\)';
      const PREETI_FULL_CONS = '(?:k\\|m|k\\||km|Qm|qm|em|If|if|6«|7«|8«|9«|6\\||7\\||8\\||9\\||8Þ|9Þ|1|2|4|Q|>|\\?|¿|B|I|q|å|§|•|°|¶|Ý|ß|¡|¢|„|›|‹|Ë|Í|Î|Å|[svu3r5h´`67890tybwgkmaedonjzx0cOpPC])';
      const PREETI_MATRAS = '[fL\\]}\'\"\\[+FM]';

      function hasDevanagari(text) {
        return /[\u0900-\u097F]/.test(text);
      }

      function toPreeti(text) {
        if (!text) return '';
        let s = text;
        for (const [c, p] of END_HALANT_CONSONANTS) {
          const re = new RegExp(`${c}्(?=$|[^\\u0900-\\u097F])`, 'g');
          s = s.replace(re, `${p}\\`);
        }
        for (const [pattern, replacement] of CONTEXTUAL_RULES) {
          s = s.replace(new RegExp(pattern, 'g'), replacement);
        }
        for (const [u, p] of PREETI_CHAR_MAP) {
          s = s.replaceAll(u, p);
        }
        return s;
      }

      function preetiToUnicode(input) {
        if (!input) return '';
        let text = input;
        text = text.replaceAll('O{', 'ई');
        const rephPattern = new RegExp(`(${PREETI_HALF_CONS}*${PREETI_FULL_CONS}${PREETI_MATRAS}*)\\{`, 'g');
        text = text.replace(rephPattern, '{$1');
        const ikaarPattern = new RegExp(`l(${PREETI_HALF_CONS}*${PREETI_FULL_CONS})`, 'g');
        text = text.replace(ikaarPattern, '$1l');
        for (const [p, u] of PREETI_TO_UNICODE_MAP) {
          text = text.replaceAll(p, u);
        }
        return text;
      }

      function convertNodesRecursively(node, dir) {
        if (!node) return;
        if (node.nodeType === 3) {
          if (node.nodeValue && node.nodeValue.length > 0) {
            node.nodeValue = (dir === 'toPreeti') ? toPreeti(node.nodeValue) : preetiToUnicode(node.nodeValue);
          }
        } else if (node.nodeType === 1) {
          for (let i = 0; i < node.childNodes.length; i++) {
            convertNodesRecursively(node.childNodes[i], dir);
          }
        }
      }

      // 3. UI State
      let currentMode = 'toPreeti'; // Default: 'toPreeti' on this page
      let inputPreetiVisual = true;
      let outputPreetiVisual = true;
      let currentFontSize = 20;
      let typingLayout = 'traditional'; // Default: 'traditional'

      const editorInput = document.getElementById('editor-input');
      const editorOutput = document.getElementById('editor-output');
      const inputLabel = document.getElementById('input-label');
      const outputLabel = document.getElementById('output-label');
      const inputFontTag = document.getElementById('input-font-tag');
      const outputFontTag = document.getElementById('output-font-tag');

      const inputCharCount = document.getElementById('input-char-count');
      const inputWordCount = document.getElementById('input-word-count');
      const outputCharCount = document.getElementById('output-char-count');
      const outputWordCount = document.getElementById('output-word-count');

      const modeBtnUniToPreeti = document.getElementById('mode-uni-to-preeti');
      const modeBtnPreetiToUni = document.getElementById('mode-preeti-to-uni');
      const swapModeBtn = document.getElementById('swap-mode-btn');
      const btnConvertNow = document.getElementById('btn-convert-now');
      const selectTypingLayout = document.getElementById('select-typing-layout');

      const btnToggleInputFont = document.getElementById('btn-toggle-input-font');
      const btnToggleOutputFont = document.getElementById('btn-toggle-output-font');
      const btnFontSmaller = document.getElementById('btn-font-smaller');
      const btnFontLarger = document.getElementById('btn-font-larger');
      const labelFontSize = document.getElementById('label-font-size');

      const btnSampleText = document.getElementById('btn-sample-text');
      const btnPasteInput = document.getElementById('btn-paste-input');
      const btnClearInput = document.getElementById('btn-clear-input');

      const btnCopyRich = document.getElementById('btn-copy-rich');
      const btnCopyPlain = document.getElementById('btn-copy-plain');
      const btnDownloadTxt = document.getElementById('btn-download-txt');
      const btnPrintDoc = document.getElementById('btn-print-doc');
      const copyStatusIndicator = document.getElementById('copy-status-indicator');
      const toastEl = document.getElementById('converter-toast');

      const fmtButtons = document.querySelectorAll('.fmt-btn');

      const SAMPLE_UNICODE = '<h2>नेपाल सरकार</h2><p><b>नेपाल</b> काठमाडौँमा <i>संविधान</i> कार्यान्वयन तथा प्रशासन सुधार सम्बन्धी प्रक्रिया प्रविधि मुख्य नेपाली ज्ञान र शिक्षा प्रशिक्षण सञ्चालन भएको छ ।</p><ul><li>श्रीमान् प्रधानमन्त्रीको दृष्टिकोण</li><li>विद्यार्थी र प्रतिस्पर्धीहरूको लागि सुविधा</li></ul>';
      const SAMPLE_PREETI = '<h2>g]kfn ;/sf/</h2><p><b>g]kfn</b> sf7df8f}+df <i>;+ljwfg</i> sfof{Gjog tyf k|zf;g ;\'wf/ ;DaGwL k|lqmof k|ljlw dVo g]kfnL 1fg / lzIff k|lzIf0f ;~rfng ePsf] 5 .</p><ul><li>>Ldfg\\ k|wfgdGqLsf] b[li6sf]0f</li><li>ljBfyL{ / k|lt:kwL{x¿sf] nflu ;\'ljwf</li></ul>';

      function showToast(msg) {
        if (toastEl) {
          toastEl.textContent = msg;
          toastEl.classList.add('is-visible');
          setTimeout(() => toastEl.classList.remove('is-visible'), 2200);
        }
        if (copyStatusIndicator) {
          copyStatusIndicator.textContent = msg;
          copyStatusIndicator.style.opacity = '1';
          setTimeout(() => { copyStatusIndicator.style.opacity = '0'; }, 2200);
        }
      }

      function setEditorFontSize(size) {
        currentFontSize = Math.max(14, Math.min(36, size));
        if (editorInput) editorInput.style.fontSize = `${currentFontSize}px`;
        if (editorOutput) editorOutput.style.fontSize = `${currentFontSize}px`;
        if (labelFontSize) labelFontSize.textContent = `${currentFontSize}px`;
      }

      function applyFonts() {
        if (currentMode === 'toPreeti') {
          // Left: Unicode, Right: Preeti
          editorInput.style.fontFamily = "'Font_kokila', 'Mukta', 'Kalimati', sans-serif";
          editorInput.style.letterSpacing = 'normal';
          if (inputFontTag) inputFontTag.textContent = 'UTF-8 UNICODE';

          if (outputPreetiVisual) {
            editorOutput.style.fontFamily = "'Font_preeti', 'Preeti', sans-serif";
            editorOutput.style.letterSpacing = '0.02em';
            if (outputFontTag) outputFontTag.textContent = 'Nepali Visual';
          } else {
            editorOutput.style.fontFamily = "'JetBrains Mono', monospace";
            editorOutput.style.letterSpacing = 'normal';
            if (outputFontTag) outputFontTag.textContent = 'Raw ASCII Keys';
          }
        } else {
          // Left: Preeti, Right: Unicode
          if (inputPreetiVisual) {
            editorInput.style.fontFamily = "'Font_preeti', 'Preeti', sans-serif";
            editorInput.style.letterSpacing = '0.02em';
            if (inputFontTag) inputFontTag.textContent = 'Nepali Visual';
          } else {
            editorInput.style.fontFamily = "'JetBrains Mono', monospace";
            editorInput.style.letterSpacing = 'normal';
            if (inputFontTag) inputFontTag.textContent = 'Raw ASCII Keys';
          }
          editorOutput.style.fontFamily = "'Font_kokila', 'Mukta', 'Kalimati', sans-serif";
          editorOutput.style.letterSpacing = 'normal';
          if (outputFontTag) outputFontTag.textContent = 'UTF-8 UNICODE';
        }
      }

      function updateModeUI() {
        if (currentMode === 'toPreeti') {
          modeBtnUniToPreeti.classList.add('converter-btn-primary');
          modeBtnPreetiToUni.classList.remove('converter-btn-primary');

          inputLabel.textContent = 'Nepali Unicode Input';
          outputLabel.textContent = 'Preeti Text Output';
          selectTypingLayout.value = 'traditional';
          typingLayout = 'traditional';
        } else {
          modeBtnPreetiToUni.classList.add('converter-btn-primary');
          modeBtnUniToPreeti.classList.remove('converter-btn-primary');

          inputLabel.textContent = 'Preeti Text Input';
          outputLabel.textContent = 'Nepali Unicode Output';
          selectTypingLayout.value = 'preeti';
          typingLayout = 'preeti';
        }
        applyFonts();
      }

      function calculateStats(text) {
        const chars = text.length;
        const trimmed = text.trim();
        const words = trimmed ? trimmed.split(/\s+/).length : 0;
        return { chars, words };
      }

      function runConversion() {
        try {
          const inputText = editorInput.innerText || '';
          const inStats = calculateStats(inputText);
          if (inputCharCount) inputCharCount.textContent = inStats.chars.toLocaleString();
          if (inputWordCount) inputWordCount.textContent = inStats.words.toLocaleString();

          if (!inputText.trim()) {
            editorOutput.innerHTML = '';
            if (outputCharCount) outputCharCount.textContent = '0';
            if (outputWordCount) outputWordCount.textContent = '0';
            return;
          }

          const clone = editorInput.cloneNode(true);
          convertNodesRecursively(clone, currentMode);
          editorOutput.innerHTML = clone.innerHTML;

          const outText = editorOutput.innerText || '';
          const outStats = calculateStats(outText);
          if (outputCharCount) outputCharCount.textContent = outStats.chars.toLocaleString();
          if (outputWordCount) outputWordCount.textContent = outStats.words.toLocaleString();
        } catch (e) {
          console.error('Conversion error:', e);
        }
      }

      // Auto-normalize compound traditional ligatures
      function normalizeEditorLigatures() {
        const sel = window.getSelection();
        if (!sel || !sel.anchorNode) return;
        const node = sel.anchorNode;
        if (node.nodeType === 3) {
          const val = node.nodeValue;
          const normalized = val
            .replace(/अा/g, 'आ')
            .replace(/ाे/g, 'ो')
            .replace(/ाै/g, 'ौ')
            .replace(/अो/g, 'ओ')
            .replace(/अौ/g, 'औ');
          if (normalized !== val) {
            const offset = sel.anchorOffset;
            node.nodeValue = normalized;
            sel.collapse(node, Math.min(offset, normalized.length));
          }
        }
      }

      // Windows-Style Left Alt + Left Shift Keyboard Shortcut
      let isAltDown = false;
      let isShiftDown = false;
      function toggleTypingLayout() {
        const layouts = ['traditional', 'romanized', 'preeti', 'english'];
        let curIdx = layouts.indexOf(typingLayout);
        let nextIdx = (curIdx + 1) % layouts.length;
        typingLayout = layouts[nextIdx];
        if (selectTypingLayout) selectTypingLayout.value = typingLayout;
        const names = {
          traditional: 'Nepali Traditional',
          romanized: 'Nepali Romanized',
          preeti: 'Preeti Typewriter',
          english: 'English QWERTY'
        };
        showToast(`Layout: ${names[typingLayout] || typingLayout} (Alt+Shift)`);
      }

      window.addEventListener('keydown', (e) => {
        if (e.code === 'AltLeft' || e.key === 'Alt') isAltDown = true;
        if (e.code === 'ShiftLeft' || e.key === 'Shift') isShiftDown = true;
        if (isAltDown && isShiftDown) {
          e.preventDefault();
          toggleTypingLayout();
        }
      });

      window.addEventListener('keyup', (e) => {
        if (e.code === 'AltLeft' || e.key === 'Alt') isAltDown = false;
        if (e.code === 'ShiftLeft' || e.key === 'Shift') isShiftDown = false;
      });

      // Keydown Transliteration on editorInput
      editorInput.addEventListener('keydown', (e) => {
        if (e.ctrlKey || e.altKey || e.metaKey || e.key.length > 1) return;

        if (typingLayout === 'traditional') {
          const matched = KEY_CODE_MAP[e.code];
          if (matched && matched.uni) {
            e.preventDefault();
            const ch = e.shiftKey ? matched.uni[1] : matched.uni[0];
            document.execCommand('insertText', false, ch);
            normalizeEditorLigatures();
            runConversion();
          }
        } else if (typingLayout === 'romanized') {
          const matched = KEY_CODE_MAP[e.code];
          if (matched && matched.rom) {
            e.preventDefault();
            let ch = e.shiftKey ? matched.rom[1] : matched.rom[0];
            if (e.code === 'KeyQ' && !e.shiftKey) ch = '्';
            if (e.code === 'Slash' && !e.shiftKey) ch = '्';
            document.execCommand('insertText', false, ch);
            normalizeEditorLigatures();
            runConversion();
          }
        }
      });

      // Keystroke-by-keystroke real-time conversion
      let debounceTimer = null;
      editorInput.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(runConversion, 15);
      });

      // Toolbar formatting commands
      fmtButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const cmd = btn.dataset.cmd;
          const val = btn.dataset.val || null;
          editorInput.focus();
          document.execCommand(cmd, false, val);
          runConversion();
        });
      });

      // Mode Switchers
      modeBtnUniToPreeti.addEventListener('click', () => {
        if (currentMode === 'toPreeti') return;
        currentMode = 'toPreeti';
        updateModeUI();
        runConversion();
      });

      modeBtnPreetiToUni.addEventListener('click', () => {
        if (currentMode === 'toUnicode') return;
        currentMode = 'toUnicode';
        updateModeUI();
        runConversion();
      });

      // Swap button
      swapModeBtn.addEventListener('click', () => {
        const tempHtml = editorOutput.innerHTML;
        currentMode = (currentMode === 'toPreeti') ? 'toUnicode' : 'toPreeti';
        updateModeUI();
        editorInput.innerHTML = tempHtml;
        runConversion();
      });

      // Explicit Manual Convert Button
      if (btnConvertNow) {
        btnConvertNow.addEventListener('click', () => {
          runConversion();
          showToast('Converted text successfully');
        });
      }

      // Typing Layout Switcher Dropdown
      selectTypingLayout.addEventListener('change', (e) => {
        typingLayout = e.target.value;
        const name = e.target.options[e.target.selectedIndex].text;
        showToast(`Layout: ${name}`);
      });

      // Font View Toggles
      if (btnToggleOutputFont) {
        btnToggleOutputFont.addEventListener('click', () => {
          if (currentMode === 'toPreeti') {
            outputPreetiVisual = !outputPreetiVisual;
          }
          applyFonts();
        });
      }

      if (btnToggleInputFont) {
        btnToggleInputFont.addEventListener('click', () => {
          if (currentMode === 'toUnicode') {
            inputPreetiVisual = !inputPreetiVisual;
          }
          applyFonts();
        });
      }

      // Font Size Controls
      if (btnFontSmaller) {
        btnFontSmaller.addEventListener('click', () => setEditorFontSize(currentFontSize - 2));
      }
      if (btnFontLarger) {
        btnFontLarger.addEventListener('click', () => setEditorFontSize(currentFontSize + 2));
      }

      // Sample Text
      btnSampleText.addEventListener('click', () => {
        editorInput.innerHTML = (currentMode === 'toPreeti') ? SAMPLE_UNICODE : SAMPLE_PREETI;
        runConversion();
      });

      // Paste Button
      btnPasteInput.addEventListener('click', async () => {
        try {
          const text = await navigator.clipboard.readText();
          if (text) {
            editorInput.focus();
            document.execCommand('insertText', false, text);
            runConversion();
          }
        } catch {
          editorInput.focus();
        }
      });

      // Clear Button
      btnClearInput.addEventListener('click', () => {
        editorInput.innerHTML = '';
        editorOutput.innerHTML = '';
        if (inputCharCount) inputCharCount.textContent = '0';
        if (inputWordCount) inputWordCount.textContent = '0';
        if (outputCharCount) outputCharCount.textContent = '0';
        if (outputWordCount) outputWordCount.textContent = '0';
        editorInput.focus();
      });

      // Copy Formatted
      btnCopyRich.addEventListener('click', async () => {
        const htmlData = editorOutput.innerHTML;
        const textData = editorOutput.innerText || '';
        if (!textData.trim()) return;

        try {
          if (navigator.clipboard && window.ClipboardItem) {
            const blobHtml = new Blob([htmlData], { type: 'text/html' });
            const blobText = new Blob([textData], { type: 'text/plain' });
            await navigator.clipboard.write([
              new ClipboardItem({
                'text/html': blobHtml,
                'text/plain': blobText
              })
            ]);
            showToast('Copied formatted text for Word & Google Docs');
          } else {
            await navigator.clipboard.writeText(textData);
            showToast('Copied to clipboard');
          }
        } catch {
          const range = document.createRange();
          range.selectNodeContents(editorOutput);
          const sel = window.getSelection();
          sel.removeAllRanges();
          sel.addRange(range);
          document.execCommand('copy');
          sel.removeAllRanges();
          showToast('Copied to clipboard');
        }
      });

      // Copy Plain
      btnCopyPlain.addEventListener('click', async () => {
        const textData = editorOutput.innerText || '';
        if (!textData.trim()) return;
        try {
          await navigator.clipboard.writeText(textData);
          showToast('Copied plain ASCII text');
        } catch {
          const temp = document.createElement('textarea');
          temp.value = textData;
          document.body.appendChild(temp);
          temp.select();
          document.execCommand('copy');
          document.body.removeChild(temp);
          showToast('Copied plain ASCII text');
        }
      });

      // Download Text
      btnDownloadTxt.addEventListener('click', () => {
        const textData = editorOutput.innerText || '';
        if (!textData.trim()) return;
        const filename = (currentMode === 'toPreeti') ? 'preeti-text.txt' : 'nepali-unicode.txt';
        const blob = new Blob([textData], { type: 'text/plain;charset=utf-8' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = filename;
        a.click();
        URL.revokeObjectURL(a.href);
        showToast(`Downloaded ${filename}`);
      });

      // Print Document
      btnPrintDoc.addEventListener('click', () => {
        const printWin = window.open('', '', 'width=840,height=640');
        if (!printWin) return;
        printWin.document.write(`
          <!DOCTYPE html>
          <html>
            <head>
              <title>TopNepali Document Print</title>
              <style>
                body { font-family: 'Font_preeti', 'Preeti', sans-serif; padding: 40px; line-height: 1.8; color: #111; font-size: 18px; }
                h1, h2, h3 { color: #000; margin-top: 1.5em; margin-bottom: 0.5em; }
              </style>
            </head>
            <body>
              ${editorOutput.innerHTML}
            </body>
          </html>
        `);
        printWin.document.close();
        printWin.focus();
        printWin.print();
        printWin.close();
      });

      // Initial execution
      setEditorFontSize(20);
      updateModeUI();
      editorInput.innerHTML = SAMPLE_UNICODE;
      runConversion();
    })();
  </script>
</Layout>
